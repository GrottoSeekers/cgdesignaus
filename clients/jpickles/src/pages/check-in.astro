---
import Base from "../layouts/Base.astro";
import FormFlow from "../components/FormFlow.astro";
import Icon from "../components/Icon.astro";
import "../styles/forms.css";
import { checkin } from "../lib/forms";
import { dm } from "../lib/site";
---

<Base
  title="Weekly check-in | J.Pickles Coaching"
  description="Your Friday check-in with James. Under five minutes."
  path="/check-in"
  noindex
  credit={false}
>
  <div class="form-page">
    <aside class="form-aside">
      <img src="/media/hyrox-wallball-720.webp" alt="" width="599" height="799" />
      <div class="form-aside-copy">
        <h1>Friday <em>check-in.</em></h1>
        <p>Under five minutes. James reads it over the weekend and updates your plan before Monday.</p>
        <p class="due" data-due><Icon name="calendar" /><span>Due by 12pm Friday</span></p>
      </div>
    </aside>
    <FormFlow
      form="checkin"
      sections={checkin}
      title="Weekly client check-in"
      submitLabel="Send check-in"
      done={{ title: "Check-in sent.", body: "Nice work this week. James will review it and adjust your plan before your next training week starts." }}
    >
      <Fragment slot="done">
        <section class="week" data-week hidden aria-label="Your week">
          <div class="week-head"><h3>Your week</h3><span data-week-date></span></div>
          <dl class="week-grid" data-week-grid></dl>
          <div class="week-next">
            <p>Next check-in <strong data-next-date></strong>, by 12pm.</p>
            <button type="button" class="btn btn-sm btn-ghost" data-ics><Icon name="calendar" />Add a Friday reminder</button>
          </div>
        </section>
        <div class="done-actions">
          <a class="btn" href={dm} target="_blank" rel="noopener noreferrer"><Icon name="message" />Message James</a>
          <a class="btn btn-ghost" href="/">Back to the site</a>
        </div>
      </Fragment>
    </FormFlow>
  </div>

  <script>
    import { initFlow } from "../scripts/form";
    const d = new Date();
    const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;

    // "Due in ..." until 12pm Friday (local time).
    const due = document.querySelector("[data-due] span");
    if (due) {
      const fri = new Date(d);
      fri.setDate(d.getDate() + ((5 - d.getDay() + 7) % 7));
      fri.setHours(12, 0, 0, 0);
      const ms = fri.getTime() - d.getTime();
      if (ms > 0) {
        const h = Math.floor(ms / 36e5);
        due.textContent = h >= 24 ? `Due Friday 12pm, ${Math.floor(h / 24)} day${h >= 48 ? "s" : ""} to go` : `Due today by 12pm, ${h} hour${h === 1 ? "" : "s"} to go`;
      } else due.textContent = "Due 12pm Friday. Send it now.";
    }

    initFlow({
      table: "check_ins",
      remember: ["name", "email"],
      prefill: { checkin_date: today },
      toRow: (v) => ({
        name: v.name,
        email: String(v.email || "").toLowerCase(),
        checkin_date: v.checkin_date,
        weight_kg: v.weight_kg ? Number(v.weight_kg) : null,
        answers: v,
      }),
      onDone: showWeek,
    });

    /* ---------- Thank-you screen: the week at a glance ---------- */
    type V = Record<string, string | string[]>;
    const historyKey = "jp-checkins"; // this phone's past check-ins, for "since last week"
    const esc = (s: unknown) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
    const nextFriday = () => {
      const n = new Date();
      n.setDate(n.getDate() + (((5 - n.getDay() + 7) % 7) || 7));
      n.setHours(12, 0, 0, 0);
      return n;
    };

    function showWeek(v: V) {
      let past: { date: string; weight: number }[] = [];
      try { past = JSON.parse(localStorage.getItem(historyKey) || "[]"); } catch { /* private mode */ }
      const prev = past.filter((p) => p.date < String(v.checkin_date)).slice(-1)[0];
      const w = Number(v.weight_kg);
      const delta = prev && w ? w - prev.weight : null;
      try {
        const next = past.filter((p) => p.date !== v.checkin_date).concat(w ? [{ date: String(v.checkin_date), weight: w }] : []);
        localStorage.setItem(historyKey, JSON.stringify(next.slice(-26)));
      } catch { /* ignore */ }

      const tile = (label: string, value: string, extra = "") => `<div><dt>${esc(label)}</dt><dd>${value}${extra}</dd></div>`;
      const score = (k: string) => (v[k] ? `${esc(v[k])}<small>/10</small>` : "-");
      const tiles = [
        tile("Weight", w ? `${esc(w)}<small>kg</small>` : "-", delta != null && Math.abs(delta) >= 0.05 ? `<span class="${delta < 0 ? "down" : "up"}">${delta > 0 ? "+" : ""}${delta.toFixed(1)}</span>` : ""),
        tile("Workouts", v.workouts ? esc(v.workouts) : "-"),
        tile("Nutrition", v.nutrition ? `<span style="font-size:.8em">${esc(v.nutrition)}</span>` : "-"),
        tile("Felt", score("physical")),
        tile("Energy", score("energy")),
        tile("Sleep", score("sleep")),
      ];
      document.querySelector("[data-week-grid]")!.innerHTML = tiles.join("");
      const date = new Date(String(v.checkin_date));
      document.querySelector("[data-week-date]")!.textContent = isNaN(+date) ? "" : date.toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short" });
      document.querySelector("[data-next-date]")!.textContent = nextFriday().toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
      document.querySelector<HTMLElement>("[data-week]")!.hidden = false;
    }

    // A weekly calendar reminder (Friday 9am, due 12pm), as a file any calendar app opens.
    document.querySelector("[data-ics]")?.addEventListener("click", () => {
      const f = nextFriday();
      const ymd = `${f.getFullYear()}${String(f.getMonth() + 1).padStart(2, "0")}${String(f.getDate()).padStart(2, "0")}`;
      const ics = [
        "BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//J.Pickles Coaching//Check-in//EN",
        "BEGIN:VEVENT", `UID:jp-checkin-${ymd}@jpicklescoaching`, `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, "").split(".")[0]}Z`,
        `DTSTART:${ymd}T090000`, `DTEND:${ymd}T091500`, "RRULE:FREQ=WEEKLY;BYDAY=FR",
        "SUMMARY:J.Pickles check-in (due 12pm)", `DESCRIPTION:Your weekly check-in: ${location.href.split("?")[0]}`,
        "BEGIN:VALARM", "TRIGGER:PT0M", "ACTION:DISPLAY", "DESCRIPTION:Check-in due by 12pm", "END:VALARM",
        "END:VEVENT", "END:VCALENDAR",
      ].join("\r\n");
      const a = document.createElement("a");
      a.href = URL.createObjectURL(new Blob([ics], { type: "text/calendar" }));
      a.download = "jpickles-check-in.ics";
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });
  </script>
</Base>
