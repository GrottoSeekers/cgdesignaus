---
import Base from "../layouts/Base.astro";
import FormFlow from "../components/FormFlow.astro";
import Icon from "../components/Icon.astro";
import "../styles/forms.css";
import { checkin } from "../lib/forms";
import { dm } from "../lib/site";
---

<Base
  title="Weekly check-in | J.Pickles Coaching"
  description="Your Friday check-in with James. Under five minutes."
  path="/check-in"
  noindex
  credit={false}
>
  <div class="form-page">
    <aside class="form-aside">
      <img src="/media/hyrox-wallball-720.webp" alt="" width="599" height="799" />
      <div class="form-aside-copy">
        <h1>Friday <em>check-in.</em></h1>
        <p>Under five minutes. James reads it over the weekend and updates your plan before Monday.</p>
        <p class="due" data-due><Icon name="calendar" /><span>Due by 12pm Friday</span></p>
      </div>
    </aside>
    <FormFlow
      form="checkin"
      sections={checkin}
      title="Weekly client check-in"
      submitLabel="Send check-in"
      done={{ title: "Check-in sent.", body: "Nice work this week. James will review it and adjust your plan before your next training week starts." }}
    >
      <Fragment slot="done">
        <div class="done-actions">
          <a class="btn" href={dm} target="_blank" rel="noopener noreferrer"><Icon name="message" />Message James</a>
          <a class="btn btn-ghost" href="/">Back to the site</a>
        </div>
      </Fragment>
    </FormFlow>
  </div>

  <script>
    import { initFlow } from "../scripts/form";
    const d = new Date();
    const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;

    // "Due in ..." until 12pm Friday (local time).
    const due = document.querySelector("[data-due] span");
    if (due) {
      const fri = new Date(d);
      fri.setDate(d.getDate() + ((5 - d.getDay() + 7) % 7));
      fri.setHours(12, 0, 0, 0);
      const ms = fri.getTime() - d.getTime();
      if (ms > 0) {
        const h = Math.floor(ms / 36e5);
        due.textContent = h >= 24 ? `Due Friday 12pm, ${Math.floor(h / 24)} day${h >= 48 ? "s" : ""} to go` : `Due today by 12pm, ${h} hour${h === 1 ? "" : "s"} to go`;
      } else due.textContent = "Due 12pm Friday. Send it now.";
    }

    initFlow({
      table: "check_ins",
      remember: ["name", "email"],
      prefill: { checkin_date: today },
      toRow: (v) => ({
        name: v.name,
        email: String(v.email || "").toLowerCase(),
        checkin_date: v.checkin_date,
        weight_kg: v.weight_kg ? Number(v.weight_kg) : null,
        answers: v,
      }),
    });
  </script>
</Base>
