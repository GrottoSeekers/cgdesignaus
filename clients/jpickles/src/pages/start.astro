---
import Base from "../layouts/Base.astro";
import FormFlow from "../components/FormFlow.astro";
import Icon from "../components/Icon.astro";
import "../styles/forms.css";
import { onboarding } from "../lib/forms";
import { online, pt, gbp, dm } from "../lib/site";

// Plan choices come from the price list, so they always match the site.
const planOptions = [
  ...online.map((p) => ({ id: p.id, label: `Online coaching: ${p.name} (${gbp(p.price)} ${p.unit})` })),
  ...pt.map((p) => ({ id: p.id, label: `1:1 PT: ${p.name} (${gbp(p.price)}, ${p.unit})` })),
  { id: "unsure", label: "Not sure yet, help me choose" },
];
const sections = onboarding.map((s) => ({
  ...s,
  fields: s.fields.map((f) => (f.id === "plan" ? { ...f, options: planOptions.map((p) => p.label) } : f)),
}));
---

<Base
  title="Start coaching | J.Pickles Coaching"
  description="Tell James about your goals, training and food. Your plan is built from your answers."
  path="/start"
  credit={false}
>
  <div class="form-page">
    <aside class="form-aside">
      <img src="/media/city-run-1200.webp" alt="" width="1200" height="1500" />
      <div class="form-aside-copy">
        <h1>Let's build your <em>plan.</em></h1>
        <p>About ten minutes. Answers save as you go, so you can finish later on this phone or laptop.</p>
      </div>
    </aside>
    <FormFlow
      form="onboarding"
      sections={sections}
      title="Client onboarding and consultation"
      submitLabel="Send to James"
      done={{ title: "Got it. Speak soon.", body: "James reads every form himself and will message you within 24 hours to agree your plan and start date." }}
    >
      <Fragment slot="done">
        <ul class="done-list">
          <li><Icon name="message" /><span><strong>Next:</strong> James messages you to talk through your answers.</span></li>
          <li><Icon name="clipboard" /><span><strong>Then:</strong> your programme lands, and check-ins start on your first Friday.</span></li>
        </ul>
        <div class="done-actions">
          <a class="btn" href={dm} target="_blank" rel="noopener noreferrer"><Icon name="message" />Message James now</a>
          <a class="btn btn-ghost" href="/">Back to the site</a>
        </div>
      </Fragment>
    </FormFlow>
  </div>

  <script define:vars={{ planOptions }} is:inline>
    window.__plans = planOptions;
  </script>
  <script>
    import { initFlow } from "../scripts/form";
    const plans = (window as any).__plans as { id: string; label: string }[];
    const wanted = new URLSearchParams(location.search).get("plan");
    const match = plans.find((p) => p.id === wanted);
    initFlow({
      table: "onboarding",
      prefill: match ? { plan: match.label } : undefined,
      toRow: (v) => ({
        name: v.name,
        email: String(v.email || "").toLowerCase(),
        phone: v.phone,
        plan: v.plan,
        answers: v,
      }),
    });
  </script>
</Base>
