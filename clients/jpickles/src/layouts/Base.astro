---
import "@fontsource-variable/bodoni-moda/opsz.css";
import "@fontsource-variable/bodoni-moda/opsz-italic.css";
import "@fontsource-variable/hanken-grotesk/wght.css";
import "@fontsource/michroma/latin-400.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { site, cgLinks } from "../lib/site";
// The four font files every page uses, preloaded so text never swaps fonts after showing.
import bodoniUrl from "@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-normal.woff2?url";
import bodoniItalicUrl from "@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-italic.woff2?url";
import hankenUrl from "@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url";
import michromaUrl from "@fontsource/michroma/files/michroma-latin-400-normal.woff2?url";
const fonts = [bodoniUrl, bodoniItalicUrl, hankenUrl, michromaUrl];

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  credit?: boolean;
  preload?: { href: string; srcset?: string; sizes?: string };
}
const { title, description, path = "/", noindex = false, credit = true, preload } = Astro.props;
const canonical = new URL(path, site).href;
const ext = { target: "_blank", rel: "noopener noreferrer" };
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0c0c0d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="J.Pickles Coaching" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/media/og.jpg", site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="J.Pickles Coaching: online coaching and 1:1 PT with James Pickles" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/media/og.jpg", site).href} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {fonts.map((f) => <link rel="preload" as="font" type="font/woff2" href={f} crossorigin />)}
    {preload && <link rel="preload" as="image" href={preload.href} imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}
    <slot name="head" />
    <script is:inline>
      // Hide animated elements only when JS runs; the failsafe shows them after 2.5s.
      document.documentElement.classList.add("js");
      // Photos stay invisible until fully downloaded and decoded, then fade in (never pop or
      // paint half-loaded). Runs before the page paints; failsafe reveals any after 4s.
      (function () {
        function ready(img) { img.classList.add("img-ready"); }
        function watch(img) {
          if (img.dataset.watched) return;
          img.dataset.watched = "1";
          if (img.complete && img.naturalWidth) { (img.decode ? img.decode() : Promise.resolve()).then(function () { ready(img); }, function () { ready(img); }); return; }
          img.addEventListener("load", function () { (img.decode ? img.decode() : Promise.resolve()).then(function () { ready(img); }, function () { ready(img); }); }, { once: true });
          img.addEventListener("error", function () { ready(img); }, { once: true });
        }
        new MutationObserver(function (list) {
          list.forEach(function (m) { m.addedNodes.forEach(function (n) {
            if (n.tagName === "IMG") watch(n);
            else if (n.querySelectorAll) n.querySelectorAll("img").forEach(watch);
          }); });
        }).observe(document.documentElement, { childList: true, subtree: true });
        addEventListener("DOMContentLoaded", function () { document.querySelectorAll("img").forEach(watch); });
        setTimeout(function () { document.querySelectorAll("img").forEach(ready); }, 4000);
      })();
      // Mouse/touch users don't see focus rings after clicking; keyboard (Tab) users do.
      (function (r) {
        addEventListener("pointerdown", function () { r.classList.add("is-pointer"); }, true);
        addEventListener("keydown", function (e) { if (e.key === "Tab") r.classList.remove("is-pointer"); }, true);
      })(document.documentElement);
      setTimeout(function () { document.documentElement.classList.add("motion-ready"); }, 2500);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    {credit && (
      <aside class="cg-credit" aria-label="Website credit">
        <div class="wrap">
          <div class="cg-credit-lead">
            <img src="/media/cgd-logo.webp" alt="CG Design" width="62" height="24" />
            <span>Want a website like this? Reach out to CG Design.</span>
          </div>
          <div class="cg-credit-links">
            {cgLinks.map((l) => (
              <a href={l.href} {...(l.external && ext)}>
                <Icon name={l.icon} size={15} />
                {l.label}
              </a>
            ))}
          </div>
        </div>
      </aside>
    )}
  </body>
</html>
