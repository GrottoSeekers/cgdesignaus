---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Perks from "../components/Perks.astro";
import ProductCard from "../components/ProductCard.astro";
import Reviews from "../components/Reviews.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { business, whatsapp, products, categories, occasions, customSteps, faqs } from "../data/site";

const featured = products.filter((p) => p.featured).slice(0, 6);
const categoryCover: Record<string, string | undefined> = Object.fromEntries(
  categories.map((c) => [c.id, products.find((p) => p.category === c.id && p.image)?.image]),
);
const fromPrice = (id: string) => {
  const prices = products.filter((p) => p.category === id && p.price !== null).map((p) => p.price as number);
  return prices.length ? `From KSh ${Math.min(...prices).toLocaleString("en-KE")}` : "Price on request";
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<Base
  title="Cherry Gift Store Nairobi | Gift Packages, Flowers & Candy Packs"
  description={business.description}
  schema={[faqSchema]}
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow hero-in">Nairobi gift shop · Dynamic Mall</span>
        <h1 class="h1 hero-in">Gifts that say it <em>sweetly.</em></h1>
        <p class="lead hero-in">
          Gift packages, luxury rose bouquets, candy packs and care packs, hand-wrapped in Nairobi with a free gift box and a
          personal card. Same-day delivery across the city.
        </p>
        <div class="hero-actions hero-in">
          <a class="btn btn-whatsapp" href={whatsapp.link} target="_blank" rel="noopener"><Icon name="whatsapp" />Order on WhatsApp</a>
          <a class="btn btn-ghost" href="/shop/">Browse gifts <Icon name="arrow" /></a>
        </div>
        <p class="hero-note hero-in"><Icon name="sparkle" size={18} /><span>Gift packages from <strong>KSh 1,000</strong>, free wrapping included</span></p>
      </div>

      <div class="hero-art" aria-hidden="true">
        <img class="pic pic-1" src="/images/luxury-red-roses.webp" alt="" width="399" height="361" fetchpriority="high" />
        <img class="pic pic-2" src="/images/initial-bouquet.webp" alt="" width="397" height="387" />
        <img class="pic pic-3" src="/images/grand-rose-box.webp" alt="" width="399" height="452" />
        <img class="sticker" src="/images/logo.webp" alt="" width="160" height="160" />
        <span class="tag">Same-day delivery <Icon name="truck" size={18} /></span>
      </div>
    </div>
    <div class="container"><Perks /></div>
  </section>

  <div class="ticker" aria-label="Occasions we cater for">
    <div class="ticker-track">
      {[0, 1].map((n) => (
        <ul aria-hidden={n === 1 ? "true" : undefined}>
          {occasions.map((o) => <li>{o}<span>✿</span></li>)}
        </ul>
      ))}
    </div>
  </div>

  <section class="section" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-split">
        <div class="section-head">
          <span class="eyebrow">Customer favourites</span>
          <h2 id="featured-title" class="h2">Wrapped, boxed &amp; <em>ready to gift</em></h2>
        </div>
        <a class="btn btn-ghost" href="/shop/">See all gifts <Icon name="arrow" /></a>
      </div>
      <div class="product-grid featured-row" data-reveal-group>
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="section categories-section gingham" aria-labelledby="cat-title">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Shop by gift</span>
        <h2 id="cat-title" class="h2">Something for <em>everyone</em></h2>
      </div>
      <div class="cat-grid" data-reveal-group>
        {categories.map((c) => (
          <a class="cat card" href={`/shop/#${c.id}`} data-reveal>
            <div class="cat-media">
              {categoryCover[c.id]
                ? <img src={categoryCover[c.id]} alt="" width="400" height="400" loading="lazy" />
                : <Icon name={c.id === "flowers" ? "flower" : c.id === "care-packs" ? "heart" : "gift"} size={40} />}
            </div>
            <div class="cat-body">
              <h3 class="h3">{c.label}</h3>
              <p>{c.blurb}</p>
              <span class="cat-price">{fromPrice(c.id)} <Icon name="arrow" size={18} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section custom" aria-labelledby="custom-title">
    <div class="container custom-inner">
      <div class="custom-photo" data-reveal>
        <img src="/images/initial-bouquet.webp" alt="Custom rose bouquet with a white flower initial" width="397" height="387" loading="lazy" />
        <span class="custom-badge">Made just for them</span>
      </div>
      <div>
        <div class="section-head">
          <span class="eyebrow">Custom orders</span>
          <h2 id="custom-title" class="h2">Your idea, <em>our wrapping</em></h2>
          <p class="lead">
            Pick the items, colours, flowers and budget, or let us surprise you. Custom gift packages, personalised bouquets,
            corporate gifting and picnic setups.
          </p>
        </div>
        <ol class="steps" data-reveal-group>
          {customSteps.map((s, i) => (
            <li data-reveal><span class="step-n">{i + 1}</span><div><strong>{s.title}</strong><p>{s.text}</p></div></li>
          ))}
        </ol>
        <div class="custom-actions">
          <a class="btn btn-primary" href="/custom-orders/">Start a custom order</a>
          <a class="btn btn-ghost" href="/shop/#corporate">Corporate gifts</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight about-strip" aria-labelledby="about-title">
    <div class="container about-inner" data-reveal>
      <img src="/images/logo.webp" alt="Cherry Candy and Gift Store logo" width="220" height="220" loading="lazy" />
      <div>
        <span class="eyebrow">About Cherry</span>
        <h2 id="about-title" class="h2">A little shop with a <em>big heart</em></h2>
        <p class="lead">
          Cherry Candy &amp; Gift Store started with one idea: every gift should feel personal. From our shop in Dynamic Mall we
          hand-pick, wrap and deliver gift packages, flowers and sweet treats for the people you love, and the clients you want to
          impress.
        </p>
        <a class="text-link" href="/about/">Our story <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <Reviews />

  <section class="section-tight insta" aria-labelledby="insta-title">
    <div class="container insta-inner">
      <div>
        <span class="eyebrow">Follow along</span>
        <h2 id="insta-title" class="h2">New packages every week on <em>Instagram</em></h2>
      </div>
      <a class="btn btn-primary" href={business.instagram} target="_blank" rel="noopener"><Icon name="instagram" />{business.instagramHandle}</a>
    </div>
  </section>

  <Faq />
  <CtaBand />
</Base>

<script>
  import { animate, stagger } from "motion";

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    animate(".hero-in", { opacity: [0, 1], y: [28, 0] }, { duration: 0.9, delay: stagger(0.08), ease: [0.16, 1, 0.3, 1] });
    animate(".hero-art .pic", { opacity: [0, 1], scale: [0.85, 1] }, { delay: stagger(0.12, { startDelay: 0.2 }), type: "spring", stiffness: 260, damping: 22 });
    animate(".hero-art .sticker", { opacity: [0, 1], scale: [0.4, 1], rotate: [-30, -8] }, { delay: 0.65, type: "spring", stiffness: 400, damping: 14 });
    animate(".hero-art .tag", { opacity: [0, 1], x: [-20, 0] }, { delay: 0.85, duration: 0.6, ease: [0.16, 1, 0.3, 1] });
  }
</script>

<style>
  .hero { padding: clamp(40px, 6vw, 80px) 0 clamp(40px, 5vw, 64px); overflow: hidden; }
  .hero-inner { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; margin-bottom: clamp(40px, 5vw, 64px); }
  .hero-copy { display: grid; gap: 22px; justify-items: start; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-note { display: flex; align-items: center; gap: 8px; font-size: 15px; color: var(--muted); }
  .hero-note svg { color: var(--cherry); }
  .hero-note strong { color: var(--ink); }

  .hero-art { position: relative; aspect-ratio: 1 / 1; max-width: 560px; width: 100%; justify-self: center; }
  .pic {
    position: absolute; height: auto; object-fit: cover; border-radius: 24px;
    border: 6px solid #fff; box-shadow: var(--shadow-lift);
  }
  .pic-1 { width: 56%; aspect-ratio: 4 / 5; left: 0; top: 8%; rotate: -4deg; z-index: 2; }
  .pic-2 { width: 46%; aspect-ratio: 1; right: 0; top: 0; rotate: 5deg; z-index: 1; }
  .pic-3 { width: 46%; aspect-ratio: 1; right: 3%; bottom: 0; rotate: -3deg; z-index: 3; }
  .sticker { position: absolute; width: 27%; left: 2%; bottom: 0; z-index: 4; rotate: -8deg; filter: drop-shadow(0 12px 18px rgba(77, 11, 27, .3)); }
  .tag {
    position: absolute; right: 30%; top: 47%; z-index: 5;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 16px; border-radius: 999px; background: var(--paper); color: var(--ink);
    font-weight: 700; font-size: 14px; box-shadow: var(--shadow);
  }
  .tag svg { color: var(--cherry); }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-art { max-width: 460px; }
  }

  .ticker { background: var(--cherry); color: #fff; overflow: hidden; padding: 16px 0; }
  .ticker-track { display: flex; width: max-content; animation: ticker 40s linear infinite; }
  .ticker ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .ticker li { display: flex; align-items: center; gap: 28px; padding-right: 28px; font-family: var(--font-display); font-style: italic; font-size: 1.35rem; white-space: nowrap; }
  .ticker li span { color: var(--blush-deep); font-style: normal; font-size: 1rem; }
  @keyframes ticker { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; } }

  @media (max-width: 640px) {
    .featured-row {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 14px;
      margin-inline: -24px; padding: 4px 24px 20px; scroll-padding-inline: 24px; scrollbar-width: none;
    }
    .featured-row::-webkit-scrollbar { display: none; }
    .featured-row > :global(*) { flex: 0 0 82%; scroll-snap-align: start; }
  }

  .section-split { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: clamp(32px, 4vw, 48px); }
  .section-split .section-head { margin-bottom: 0; }

  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .cat { display: grid; grid-template-columns: 112px 1fr; overflow: hidden; text-decoration: none; transition: transform .45s var(--ease-out), box-shadow .45s var(--ease-out); }
  .cat:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .cat-media { display: grid; place-items: center; background: var(--blush); color: var(--cherry); }
  .cat-media img { width: 100%; height: 100%; object-fit: cover; }
  .cat-body { display: grid; gap: 6px; padding: 20px; }
  .cat-body p { font-size: 14.5px; }
  .cat-price { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--cherry); font-size: 14.5px; }
  @media (max-width: 960px) { .cat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .cat-grid { grid-template-columns: 1fr; } }

  .custom-inner { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .custom-photo { position: relative; }
  .custom-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 32px; box-shadow: var(--shadow-lift); }
  .custom-badge {
    position: absolute; right: -10px; top: 28px; rotate: 6deg;
    padding: 12px 20px; border-radius: 999px; background: var(--cherry); color: #fff;
    font-family: var(--font-display); font-style: italic; font-size: 1.15rem; box-shadow: var(--shadow);
  }
  .steps { list-style: none; margin: 0 0 32px; padding: 0; display: grid; gap: 18px; }
  .steps li { display: flex; gap: 16px; align-items: flex-start; }
  .step-n {
    width: 40px; height: 40px; flex: none; border-radius: 50%;
    display: grid; place-items: center; background: var(--blush); color: var(--cherry);
    font-family: var(--font-display); font-weight: 600; font-size: 1.15rem;
  }
  .steps strong { color: var(--ink); }
  .steps p { font-size: 15.5px; }
  .custom-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 860px) {
    .custom-inner { grid-template-columns: 1fr; }
    .custom-photo { max-width: 420px; }
    .custom-badge { right: 8px; }
  }

  .about-strip { background: var(--blush); }
  .about-inner { display: grid; grid-template-columns: auto 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .about-inner > div { display: grid; gap: 16px; justify-items: start; }
  .about-inner img { width: clamp(140px, 20vw, 220px); border-radius: 50%; box-shadow: var(--shadow-lift); }
  .text-link { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--cherry); text-underline-offset: 4px; }
  @media (max-width: 700px) { .about-inner { grid-template-columns: 1fr; } }

  .insta { background: var(--cream); }
  .insta-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; padding: 40px clamp(24px, 4vw, 48px); border-radius: 28px; background: var(--paper); box-shadow: var(--shadow); }
  .insta-inner > div { display: grid; gap: 10px; max-width: 34rem; }
</style>
