---
import "@fontsource-variable/bodoni-moda/opsz.css";
import "@fontsource-variable/bodoni-moda/opsz-italic.css";
import "@fontsource-variable/inter-tight/wght.css";
import "../styles/main.css";
import { brand, hero, intro, products, categories, marquee, about, testimonials, inquiry, em } from "../data/content";

const title = "Cherry Gift Store Nairobi | Gift Packages, Flowers & Candy Packs";
const description =
  "Cherry Candy & Gift Store, Dynamic Mall Nairobi: hand-wrapped gift packages, rose bouquets, candy packs and care packs with a free gift box, free card message and same-day delivery.";
const site = Astro.site ?? new URL("https://www.cherrygiftstore.co.ke");
const schema = {
  "@context": "https://schema.org",
  "@type": ["Store", "Florist"],
  name: brand.fullName,
  description,
  url: site.href,
  logo: new URL(brand.logo, site).href,
  image: new URL("/media/og.jpg", site).href,
  priceRange: "KSh 1,000+",
  currenciesAccepted: "KES",
  address: { "@type": "PostalAddress", streetAddress: "Dynamic Mall, 3rd Floor, Shop 142B", addressLocality: "Nairobi", addressCountry: "KE" },
  areaServed: [{ "@type": "City", name: "Nairobi" }, { "@type": "Country", name: "Kenya" }],
  sameAs: [brand.instagram],
};
const pad = (n: number) => String(n).padStart(2, "0");
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site.href} />
    <meta name="theme-color" content="#f6f3ee" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={schema.image} />
    <meta property="og:locale" content="en_KE" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="image" href={hero.slides[0].type === "image" ? hero.slides[0].src : hero.slides[0].poster} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <div class="loader" aria-hidden="true">
      <div class="loader-inner">
        <span class="loader-word"><img src={brand.logo} alt="" width="96" height="96" />{brand.name}</span>
        <span class="loader-count"><span class="loader-num">00</span></span>
      </div>
    </div>

    <div class="cursor" aria-hidden="true"><span class="cursor-label">View</span></div>
    <div class="progress" aria-hidden="true"><span></span></div>

    <header class="header">
      <a class="wordmark" href="#top" aria-label={`${brand.fullName}, back to top`}>{brand.name}</a>
      <nav class="nav" aria-label="Main">
        <a href="#collection">Collection</a>
        <a href="#studio">About</a>
        <a href="#words">Reviews</a>
      </nav>
      <a class="header-cta" href="#inquire"><span>Order</span></a>
    </header>

    <main id="top">
      <!-- 01 Hero -->
      <section class="hero" aria-label="Introduction" data-captions={JSON.stringify(hero.slides.map((s) => s.caption))}>
        <div class="hero-media" data-hero-media>
          <canvas class="hero-canvas" aria-hidden="true"></canvas>
          <div class="hero-fallback">
            {hero.slides.map((s, i) =>
              s.type === "image" ? (
                <img src={s.src} alt={i === 0 ? s.alt : ""} class:list={{ active: i === 0 }} fetchpriority={i === 0 ? "high" : "low"} data-hero-slide />
              ) : (
                <video src={s.src} poster={s.poster} muted playsinline loop preload="metadata" class:list={{ active: i === 0 }} data-hero-slide aria-label={s.alt} />
              ),
            )}
          </div>
          <div class="hero-shade" aria-hidden="true"></div>
        </div>

        <div class="hero-copy">
          <p class="label hero-eyebrow" data-hero-in>{hero.eyebrow}</p>
          <h1 class="display hero-title">
            {hero.headline.map((line) => <span class="line"><span class="line-inner" set:html={em(line)} /></span>)}
          </h1>
        </div>

        <div class="hero-meta" data-hero-in>
          <p class="label"><span class="hero-index">01</span> / {pad(hero.slides.length)}</p>
          <p class="label hero-caption">{hero.slides[0].caption}</p>
        </div>
        <div class="scroll-cue label" data-hero-in><span>Scroll</span><i></i></div>
      </section>

      <!-- 02 Statement -->
      <section class="statement" aria-label="About our gifts">
        <p class="label section-no">(01)</p>
        <p class="statement-text" data-words>{intro}</p>
      </section>

      <!-- 03 Collection: the one product showcase -->
      <section id="collection" class="collection" aria-labelledby="collection-title">
        <div class="section-top">
          <p class="label section-no">(02)</p>
          <h2 id="collection-title" class="display h2" data-lines>The <em>collection</em></h2>
          <p class="section-note">Gift packages from KSh 1,000, bouquets, care packs and cards. Every order comes with a free gift box, wrapping and card message, delivered the same day in Nairobi.</p>
        </div>

        <div class="showcase-bar">
          <div class="filters" role="group" aria-label="Filter by category">
            <button type="button" class="filter" aria-pressed="true" data-filter="all">All</button>
            {categories.map((c) => <button type="button" class="filter" aria-pressed="false" data-filter={c}>{c}</button>)}
          </div>
          <p class="label showcase-count"><span data-count>{pad(products.length)}</span> pieces</p>
        </div>

        <ul class="showcase" role="list">
          {products.map((p) => (
            <li class="product" data-product data-category={p.category}>
              {p.image ? (
                <div class="product-frame" data-gl-image={p.image} data-cursor="View">
                  <img src={p.image} alt={p.alt} loading="lazy" decoding="async" />
                </div>
              ) : (
                <div class="product-frame is-video">
                  <video poster={p.video!.poster} muted loop playsinline preload="none" aria-label={p.alt} data-product-video>
                    <source src={p.video!.src} type="video/mp4" />
                    <source src={p.video!.src.replace(/\.mp4$/, ".webm")} type="video/webm" />
                  </video>
                </div>
              )}
              <div class="product-info">
                <h3 class="product-title">{p.title}</h3>
                <p class="product-price">{p.price ?? "Ask for price"}</p>
                <p class="label product-cat">{p.category}</p>
                <a class="label product-order" href="#inquire" data-order={p.title}>Order <span aria-hidden="true">→</span></a>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- Velocity marquee -->
      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          {[0, 1].map(() => (
            <div class="marquee-group">
              {marquee.map((m) => <span>{m}<i>✦</i></span>)}
            </div>
          ))}
        </div>
      </div>

      <!-- 04 About -->
      <section id="studio" class="about" aria-labelledby="about-title">
        <div class="about-media about-logo" data-clip>
          <img src={about.src} alt={about.alt} loading="lazy" data-parallax="0.18" />
        </div>
        <div class="about-copy">
          <p class="label section-no">(03) About us</p>
          <h2 id="about-title" class="display h2" data-lines set:html={about.heading.map(em).join("<br />")} />
          {about.body.map((b) => <p class="about-body" data-fade>{b}</p>)}
          <dl class="facts" data-fade>
            {about.facts.map((f) => <div><dt class="label">{f.k}</dt><dd>{f.v}</dd></div>)}
          </dl>
        </div>
      </section>

      <!-- 05 Testimonials -->
      <section id="words" class="words" aria-labelledby="words-title">
        <p id="words-title" class="label section-no">(04) Kind words</p>
        <div class="quotes" data-quotes>
          {testimonials.map((t, i) => (
            <figure class:list={["quote", { active: i === 0 }]} aria-hidden={i === 0 ? undefined : "true"}>
              <blockquote class="display">“{t.quote}”</blockquote>
              <figcaption class="label">{t.name} — {t.role}{t.sample && <span class="sample-note">Sample review: replace before launch</span>}</figcaption>
            </figure>
          ))}
        </div>
        <div class="quote-nav">
          <button type="button" class="quote-btn" data-quote-prev aria-label="Previous testimonial">←</button>
          <span class="label"><span class="quote-index">01</span> / {pad(testimonials.length)}</span>
          <button type="button" class="quote-btn" data-quote-next aria-label="Next testimonial">→</button>
        </div>
      </section>

      <!-- 06 Inquiry -->
      <section id="inquire" class="inquiry" aria-labelledby="inquiry-title">
        <div class="inquiry-bg" aria-hidden="true"><img src={inquiry.bg} alt="" loading="lazy" data-parallax="0.25" /></div>
        <div class="inquiry-inner">
          <div class="inquiry-head">
            <p class="label section-no">(05)</p>
            <h2 id="inquiry-title" class="display inquiry-title" data-lines set:html={inquiry.heading.map(em).join("<br />")} />
            <p class="inquiry-text" data-fade>{inquiry.text}</p>
            <a class="inquiry-mail" href={brand.whatsapp} target="_blank" rel="noopener" data-fade>Or message us on WhatsApp →</a>
          </div>
          <form class="inquiry-form" data-inquiry data-wa-link={brand.whatsapp} data-wa-number={brand.whatsappNumber} data-fade>
            <fieldset class="occasions">
              <legend class="label">The occasion</legend>
              {inquiry.occasions.map((o, i) => (
                <label class="chip"><input type="radio" name="occasion" value={o} checked={i === 0} /><span>{o}</span></label>
              ))}
            </fieldset>
            <div class="field-row">
              <label class="field"><span class="label">Your name</span><input name="name" autocomplete="name" required /></label>
              <label class="field"><span class="label">Phone / WhatsApp</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="07XX XXX XXX" required /></label>
            </div>
            <label class="field"><span class="label">Which gift?</span><input name="gift" placeholder="e.g. The Love Box, or describe your idea" /></label>
            <div class="field-row">
              <label class="field"><span class="label">Date needed</span><input name="date" type="date" /></label>
              <label class="field"><span class="label">Budget (KSh)</span><input name="budget" inputmode="numeric" placeholder="e.g. 3,000" /></label>
            </div>
            <label class="field"><span class="label">Delivery area</span><input name="area" placeholder="e.g. Kilimani, Nairobi" /></label>
            <label class="field"><span class="label">Card message & anything else</span><textarea name="message" rows="3"></textarea></label>
            <button class="send" type="submit" data-magnetic><span>Send on WhatsApp</span><i>→</i></button>
            <p class="form-note label" role="status"></p>
          </form>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p class="footer-word display" aria-hidden="true">{brand.name}<img src={brand.logo} alt="" width="200" height="200" /></p>
      <div class="footer-row">
        <span class="label">© {new Date().getFullYear()} {brand.fullName}</span>
        <span class="label">{brand.address}</span>
        <a class="label" href={brand.instagram} target="_blank" rel="noopener">Instagram {brand.instagramHandle}</a>
        <a class="label" href={brand.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        <a class="label" href="https://cgdesignaus.com" target="_blank" rel="noopener">Website by CG Design &amp; Co.</a>
      </div>
    </footer>

    <canvas class="gl-gallery" aria-hidden="true"></canvas>

    <script>
      import { boot } from "../scripts/main";
      boot();
    </script>
  </body>
</html>
