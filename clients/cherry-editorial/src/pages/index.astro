---
import "@fontsource-variable/inter-tight/wght.css";
import "../styles/main.css";
import { brand, hero, intro, highlights, products, categories, about, testimonials, inquiry, faqs } from "../data/content";

const words = intro.split(" ");

const title = "Cherry Gift Store Nairobi | Gift Packages, Flowers & Candy Packs";
const description =
  "Cherry Candy & Gift Store, Dynamic Mall Nairobi: hand-wrapped gift packages, rose bouquets, candy packs and care packs with a free gift box, free card message and same-day delivery.";
const site = Astro.site ?? new URL("https://www.cherrygiftstore.co.ke");
const schema = {
  "@context": "https://schema.org",
  "@type": ["Store", "Florist"],
  name: brand.fullName,
  description,
  url: site.href,
  logo: new URL(brand.logo, site).href,
  image: new URL("/media/og.jpg", site).href,
  priceRange: "KSh 1,000+",
  currenciesAccepted: "KES",
  address: { "@type": "PostalAddress", streetAddress: "Dynamic Mall, 3rd Floor, Shop 142B", addressLocality: "Nairobi", addressCountry: "KE" },
  areaServed: [{ "@type": "City", name: "Nairobi" }, { "@type": "Country", name: "Kenya" }],
  sameAs: [brand.instagram],
};

// Small line icons (SF Symbols-like weight).
const icons: Record<string, string> = {
  box: '<path d="M3.5 8 12 3.5 20.5 8v8L12 20.5 3.5 16z"/><path d="M3.5 8 12 12.5 20.5 8M12 12.5v8"/>',
  card: '<rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  truck: '<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/>',
  tag: '<path d="M3.5 12.2V4.5a1 1 0 0 1 1-1h7.7l8.3 8.3a1.4 1.4 0 0 1 0 2l-6.6 6.6a1.4 1.4 0 0 1-2 0z"/><circle cx="8" cy="8" r="1.4"/>',
};
const wa =
  '<path fill="currentColor" d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01Zm-7.01 15.24a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43s.17-.25.25-.41.04-.31-.02-.43c-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"/>';
// Every icon shape gets pathLength="1" so its stroke can draw in.
for (const k of Object.keys(icons)) icons[k] = icons[k].replace(/<(path|rect|circle)\b/g, '<$1 pathLength="1"');
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site.href} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_KE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={schema.image} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="image" href={hero.slides[0].type === "image" ? hero.slides[0].src : hero.slides[0].poster} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <!-- Global nav: slim, translucent -->
    <header class="nav" data-nav>
      <div class="nav-inner">
        <a class="nav-brand" href="#top" aria-label={`${brand.fullName}, back to top`}>
          <img src={brand.logo} alt="" width="28" height="28" />
          <span>{brand.name}</span>
        </a>
        <nav class="nav-links" aria-label="Main">
          <a href="#collection">Collection</a>
          <a href="#about">About</a>
          <a href="#reviews">Reviews</a>
          <a href="#faq">FAQ</a>
          <a href={brand.instagram} target="_blank" rel="noopener">Instagram</a>
        </nav>
        <a class="btn btn-sm" href="#order">Order</a>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section id="top" class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow" data-in>{hero.eyebrow}</p>
          <h1 id="hero-title" class="headline" data-in>{hero.headline}</h1>
          <p class="subhead" data-in>{hero.subhead}</p>
          <div class="ctas" data-in>
            <a class="btn" href="#order">Order now</a>
            <a class="link" href="#collection">Browse the collection <span aria-hidden="true">›</span></a>
          </div>
        </div>

        <div class="stage" data-stage>
          <div class="stage-media">
            {hero.slides.map((s, i) =>
              s.type === "image" ? (
                <img src={s.src} alt={s.alt} class:list={["slide", { active: i === 0 }]} fetchpriority={i === 0 ? "high" : "low"} loading={i === 0 ? "eager" : "lazy"} data-slide aria-hidden={i === 0 ? undefined : "true"} />
              ) : (
                <video src={s.src} poster={s.poster} muted playsinline loop preload="metadata" class:list={["slide", { active: i === 0 }]} data-slide aria-label={s.alt} />
              ),
            )}
          </div>
          <div class="stage-bar">
            <p class="stage-caption" aria-live="polite">{hero.slides[0].caption}</p>
            <div class="dots" role="group" aria-label="Choose photo">
              {hero.slides.map((s, i) => (
                <button type="button" class="dot" aria-label={`Show ${s.caption}`} aria-pressed={i === 0 ? "true" : "false"} data-dot={i}><span class="dot-fill"></span></button>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Highlights -->
      <section class="highlights" aria-label="Why order from Cherry">
        <ul class="highlight-row" role="list">
          {highlights.map((h) => (
            <li class="highlight" data-reveal>
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[h.icon]} />
              <h2>{h.title}</h2>
              <p>{h.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- Statement -->
      <section class="statement" aria-label="Our approach">
        <p class="statement-text" data-words aria-label={intro}>{words.map((w) => <><span class="w" aria-hidden="true">{w}</span>{" "}</>)}</p>
      </section>

      <!-- Collection -->
      <section id="collection" class="collection" aria-labelledby="collection-title">
        <div class="section-head" data-reveal>
          <h2 id="collection-title" class="section-title">The collection.</h2>
          <p class="section-sub">Every package can be changed to suit the person and your budget.</p>
        </div>

        <div class="segmented" role="group" aria-label="Filter by category" data-reveal>
          <span class="seg-indicator" aria-hidden="true"></span>
          <button type="button" class="segment" aria-pressed="true" data-filter="all">All</button>
          {categories.map((c) => <button type="button" class="segment" aria-pressed="false" data-filter={c}>{c}</button>)}
        </div>

        <ul class="tiles" role="list">
          {products.map((p) => (
            <li class="tile" data-product data-category={p.category}>
              <div class="tile-media">
                {p.image ? (
                  <img src={p.image} alt={p.alt} loading="lazy" decoding="async" />
                ) : (
                  <video poster={p.video!.poster} muted loop playsinline preload="none" aria-label={p.alt} data-product-video>
                    <source src={p.video!.src} type="video/mp4" />
                    <source src={p.video!.src.replace(/\.mp4$/, ".webm")} type="video/webm" />
                  </video>
                )}
              </div>
              <div class="tile-body">
                <p class="tile-cat">{p.category}</p>
                <h3 class="tile-title">{p.title}</h3>
                <p class="tile-price">{p.price ?? "Ask for price"}</p>
                <a class="btn btn-sm" href="#order" data-order={p.title} aria-label={`Order ${p.title}`}>Order</a>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- About -->
      <section id="about" class="about" aria-labelledby="about-title">
        <div class="about-grid">
          <div class="about-media" data-reveal>
            <img src={about.src} alt={about.alt} loading="lazy" />
          </div>
          <div class="about-copy" data-reveal>
            <p class="eyebrow">About us</p>
            <h2 id="about-title" class="section-title">{about.heading}</h2>
            {about.body.map((b) => <p class="body">{b}</p>)}
            <dl class="facts">
              {about.facts.map((f) => <div><dd>{f.v}</dd><dt>{f.k}</dt></div>)}
            </dl>
          </div>
        </div>
      </section>

      <!-- Reviews -->
      <section id="reviews" class="reviews" aria-labelledby="reviews-title">
        <div class="section-head" data-reveal>
          <h2 id="reviews-title" class="section-title">Kind words.</h2>
        </div>
        <ul class="review-row" role="list">
          {testimonials.map((t) => (
            <li class="review" data-reveal>
              <blockquote>“{t.quote}”</blockquote>
              <p class="review-by">{t.name} · {t.role}</p>
              {t.sample && <p class="sample-note">Sample review: replace before launch</p>}
            </li>
          ))}
        </ul>
      </section>

      <!-- FAQ -->
      <section id="faq" class="faq" aria-labelledby="faq-title">
        <div class="section-head" data-reveal>
          <h2 id="faq-title" class="section-title">Good to know.</h2>
        </div>
        <ul class="faq-list" role="list">
          {faqs.map((f, i) => (
            <li class:list={["faq-item", { open: i === 0 }]} data-reveal>
              <button type="button" class="faq-q" aria-expanded={i === 0 ? "true" : "false"} aria-controls={`faq-a-${i}`}>
                <span>{f.q}</span><span class="faq-plus" aria-hidden="true"></span>
              </button>
              <div class="faq-a" id={`faq-a-${i}`} role="region"><div><p>{f.a}</p></div></div>
            </li>
          ))}
        </ul>
      </section>

      <!-- Order -->
      <section id="order" class="order" aria-labelledby="order-title">
        <div class="section-head" data-reveal>
          <h2 id="order-title" class="section-title">{inquiry.heading}</h2>
          <p class="section-sub">{inquiry.text}</p>
        </div>

        <form class="order-card" data-inquiry data-wa-link={brand.whatsapp} data-wa-number={brand.whatsappNumber} data-reveal>
          <fieldset class="occasions">
            <legend>Occasion</legend>
            <div class="chips">
              {inquiry.occasions.map((o, i) => (
                <label class="chip"><input type="radio" name="occasion" value={o} checked={i === 0} /><span>{o}</span></label>
              ))}
            </div>
          </fieldset>

          <div class="field-grid">
            <label class="field"><span>Your name</span><input name="name" autocomplete="name" required /></label>
            <label class="field"><span>Phone / WhatsApp</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="07XX XXX XXX" required /></label>
            <label class="field span-2"><span>Which gift?</span><input name="gift" placeholder="e.g. The Love Box, or describe your idea" /></label>
            <label class="field"><span>Date needed</span><input name="date" type="date" /></label>
            <label class="field"><span>Budget (KSh)</span><input name="budget" inputmode="numeric" placeholder="e.g. 3,000" /></label>
            <label class="field span-2"><span>Delivery area</span><input name="area" autocomplete="address-level2" placeholder="e.g. Kilimani, Nairobi" /></label>
            <label class="field span-2"><span>Card message & notes</span><textarea name="message" rows="2" placeholder="What should the card say?"></textarea></label>
          </div>

          <button class="btn btn-lg" type="submit">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={wa} />
            <span>Send order on WhatsApp</span>
          </button>
          <p class="order-foot">No payment taken here. We'll confirm the total and delivery with you on WhatsApp.</p>
          <p class="form-note" role="status"></p>
        </form>

        <a class="link order-alt" href={brand.whatsapp} target="_blank" rel="noopener">Prefer to chat? Message us on WhatsApp <span aria-hidden="true">›</span></a>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-cols">
          <div>
            <h2>Shop</h2>
            <ul>{categories.map((c) => <li><a href="#collection" data-footer-filter={c}>{c}</a></li>)}</ul>
          </div>
          <div>
            <h2>Visit</h2>
            <ul><li>Dynamic Mall, 3rd Floor</li><li>Shop 142B, Nairobi</li></ul>
          </div>
          <div>
            <h2>Contact</h2>
            <ul>
              <li><a href={brand.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href={brand.instagram} target="_blank" rel="noopener">Instagram {brand.instagramHandle}</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-base">
          <p>Copyright © {new Date().getFullYear()} {brand.fullName}. All rights reserved.</p>
          <p><a href="https://cgdesignaus.com" target="_blank" rel="noopener">Website by CG Design &amp; Co.</a></p>
        </div>
      </div>
    </footer>

    <!-- Floating chat: WhatsApp / Instagram card (native popover, like the other client sites) -->
    <button class="chat-fab" type="button" popovertarget="chat-card" aria-label="Chat with Cherry">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" set:html={wa} />
    </button>
    <div id="chat-card" class="chat-card" popover aria-labelledby="chat-card-title">
      <div class="chat-card-head">
        <img src={brand.logo} alt="" width="40" height="40" />
        <div><p id="chat-card-title" class="chat-card-title">Cherry Gift Store</p><p class="chat-card-sub">Usually replies on WhatsApp</p></div>
        <button class="chat-close" type="button" popovertarget="chat-card" popovertargetaction="hide" aria-label="Close">×</button>
      </div>
      <p class="chat-card-msg">Hi! 🍒 Looking for a gift? Message us and we'll help you pick, wrap and deliver it.</p>
      <div class="chat-card-actions">
        <a class="btn" href={brand.whatsapp} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={wa} />Chat on WhatsApp</a>
        <a class="btn btn-ghost" href={brand.instagram} target="_blank" rel="noopener">Message on Instagram</a>
        <a class="link" href="#order">Use the order form ›</a>
      </div>
    </div>

    <script>
      import { boot } from "../scripts/main";
      boot();
    </script>
  </body>
</html>
