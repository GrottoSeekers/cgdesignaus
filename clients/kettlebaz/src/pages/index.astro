---
import "@fontsource-variable/archivo/wdth.css";
import "../styles/global.css";

const site = "https://www.kettlebaz.co.uk/";
const title = "Kettlebaz | Ryan Horne, 4-week training and nutrition plan, £30 a month";
const description =
  "A 4-week training and nutrition plan written for you by Ryan Horne. Gym and home workouts, three meals a day and 24/7 support. £30 a month.";

const phoneDisplay = "07780 479139";
const whatsapp = "https://wa.me/447780479139";
// Every "Start" button opens WhatsApp with this message ready to send.
const start = `${whatsapp}?text=${encodeURIComponent("Hi Ryan, I'd like to start the £30 a month plan. (via kettlebaz website)")}`;
const cta = "Start for £30";

const instagram = "https://www.instagram.com/kettlebaz/";
const tiktok = "https://www.tiktok.com/@ryanhorne07";
const youtube = "https://youtube.com/@bazhorne";

// Tabler icons (MIT), outline set, stroke 2.
const icon = {
  whatsapp: '<path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"/><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"/>',
  instagram: '<path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10"/><path d="M8.5 12a3.5 3.5 0 1 0 7 0a3.5 3.5 0 0 0 -7 0"/><path d="M17 7v.01"/>',
  tiktok: '<path d="M21 7.917v4.034a9.948 9.948 0 0 1 -5 -1.951v4.5a6.5 6.5 0 1 1 -8 -6.326v4.326a2.5 2.5 0 1 0 4 2v-11.5h4.083a6.005 6.005 0 0 0 4.917 4.917"/>',
  youtube: '<path d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8"/><path d="M10 9l5 3l-5 3l0 -6"/>',
  home: '<path d="M5 12l-2 0l9 -9l9 9l-2 0"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"/><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6"/>',
  barbell: '<path d="M2 12h1"/><path d="M6 8h-2a1 1 0 0 0 -1 1v6a1 1 0 0 0 1 1h2"/><path d="M6 7v10a1 1 0 0 0 1 1h1a1 1 0 0 0 1 -1v-10a1 1 0 0 0 -1 -1h-1a1 1 0 0 0 -1 1"/><path d="M9 12h6"/><path d="M15 7v10a1 1 0 0 0 1 1h1a1 1 0 0 0 1 -1v-10a1 1 0 0 0 -1 -1h-1a1 1 0 0 0 -1 1"/><path d="M18 8h2a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-2"/><path d="M22 12h-1"/>',
  flame: '<path d="M12 10.941c2.333 -3.308 .167 -7.823 -1 -8.941c0 3.395 -2.235 5.299 -3.667 6.706c-1.43 1.408 -2.333 3.294 -2.333 5.588c0 3.704 3.134 6.706 7 6.706c3.866 0 7 -3.002 7 -6.706c0 -1.712 -1.232 -4.403 -2.333 -5.588c-2.084 3.353 -3.257 3.353 -4.667 2.235"/>',
  menu: '<path d="M4 6l16 0"/><path d="M4 12l16 0"/><path d="M4 18l16 0"/>',
  x: '<path d="M18 6l-12 12"/><path d="M6 6l12 12"/>',
};

const socials = [
  { label: "Instagram", handle: "@kettlebaz", href: instagram, icon: icon.instagram },
  { label: "TikTok", handle: "@ryanhorne07", href: tiktok, icon: icon.tiktok },
  { label: "YouTube", handle: "@bazhorne", href: youtube, icon: icon.youtube },
];

const plan = [
  {
    key: "training",
    title: "Training plan",
    body: "Gym and home workouts, set out week by week.",
    img: "/media/gym-thursday.webp",
    alt: "Ryan mid-session at a kettlebell class",
  },
  { key: "food", title: "Nutrition plan", body: "Three meals a day, built around food you like." },
  {
    key: "ryan",
    title: "Ryan, 24/7",
    body: "Message any time. Questions, check-ins, bad weeks.",
    img: "/media/ryan-portrait.webp",
    alt: "Ryan Horne smiling in the gym",
  },
  { key: "rolling", title: "Rolling monthly", body: "A new 4-week block each month, built on the last. Stop whenever you like." },
];

const workouts = [
  { video: "/media/reel-thrusters.mp4", poster: "/media/reel-thrusters.webp", name: "AMRAP 10", note: "10 minutes", moves: ["5 thrusters", "5 high pulls", "5 press-ups"] },
  { video: "/media/reel-clean-press.mp4", poster: "/media/reel-clean-press.webp", name: "Clean & press", note: "As many rounds as you can", moves: ["4 cleans", "4 presses", "4 squats", "4 rows"] },
  { video: "/media/reel-deadlift.mp4", poster: "/media/reel-deadlift.webp", name: "Full body", note: "As many rounds as you can", moves: ["4 deadlifts", "4 cleans", "4 presses", "4 press-ups", "4 switch lunges each leg"] },
];

const steps = [
  { verb: "Message", body: "Send me a WhatsApp. I reply myself." },
  { verb: "Tell me", body: "Your goal, your week, and the food you like." },
  { verb: "Train", body: "Your workouts and meals for the next 4 weeks, written for you." },
  { verb: "Check in", body: "Message whenever. Every 4 weeks, we go again." },
];

const includes = [
  "4-week training plan, gym and home",
  "Full nutrition plan, three meals a day",
  "24/7 messages with Ryan",
  "New plan every month",
];

const faqs = [
  { q: "Do I need a gym?", a: "No. You get gym and home workouts. Tell me what kit you have and I'll work with it." },
  { q: "Do I have to give up takeaways?", a: "No. The plan is built around a normal life. Pints and the odd pizza included." },
  { q: "How do I pay?", a: "Message me on WhatsApp and I'll send you a payment link. £30 a month, that's it." },
  { q: "Can I stop?", a: "Yes. It's rolling monthly, so you can stop whenever you like." },
];

// CG Design & Co. credit strip (same links as the Nigel's and NIR-MA-TA footers).
const cgLinks = [
  { label: "cgdesignaus.com", href: "https://cgdesignaus.com", external: true, icon: '<path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M3.6 9h16.8"/><path d="M3.6 15h16.8"/><path d="M11.5 3a17 17 0 0 0 0 18"/><path d="M12.5 3a17 17 0 0 1 0 18"/>' },
  { label: "cgdesignaus@outlook.com", href: "mailto:cgdesignaus@outlook.com", external: false, icon: '<path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/><path d="M3 7l9 6l9 -6"/>' },
  { label: "WhatsApp", href: "https://wa.me/447306100251", external: true, icon: icon.whatsapp },
  { label: "@cgdesignaus", href: "https://www.instagram.com/cgdesignaus", external: true, icon: '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"/><path d="M17.5 6.5h.01"/>' },
];

const ext = { target: "_blank", rel: "noopener noreferrer" };

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Kettlebaz 4-week training and nutrition plan",
  description,
  url: site,
  image: new URL("/media/ryan-hero-1200.webp", site).href,
  serviceType: "Online personal training and nutrition coaching",
  provider: { "@type": "Person", name: "Ryan Horne", telephone: "+447780479139", sameAs: [instagram, tiktok, youtube] },
  areaServed: "GB",
  offers: {
    "@type": "Offer",
    price: "30.00",
    priceCurrency: "GBP",
    priceSpecification: { "@type": "UnitPriceSpecification", price: "30.00", priceCurrency: "GBP", billingDuration: "P1M" },
  },
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <meta name="theme-color" content="#111114" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Kettlebaz | Get fit. Keep the pints." />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={new URL("/media/og.jpg", site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/media/ryan-hero-720.webp" imagesrcset="/media/ryan-hero-720.webp 720w, /media/ryan-hero-1200.webp 1200w" imagesizes="(min-width: 900px) 44vw, 100vw" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Hide animated elements only when JS runs; the failsafe shows them after 2.5s.
      document.documentElement.classList.add("js");
      setTimeout(function () { document.documentElement.classList.add("motion-ready"); }, 2500);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav" data-nav>
      <div class="wrap nav-inner">
        <a class="brand" href="#top" aria-label="Kettlebaz, back to top">
          <span class="brand-badge" aria-hidden="true">KB</span>
          <span class="brand-name">Kettlebaz</span>
        </a>
        <nav class="nav-links" aria-label="Sections">
          <a href="#plan">The plan</a>
          <a href="#workouts">Workouts</a>
          <a href="#price">Price</a>
          <a href="#faq">Questions</a>
        </nav>
        <div class="nav-end">
          <div class="nav-social">
            {socials.map((s) => (
              <a href={s.href} {...ext} aria-label={`${s.label} ${s.handle}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
              </a>
            ))}
          </div>
          <a class="btn btn-sm nav-cta" href={start} {...ext}>{cta}</a>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow" data-hero-fade>4-week training + nutrition plan</p>
            <h1 id="hero-title" class="hero-title">
              <span class="line"><span>Get fit.</span></span>
              <span class="line"><span class="red">Keep the pints.</span></span>
            </h1>
            <p class="hero-sub" data-hero-fade>
              A plan written for you by Ryan Horne. Workouts, meals and Ryan on WhatsApp. £30 a month.
            </p>
            <div class="hero-actions" data-hero-fade>
              <a class="btn btn-lg" href={start} {...ext} data-magnetic>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.whatsapp} />
                {cta}
              </a>
              <a class="btn btn-lg btn-ghost" href="#plan">What's included</a>
            </div>
          </div>
          <div class="hero-photo" data-hero-photo>
            <img
              src="/media/ryan-hero-720.webp"
              srcset="/media/ryan-hero-720.webp 720w, /media/ryan-hero-1200.webp 1200w"
              sizes="(min-width: 900px) 44vw, 100vw"
              width="1200"
              height="1600"
              alt="Ryan Horne standing in the gym"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Ryan's story, in his words -->
      <section class="story dark" aria-label="Ryan's story">
        <div class="wrap story-inner">
          <p class="story-text" data-scrub-words>
            I used to be overweight and stuck in my own head. I thought you could be fit or enjoy life, never both. I love pints, takeaways and holidays. I still got in shape.
            <span class="red">Now I'll show you how.</span>
          </p>
          <div class="story-sign" data-reveal>
            <img src="/media/ryan-portrait.webp" width="577" height="577" alt="" loading="lazy" decoding="async" />
            <p><strong>Ryan Horne</strong><br />Coach, kettlebells and running. Time spent around professional sport.</p>
          </div>
        </div>
      </section>

      <!-- What £30 gets you -->
      <section class="plan" id="plan" aria-labelledby="plan-title">
        <div class="wrap">
          <h2 id="plan-title" class="h2" data-reveal>One plan. <span class="red">Everything in it.</span></h2>
          <div class="bento">
            {plan.map((p) => (
              <article class={`cell cell-${p.key}`} data-cell>
                {p.img && (
                  <div class="cell-media">
                    <img src={p.img} alt={p.alt} loading="lazy" decoding="async" data-parallax />
                  </div>
                )}
                {p.key === "rolling" && <span class="cell-big" aria-hidden="true">4<small>weeks</small></span>}
                <div class="cell-copy">
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Free workouts from his feed -->
      <section class="workouts dark" id="workouts" aria-labelledby="wk-title">
        <div class="wrap">
          <h2 id="wk-title" class="h2" data-reveal>Try one <span class="red">tonight.</span></h2>
          <p class="lede" data-reveal>Three of my kettlebell sessions. Set a timer and go.</p>
        </div>
        <div class="wk-track" data-wk-track>
          {workouts.map((w) => (
            <article class="wk" data-wk>
              <div class="wk-video">
                <video muted loop playsinline preload="none" poster={w.poster} aria-hidden="true" data-autoplay>
                  <source src={w.video} type="video/mp4" />
                </video>
              </div>
              <h3>{w.name}</h3>
              <p class="wk-note">{w.note}</p>
              <ul>{w.moves.map((m) => <li>{m}</li>)}</ul>
            </article>
          ))}
        </div>
        <div class="wrap">
          <p class="wk-foot" data-reveal>
            AMRAP means as many rounds as possible. New sessions every week on
            <a href={instagram} {...ext}>Instagram</a>, <a href={tiktok} {...ext}>TikTok</a> and <a href={youtube} {...ext}>YouTube</a>.
          </p>
        </div>
      </section>

      <!-- How it works -->
      <section class="how" aria-labelledby="how-title">
        <div class="wrap how-grid">
          <h2 id="how-title" class="h2 how-title" data-reveal>How it <span class="red">works.</span></h2>
          <div class="steps" data-steps>
            <span class="steps-rail" aria-hidden="true"><span data-rail></span></span>
            <ol>
              {steps.map((s) => (
                <li class="step" data-step>
                  <h3>{s.verb}</h3>
                  <p>{s.body}</p>
                </li>
              ))}
            </ol>
          </div>
          <blockquote class="beth" data-reveal>
            <p>“Take Beth. She loves the gym and never lacks motivation. Food was the struggle. Now she has a 4-week toning and nutrition plan, and me on hand.”</p>
            <cite>Ryan, on client Beth</cite>
          </blockquote>
        </div>
      </section>

      <!-- Price -->
      <section class="price dark" id="price" aria-labelledby="price-title">
        <div class="wrap price-grid">
          <div class="bell" data-bell>
            <canvas aria-hidden="true" data-bell-canvas></canvas>
            <span class="bell-shadow" aria-hidden="true"></span>
          </div>
          <div class="price-card">
            <h2 id="price-title" class="price-amount" data-reveal>
              <span class="cur">£</span><span data-count="30">30</span><span class="per">a month</span>
            </h2>
            <p class="price-week" data-reveal>That's £7.50 a week.</p>
            <ul class="ticks">{includes.map((i) => <li data-tick>{i}</li>)}</ul>
            <a class="btn btn-lg btn-block" href={start} {...ext} data-reveal data-magnetic>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.whatsapp} />
              {cta}
            </a>
            <p class="price-note" data-reveal>Rolling monthly. Stop any time.</p>
          </div>
        </div>
      </section>

      <!-- Questions -->
      <section class="faq" id="faq" aria-labelledby="faq-title">
        <div class="wrap faq-grid">
          <h2 id="faq-title" class="h2" data-reveal>Good to <span class="red">know.</span></h2>
          <div class="faq-list">
            {faqs.map((f) => (
              <details data-reveal>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- Close -->
      <section class="close" aria-labelledby="close-title">
        <div class="wrap close-inner">
          <h2 id="close-title" class="close-title" data-reveal>Your first 4 weeks start with a message.</h2>
          <a class="btn btn-lg btn-ink" href={start} {...ext} data-reveal data-magnetic>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.whatsapp} />
            {cta}
          </a>
          <p class="close-phone" data-reveal>Or WhatsApp <a href={whatsapp} {...ext}>{phoneDisplay}</a></p>
        </div>
      </section>
    </main>

    <footer class="foot dark">
      <div class="wrap">
        <p class="foot-word" aria-hidden="true" data-foot-word>Kettlebaz</p>
        <div class="foot-grid">
          <ul class="foot-social">
            <li>
              <a href={whatsapp} {...ext}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.whatsapp} />
                <span><strong>WhatsApp</strong> {phoneDisplay}</span>
              </a>
            </li>
            {socials.map((s) => (
              <li>
                <a href={s.href} {...ext}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
                  <span><strong>{s.label}</strong> {s.handle}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="foot-small">&copy; {new Date().getFullYear()} Ryan Horne. Kettlebells &amp; running.</p>
        </div>
      </div>
    </footer>

    <aside class="cg-credit" aria-label="Website credit">
      <div class="wrap">
        <div class="cg-credit-lead">
          <img src="/media/cgd-logo.webp" alt="CG Design" width="62" height="24" />
          <span>Want a website like this? Reach out to CG Design.</span>
        </div>
        <div class="cg-credit-links">
          {cgLinks.map((l) => (
            <a href={l.href} {...(l.external && ext)}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon} />
              {l.label}
            </a>
          ))}
        </div>
      </div>
    </aside>

    <!-- Phones: app-style tab bar, always on screen -->
    <nav class="tabbar" aria-label="Quick links">
      <a href="#top" data-tab="top">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.home} />
        Home
      </a>
      <a href="#plan" data-tab="plan">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.barbell} />
        Plan
      </a>
      <a class="tab-main" href={start} {...ext} aria-label="Start for £30 on WhatsApp">
        <span class="tab-main-dot">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.whatsapp} />
        </span>
        Start
      </a>
      <a href="#workouts" data-tab="workouts">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.flame} />
        Workouts
      </a>
      <button type="button" popovertarget="more" data-tab="more">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.menu} />
        More
      </button>
    </nav>

    <div id="more" class="sheet" popover aria-labelledby="more-title">
      <div class="sheet-head">
        <p id="more-title" class="sheet-title">Kettlebaz</p>
        <button type="button" class="sheet-close" popovertarget="more" popovertargetaction="hide" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.x} />
        </button>
      </div>
      <ul class="sheet-links">
        <li><a href="#price" data-sheet-link>Price, £30 a month</a></li>
        <li><a href="#faq" data-sheet-link>Questions</a></li>
        <li>
          <a href={whatsapp} {...ext}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.whatsapp} />
            WhatsApp {phoneDisplay}
          </a>
        </li>
        {socials.map((s) => (
          <li>
            <a href={s.href} {...ext}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
              {s.label} {s.handle}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
