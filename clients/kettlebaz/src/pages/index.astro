---
import "@fontsource-variable/bodoni-moda/opsz.css";
import "@fontsource-variable/bodoni-moda/opsz-italic.css";
import "@fontsource-variable/archivo/wdth.css";
import "../styles/global.css";

const site = "https://www.kettlebaz.co.uk/";
const title = "Kettlebaz | Ryan Horne, 4-week training and nutrition plan, £30 a month";
const description =
  "A 4-week training and nutrition plan written for you by Ryan Horne. Gym and home workouts, three meals a day and 24/7 support. £30 a month.";

const instagram = "https://www.instagram.com/kettlebaz/";
// Opens a DM to @kettlebaz in the Instagram app (or web on desktop).
// Swap for a payment link when Ryan has one.
const start = "https://ig.me/m/kettlebaz";
const cta = "Start for £30";

const plan = [
  {
    key: "training",
    title: "Training plan",
    body: "Gym and home workouts, set out week by week.",
    img: "/media/gym-thursday.webp",
    alt: "Ryan mid-session at a kettlebell class under pink gym lights",
  },
  {
    key: "food",
    title: "Nutrition plan",
    body: "Three meals a day, built around food you like.",
  },
  {
    key: "ryan",
    title: "Ryan, 24/7",
    body: "Message any time. Questions, check-ins, bad weeks.",
    img: "/media/ryan-portrait.webp",
    alt: "Ryan Horne smiling in the gym",
  },
  {
    key: "rolling",
    title: "Rolling monthly",
    body: "A new 4-week block each month, built on the last. Stop whenever you like.",
  },
];

const workouts = [
  {
    video: "/media/reel-thrusters.mp4",
    poster: "/media/reel-thrusters.webp",
    name: "AMRAP 10",
    note: "10 minutes",
    moves: ["5 thrusters", "5 high pulls", "5 press-ups"],
  },
  {
    video: "/media/reel-clean-press.mp4",
    poster: "/media/reel-clean-press.webp",
    name: "Clean & press",
    note: "As many rounds as you can",
    moves: ["4 cleans", "4 presses", "4 squats", "4 rows"],
  },
  {
    video: "/media/reel-deadlift.mp4",
    poster: "/media/reel-deadlift.webp",
    name: "Full body",
    note: "As many rounds as you can",
    moves: ["4 deadlifts", "4 cleans", "4 presses", "4 press-ups", "4 switch lunges each leg"],
  },
];

const steps = [
  { verb: "Message", body: "Send me a DM on Instagram." },
  { verb: "Tell me", body: "Your goal, your week, and the food you like." },
  { verb: "Train", body: "Your workouts and meals for the next 4 weeks, written for you." },
  { verb: "Check in", body: "Message whenever. Every 4 weeks, we go again." },
];

const includes = [
  "4-week training plan, gym and home",
  "Full nutrition plan, three meals a day",
  "24/7 messages with Ryan",
  "New plan every month",
];

const faqs = [
  { q: "Do I need a gym?", a: "No. You get gym and home workouts. Tell me what kit you have and I'll work with it." },
  { q: "Do I have to give up takeaways?", a: "No. The plan is built around a normal life. Pints and the odd pizza included." },
  { q: "How do I pay?", a: "Message me on Instagram and I'll send you a payment link. £30 a month, that's it." },
  { q: "Can I stop?", a: "Yes. It's rolling monthly, so you can stop whenever you like." },
];

// CG Design & Co. credit strip (same links as the Nigel's and NIR-MA-TA footers).
const cgLinks = [
  {
    label: "cgdesignaus.com",
    href: "https://cgdesignaus.com",
    external: true,
    icon: '<path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M3.6 9h16.8"/><path d="M3.6 15h16.8"/><path d="M11.5 3a17 17 0 0 0 0 18"/><path d="M12.5 3a17 17 0 0 1 0 18"/>',
  },
  {
    label: "cgdesignaus@outlook.com",
    href: "mailto:cgdesignaus@outlook.com",
    external: false,
    icon: '<path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/><path d="M3 7l9 6l9 -6"/>',
  },
  {
    label: "WhatsApp",
    href: "https://wa.me/447306100251",
    external: true,
    icon: '<path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"/><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"/>',
  },
  {
    label: "@cgdesignaus",
    href: "https://www.instagram.com/cgdesignaus",
    external: true,
    icon: '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"/><path d="M17.5 6.5h.01"/>',
  },
];

const igIcon =
  '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"/><path d="M17.5 6.5h.01"/>';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Kettlebaz 4-week training and nutrition plan",
  description,
  url: site,
  image: new URL("/media/ryan-hero-1200.webp", site).href,
  serviceType: "Online personal training and nutrition coaching",
  provider: { "@type": "Person", name: "Ryan Horne", sameAs: [instagram] },
  areaServed: "GB",
  offers: {
    "@type": "Offer",
    price: "30.00",
    priceCurrency: "GBP",
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      price: "30.00",
      priceCurrency: "GBP",
      billingDuration: "P1M",
    },
  },
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <meta name="theme-color" content="#0b0810" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Kettlebaz | Get fit. Keep the pints." />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={new URL("/media/og.jpg", site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/media/ryan-hero-720.webp" imagesrcset="/media/ryan-hero-720.webp 720w, /media/ryan-hero-1200.webp 1200w" imagesizes="(min-width: 900px) 42vw, 100vw" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Hide animated elements only when JS runs. If the bundle never loads,
      // the failsafe shows everything after 2.5s.
      document.documentElement.classList.add("js");
      setTimeout(function () { document.documentElement.classList.add("motion-ready"); }, 2500);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav" data-nav>
      <div class="wrap nav-inner">
        <a class="nav-mark" href="#top" aria-label="Kettlebaz, back to top">Kettlebaz</a>
        <a class="btn btn-sm nav-cta" href={start} target="_blank" rel="noopener noreferrer">{cta}</a>
      </div>
    </header>

    <main id="main">
      <!-- Cover -->
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-photo" data-hero-photo>
          <img
            src="/media/ryan-hero-720.webp"
            srcset="/media/ryan-hero-720.webp 720w, /media/ryan-hero-1200.webp 1200w"
            sizes="(min-width: 900px) 42vw, 100vw"
            width="1200"
            height="1600"
            alt="Ryan Horne standing in the gym under pink and violet lights"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="wrap hero-grid">
          <p class="masthead" aria-hidden="true" data-masthead>Kettlebaz</p>
          <div class="hero-copy">
            <h1 id="hero-title" class="hero-title" data-hero-line>
              <span class="line"><span>Get fit.</span></span>
              <span class="line"><span><em>Keep</em> the pints.</span></span>
            </h1>
            <p class="hero-sub" data-hero-fade>
              A 4-week training and nutrition plan, written for you by Ryan Horne. £30 a month.
            </p>
            <div class="hero-actions" data-hero-fade>
              <a class="btn" href={start} target="_blank" rel="noopener noreferrer" data-magnetic>{cta}</a>
              <a class="link-arrow" href="#plan">What you get</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Ryan's story, in his words -->
      <section class="story" aria-label="Ryan's story">
        <div class="wrap story-inner">
          <p class="story-text" data-scrub-words>
            I used to be overweight and stuck in my own head. I thought you could be fit or enjoy life, never both. I love pints, takeaways and holidays. I still got in shape.
            <em>Now I'll show you how.</em>
          </p>
          <div class="story-sign" data-reveal>
            <img src="/media/ryan-portrait.webp" width="577" height="577" alt="" loading="lazy" decoding="async" />
            <p><strong>Ryan Horne</strong><br />Coach, kettlebells and running. Time spent around professional sport.</p>
          </div>
        </div>
      </section>

      <!-- What £30 gets you -->
      <section class="plan" id="plan" aria-labelledby="plan-title">
        <div class="wrap">
          <h2 id="plan-title" class="h2" data-reveal>One plan. <em>Everything</em> in it.</h2>
          <div class="bento">
            {plan.map((p) => (
              <article class={`cell cell-${p.key}`} data-cell>
                {p.img && (
                  <div class="cell-media">
                    <img src={p.img} alt={p.alt} loading="lazy" decoding="async" data-parallax />
                  </div>
                )}
                {p.key === "rolling" && <span class="cell-big" aria-hidden="true">4<small>wk</small></span>}
                <div class="cell-copy">
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Free workouts from his feed -->
      <section class="workouts" aria-labelledby="wk-title">
        <div class="wrap">
          <p class="eyebrow" data-reveal>Save &amp; try</p>
          <h2 id="wk-title" class="h2" data-reveal>Try one <em>tonight.</em></h2>
          <p class="lede" data-reveal>Three of my kettlebell sessions. Set a timer and go.</p>
        </div>
        <div class="wk-track" data-wk-track>
          {workouts.map((w) => (
            <article class="wk" data-wk>
              <div class="wk-video">
                <video muted loop playsinline preload="none" poster={w.poster} aria-hidden="true" data-autoplay>
                  <source src={w.video} type="video/mp4" />
                </video>
              </div>
              <h3>{w.name}</h3>
              <p class="wk-note">{w.note}</p>
              <ul>
                {w.moves.map((m) => <li>{m}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <div class="wrap">
          <p class="wk-foot" data-reveal>AMRAP means as many rounds as possible. More every week on <a href={instagram} target="_blank" rel="noopener noreferrer">@kettlebaz</a>.</p>
        </div>
      </section>

      <!-- How it works -->
      <section class="how" aria-labelledby="how-title">
        <div class="wrap how-grid">
          <h2 id="how-title" class="h2 how-title" data-reveal>How it <em>works.</em></h2>
          <div class="steps" data-steps>
            <span class="steps-rail" aria-hidden="true"><span data-rail></span></span>
            <ol>
              {steps.map((s) => (
                <li class="step" data-step>
                  <h3>{s.verb}</h3>
                  <p>{s.body}</p>
                </li>
              ))}
            </ol>
          </div>
          <blockquote class="beth" data-reveal>
            <p>Take Beth. She loves the gym and never lacks motivation. Food was the struggle. Now she has a 4-week toning and nutrition plan, and me on hand.</p>
            <cite>Ryan, on client Beth</cite>
          </blockquote>
        </div>
      </section>

      <!-- Price -->
      <section class="price" id="price" aria-labelledby="price-title">
        <div class="wrap price-grid">
          <div class="bell" data-bell>
            <canvas aria-hidden="true" data-bell-canvas></canvas>
            <span class="bell-shadow" aria-hidden="true"></span>
          </div>
          <div class="price-card">
            <h2 id="price-title" class="price-amount" data-reveal>
              <span class="cur">£</span><span data-count="30">30</span><span class="per">a month</span>
            </h2>
            <p class="price-week" data-reveal>That's £7.50 a week.</p>
            <ul class="ticks">
              {includes.map((i) => <li data-tick>{i}</li>)}
            </ul>
            <a class="btn btn-block" href={start} target="_blank" rel="noopener noreferrer" data-reveal data-magnetic>{cta}</a>
            <p class="price-note" data-reveal>Rolling monthly. Stop any time.</p>
          </div>
        </div>
      </section>

      <!-- Questions -->
      <section class="faq" aria-labelledby="faq-title">
        <div class="wrap faq-grid">
          <h2 id="faq-title" class="h2" data-reveal>Questions.</h2>
          <div class="faq-list">
            {faqs.map((f) => (
              <details data-reveal>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- Close -->
      <section class="close" aria-labelledby="close-title">
        <div class="close-glow" aria-hidden="true" data-glow></div>
        <div class="wrap close-inner">
          <h2 id="close-title" class="close-title" data-reveal>Your first 4 weeks start with <em>a message.</em></h2>
          <a class="btn" href={start} target="_blank" rel="noopener noreferrer" data-reveal data-magnetic>{cta}</a>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <span class="nav-mark">Kettlebaz</span>
        <a class="foot-ig" href={instagram} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={igIcon} />
          @kettlebaz
        </a>
        <span class="foot-small">&copy; {new Date().getFullYear()} Ryan Horne</span>
      </div>
    </footer>

    <aside class="cg-credit" aria-label="Website credit">
      <div class="wrap">
        <div class="cg-credit-lead">
          <img src="/media/cgd-logo.webp" alt="CG Design" width="62" height="24" />
          <span>Want a website like this? Reach out to CG Design.</span>
        </div>
        <div class="cg-credit-links">
          {cgLinks.map((l) => (
            <a href={l.href} {...(l.external && { target: "_blank", rel: "noopener noreferrer" })}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon} />
              {l.label}
            </a>
          ))}
        </div>
      </div>
    </aside>

    <!-- Phones: price + start, pinned to the bottom once the cover has scrolled away -->
    <div class="dock" data-dock aria-hidden="true">
      <span class="dock-price"><strong>£30</strong> a month</span>
      <a class="btn btn-sm" href={start} target="_blank" rel="noopener noreferrer" tabindex="-1">{cta}</a>
    </div>

    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
