---
import "@fontsource/anton/400.css";
import "@fontsource-variable/inter";
import "../styles/global.css";

// ---------------------------------------------------------------------------
// Everything Broghan will change lives here. Copy, prices and links come from
// his own draft (broghanwilson.com). Anything still in [BRACKETS] is a
// placeholder waiting on him (photos, videos, more reviews, his story).
//
// Layout: the long-form structure of jamessmith.business (the page Broghan
// called "perfect"): VSL first, results, what's included, how it works,
// guarantee, transparent pricing with direct Stripe checkout, FAQ. Every
// "Join today" button scrolls to pricing. No social links.
// Photos and videos: drop files in public/images or public/video and set the
// paths below. Empty paths show a labelled placeholder.
// ---------------------------------------------------------------------------

const site = "https://broghanwilson.com/";
const title = "Broghan Wilson Coaching";
const description =
  "Online coaching with Broghan Wilson. A training and nutrition plan built around your life, weekly check-ins, and a 12-week results guarantee.";

// ---- Hero ----
const status = "Online coaching, now taking clients";
const headline = {
  lead: "Become the version of yourself that you said",
  highlight: "wasn’t possible.",
  close: "",
};
const uppercut =
  "The confidence you’re looking for is on the other side of stacking small habits and a program built only for you.";

// VSL: { type: "youtube" | "vimeo", id } or { type: "mp4", src: "/video/vsl.mp4" }. "none" = placeholder.
const vsl: { type: "none" | "youtube" | "vimeo" | "mp4"; id?: string; src?: string; poster?: string; runtime: string } = {
  type: "none",
  runtime: "[1–3 MIN]",
};
const vslCaption = "Straight from me, no script — what this is, why you need it, and what you get.";

// ---- Ticker ----
const tickerItems = ["Built only for you", "Weekly check-ins", "Nutrition that fits how you eat", "12-week results guarantee"];

// ---- Results (quote + big outcome, like the reference) ----
const resultsEyebrow = "Client results";
const resultsTitle = "What my clients say";
const results = [
  {
    quote:
      "I started training after a long gap of 3 years. I felt nervous and completely unfit to get back to the gym. I’m grateful I met Broghan as my coach. From the very first session, Broghan understood my fitness levels, my limits and my aspirations. He designed a sustainable program that looked at consistently pushing me while maintaining empathy. He’s quickly built trust and I look forward to training with him in the coming year and beyond!",
    outcome: "Back training after 3 years off",
    name: "Shrey",
    photo: "",
  },
  {
    quote:
      "Working with Broghan is amazing. He knows his stuff and gives amazing advice on anything gym related whether it is from what I can eat to help drop some weight, which exercise would help with my knee rehab and strengthening to giving advice on exercise to improve my Brazilian Jiu Jitsu! He has a great personality and does not rush you to finish your set or even your session. He will take his time to make sure you are working out with the right posture and right technique to prevent further injuries.",
    outcome: "Weight, knee rehab and BJJ, covered",
    name: "Daniel",
    photo: "",
  },
];

// ---- Credibility + story ----
const credibility = "Built on over 10 years of experience, with methods I’ve tested first-hand and used with clients from all walks of life.";
const stats = [
  { value: 10, suffix: "+", label: "Years of experience" },
  { value: 12, suffix: "", label: "Week results guarantee" },
  { value: 3, suffix: "", label: "Phases in your first 12 weeks" },
];
const story = [
  { title: "[Where I started]", body: "[TWO OR THREE SENTENCES.]" },
  { title: "[The turning point]", body: "[TWO OR THREE SENTENCES.]" },
  { title: "[Why I coach now]", body: "[TWO OR THREE SENTENCES.]" },
];
const portrait = ""; // e.g. "/images/broghan.jpg" (black & white works best)

// ---- What's included ----
const includedTitle = "Everything you need to get in the best shape of your life, and stay there";
const includedSub = "Everything below, built only for you. Now $50 USD a week.";
const included = [
  { title: "1:1 onboarding call", body: "We set your goals together.", media: "" },
  { title: "Training program", body: "Personalised for you in Trainerize.", media: "" },
  { title: "Nutrition", body: "Targets that fit how you eat.", media: "" },
  { title: "Weekly check-ins", body: "Progress reviewed, plan adjusted.", media: "" },
  { title: "Message me", body: "Support between check-ins.", media: "" },
  { title: "Video form reviews", body: "Technique breakdowns on your lifts.", media: "" },
];

// ---- How it works (a real sequence, so it's numbered) ----
const stepsEyebrow = "How it works";
const stepsTitle = "From joining to your first session";
const steps = [
  { title: "Join", body: "Sign up below and we’ll book in your onboarding call." },
  {
    title: "Onboarding call",
    body: "We go through your goals and timeframe, where you’re at now and what’s held you back before. Plus a full nutrition consult, so your plan fits your day-to-day life.",
  },
  {
    title: "Get your plan",
    body: "I design your first 12 weeks across 3 phases. Then I set you up in Trainerize with your program, your nutrition plan and phase one (your first 4 weeks) mapped out.",
  },
  { title: "Check in and progress", body: "Weekly check-ins, plus a monthly assessment at the end of each phase to show how far you’ve come." },
];

// ---- Video testimonials (portrait 9:16) ----
const videoTestimonials = [
  { name: "[CLIENT NAME]", src: "", poster: "" },
  { name: "[CLIENT NAME]", src: "", poster: "" },
  { name: "[CLIENT NAME]", src: "", poster: "" },
  { name: "[CLIENT NAME]", src: "", poster: "" },
];

// ---- Review wall (two rows that scroll opposite ways) ----
const reviews = [
  { name: "Shrey", text: "He designed a sustainable program that looked at consistently pushing me while maintaining empathy." },
  ...Array.from({ length: 4 }, () => ({ name: "[NAME]", text: "[CLIENT MESSAGE OR REVIEW — PASTE THE REAL WORDS, OR SWAP FOR A SCREENSHOT.]" })),
  { name: "Daniel", text: "He will take his time to make sure you are working out with the right posture and right technique to prevent further injuries." },
  ...Array.from({ length: 4 }, () => ({ name: "[NAME]", text: "[CLIENT MESSAGE OR REVIEW — PASTE THE REAL WORDS, OR SWAP FOR A SCREENSHOT.]" })),
];

// ---- Guarantee (a free month, not a refund) ----
const guarantee = {
  weeks: 12,
  label: "12-week results guarantee",
  heading: "Follow the plan for 12 weeks. If you don’t progress, your next month is on me.",
  terms:
    "Train, hit your check-ins every week and follow your nutrition targets. We track your progress two ways: weekly check-ins, and a monthly assessment at the end of each phase. If your results haven’t moved towards your goal after 12 weeks, you get another month of coaching free. This applies to both plans, as long as you’ve completed the full 12 weeks.",
};

// ---- Pricing: direct Stripe checkout ----
const pricingTitle = "You only have to get it right once. Why not today?";
const pricingSub =
  "Honestly, I can’t predict every problem you’ll face. That’s why your coaching grows with you. As I learn what’s getting in your way, I’ll keep adjusting your plan to solve it.";
const planFeatures = [
  "1:1 onboarding call to set your goals",
  "Personalised training program in Trainerize",
  "Nutrition targets that fit how you eat",
  "Weekly check-ins",
  "Monthly assessment at the end of each phase",
  "Message me for support between check-ins",
  "Video form reviews",
];
const plans = [
  {
    name: "Monthly",
    price: "$200",
    period: "USD / month",
    note: "That’s $50 a week, billed monthly",
    features: planFeatures,
    cta: "Join monthly",
    checkoutUrl: "https://buy.stripe.com/6oU00ja4V8RhcTb04xe3e00",
    flag: "",
    featured: false,
  },
  {
    name: "3 months",
    price: "$500",
    period: "USD all in",
    note: "One payment for 12 weeks, about $42 a week",
    features: planFeatures,
    cta: "Join for 3 months",
    checkoutUrl: "https://buy.stripe.com/00w5kDdh75F53iBcRje3e01",
    flag: "Best value · Save $100",
    featured: true,
  },
];
const plansNote = "12-week results guarantee on both plans: progress or your next month is free.";
const freeCall = {
  title: "Still unsure?",
  body: "Book a free call and we can chat about your goals and whether online coaching is right for you.",
  cta: "Book a call today",
  url: "https://calendly.com/broghanwilsonpt/free-consultation",
};

// ---- FAQ ----
const faqs = [
  {
    q: "What happens after I join?",
    a: "We book in your onboarding call. We go through your goals and timeframe, where you’re at now and what’s held you back before, plus a full nutrition consult so your plan fits your day-to-day life.",
  },
  { q: "Which app do you use?", a: "Trainerize. Your program, your nutrition plan and each 4-week phase are set up there for you." },
  {
    q: "What’s the difference between the two plans?",
    a: "Nothing in what you get: both include everything listed. Monthly is $200 USD a month, which is $50 a week. Three months is one payment of $500 USD for 12 weeks, about $42 a week, so you save $100.",
  },
  { q: "How does the results guarantee work?", a: guarantee.terms },
  { q: "Not sure online coaching is right for you?", a: "Book a free call and we can chat about your goals and whether online coaching is right for you." },
  { q: "Do I need a gym?", a: "[ANSWER]" },
];

// ---------------------------------------------------------------------------
const year = new Date().getFullYear();
const checkout = (url?: string) => (url ? url : "#pricing");
const vslEmbed =
  vsl.type === "youtube"
    ? `https://www.youtube-nocookie.com/embed/${vsl.id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`
    : vsl.type === "vimeo"
      ? `https://player.vimeo.com/video/${vsl.id}?autoplay=1&title=0&byline=0&portrait=0`
      : "";
const check = "M5 12.5l4.2 4.2L19 7";
const pad = (n: number) => String(n + 1).padStart(2, "0");
const wallRows = [reviews.slice(0, Math.ceil(reviews.length / 2)), reviews.slice(Math.ceil(reviews.length / 2))];
// The seal ring's circumference (r = 58): the text is stretched to exactly this, so it never overlaps.
// Non-breaking spaces round the bullets so the gap where the text meets itself never collapses.
const sealText = "RESULTS GUARANTEE\u00a0\u00a0•\u00a0\u00a0".repeat(2);
const sealLength = Math.round(2 * Math.PI * 58 * 100) / 100;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0B0C0E" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Small fallbacks for older iPhones (iOS < 15.4) so the animation libraries run there too.
      if (!Array.prototype.at)
        Object.defineProperty(Array.prototype, "at", {
          configurable: true,
          writable: true,
          value: function (n) {
            n = Math.trunc(n) || 0;
            if (n < 0) n += this.length;
            return this[n];
          },
        });
      if (!Object.hasOwn) Object.hasOwn = function (o, k) { return Object.prototype.hasOwnProperty.call(o, k); };
      // Hide the bits that animate in, but only when JS is running. If the page
      // script hasn't started within 6s (a slow phone connection), show everything as-is.
      (function () {
        var d = document.documentElement;
        d.classList.add("anim");
        setTimeout(function () {
          if (!window.__bwReady) d.classList.remove("anim");
        }, 6000);
      })();
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner" data-topbar>
        <span class="brand">Broghan Wilson <em>PT</em></span>
        <a class="btn btn-primary btn-sm topbar-cta" href="#pricing">Join today</a>
      </div>
    </header>

    <main>
      <!-- ================= HERO ================= -->
      <section class="hero" id="top">
        <div class="glow glow-hero" aria-hidden="true"></div>
        <div class="wrap hero-inner">
          <p class="proof" data-hero="proof">
            <span class="live" aria-hidden="true"></span>
            <span>{status}</span>
          </p>

          <h1 class="headline" data-hero="headline">
            {headline.lead} <span class="hl">{headline.highlight}<i class="hl-bar" aria-hidden="true"></i></span>
            {headline.close && <><br />{headline.close}</>}
          </h1>

          <p class="uppercut" data-hero="uppercut">{uppercut}</p>
          <p class="show-you" data-hero="uppercut">Let me show you how.</p>

          <div class="vsl" data-hero="vsl">
            <div class="vsl-frame" data-video={vsl.type} data-embed={vslEmbed} data-src={vsl.src ?? ""}>
              {vsl.poster && <img class="vsl-poster" src={vsl.poster} alt="" />}
              <div class="hatch" aria-hidden="true"></div>
              <button class="vsl-play" type="button" aria-label="Play Broghan's video">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"></path></svg>
              </button>
              {vsl.type === "none" && <span class="vsl-tag">[VSL — BROGHAN’S VIDEO GOES HERE]</span>}
              <span class="vsl-runtime">{vsl.runtime}</span>
            </div>
            <p class="vsl-caption">{vslCaption}</p>
          </div>

          <div class="hero-cta" data-hero="cta">
            <a class="btn btn-primary btn-xl" href="#pricing" data-magnetic>Join today <span class="nudge" aria-hidden="true">→</span></a>
            <p class="cta-note">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.9-7 9-4-1.1-7-4.5-7-9V6z"></path></svg>
              {guarantee.label}
            </p>
          </div>
        </div>
      </section>

      <!-- ================= TICKER ================= -->
      <div class="ticker" aria-hidden="true">
        <div class="ticker-track" data-marquee="-1" data-speed="32">
          {[0, 1].map(() => (
            <div class="ticker-set">
              {tickerItems.map((t) => <><span>{t}</span><i></i></>)}
            </div>
          ))}
        </div>
      </div>

      <!-- ================= RESULTS ================= -->
      <section class="section" aria-labelledby="results-h">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow" data-reveal>{resultsEyebrow}</p>
            <h2 id="results-h" class="section-title" data-split>{resultsTitle}</h2>
          </div>
          <div class="results">
            {
              results.map((r) => (
                <figure class="result" data-reveal>
                  {r.photo ? <img class="avatar" src={r.photo} alt="" /> : <span class="avatar" aria-hidden="true"></span>}
                  <span class="stars" aria-label="5 out of 5 stars">★★★★★</span>
                  <blockquote>“{r.quote}”</blockquote>
                  <p class="result-outcome">{r.outcome}</p>
                  <figcaption>{r.name}</figcaption>
                </figure>
              ))
            }
          </div>
          <div class="cta-row" data-reveal><a class="btn btn-primary" href="#pricing">Join today <span class="nudge" aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <!-- ================= CREDIBILITY + STORY ================= -->
      <section class="section section-alt" aria-labelledby="story-h">
        <div class="wrap">
          <div class="section-head">
            <h2 id="story-h" class="section-title section-title-md" data-split>{credibility}</h2>
          </div>
          <div class="stats" data-reveal>
            {
              stats.map((s) => (
                <div class="stat">
                  <p class="stat-value">
                    <span data-count={s.value ?? ""}>{s.value ?? "[X]"}</span>{s.suffix}
                  </p>
                  <p class="stat-label">{s.label}</p>
                </div>
              ))
            }
          </div>
          <div class="story">
            <div class="story-steps">
              <span class="story-line" aria-hidden="true"><i></i></span>
              <ol>
              {
                story.map((s, i) => (
                  <li data-reveal>
                    <span class="story-num">{pad(i)}</span>
                    <h3>{s.title}</h3>
                    <p>{s.body}</p>
                  </li>
                ))
              }
              </ol>
            </div>
            <div class="story-photo" data-reveal>
              {portrait ? <img src={portrait} alt="Broghan Wilson" /> : <span class="ph-label">[BLACK &amp; WHITE PORTRAIT OF BROGHAN]</span>}
              <div class="hatch" aria-hidden="true"></div>
            </div>
          </div>
          <div class="cta-row" data-reveal><a class="btn btn-primary" href="#pricing">Join today <span class="nudge" aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <!-- ================= WHAT'S INCLUDED ================= -->
      <section class="section" aria-labelledby="included-h">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow" data-reveal>What’s included</p>
            <h2 id="included-h" class="section-title section-title-md" data-split>{includedTitle}</h2>
            <p data-reveal>{includedSub}</p>
          </div>
          <div class="included">
            {
              included.map((item) => (
                <article class="inc" data-reveal data-tilt>
                  <div class="inc-media">
                    {item.media ? <img src={item.media} alt="" loading="lazy" /> : <span class="ph-label">[SCREENSHOT / GIF]</span>}
                  </div>
                  <div class="inc-body">
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                  </div>
                </article>
              ))
            }
          </div>
          <div class="cta-row" data-reveal><a class="btn btn-primary" href="#pricing">Join today <span class="nudge" aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <!-- ================= OUTCOMES ================= -->
      <section class="section section-tight" aria-labelledby="outcomes-h">
        <div class="wrap wrap-narrow">
          <div class="section-head">
            <p class="eyebrow" data-reveal>{stepsEyebrow}</p>
            <h2 id="outcomes-h" class="section-title section-title-md" data-split>{stepsTitle}</h2>
          </div>
          <ol class="outcomes">
            {
              steps.map((o, i) => (
                <li data-reveal>
                  <span class="outcome-num" data-num>{pad(i)}</span>
                  <div>
                    <h3>{o.title}</h3>
                    <p>{o.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="cta-row" data-reveal><a class="btn btn-primary" href="#pricing">Join today <span class="nudge" aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <!-- ================= VIDEO TESTIMONIALS ================= -->
      <section class="section section-alt" aria-labelledby="videos-h">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow" data-reveal>In their own words</p>
            <h2 id="videos-h" class="section-title" data-split>Hear it from my clients</h2>
          </div>
          <div class="videos">
            {
              videoTestimonials.map((v) => (
                <figure class="vid" data-reveal>
                  <div class="vid-frame" data-video={v.src ? "mp4" : "none"} data-src={v.src}>
                    {v.poster && <img class="vsl-poster" src={v.poster} alt="" loading="lazy" />}
                    <button class="vid-play" type="button" aria-label={`Play video from ${v.name}`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"></path></svg>
                    </button>
                    {!v.src && <span class="ph-label">[CLIENT VIDEO]</span>}
                  </div>
                  <figcaption>{v.name}</figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ================= REVIEW WALL ================= -->
      <section class="section wall-section" aria-labelledby="wall-h">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow" data-reveal>Reviews</p>
            <h2 id="wall-h" class="section-title" data-split>What my clients are saying</h2>
          </div>
        </div>
        <div class="wall">
          {
            wallRows.map((row, r) => (
              <div class="wall-row">
                <div class="wall-track" data-marquee={r === 0 ? "-1" : "1"} data-speed="70">
                  {[0, 1].map((copy) => (
                    <div class:list={["wall-set", { dup: copy === 1 }]} aria-hidden={copy === 1 ? "true" : undefined}>
                      {row.map((rev) => (
                        <figure class="review">
                          <figcaption>
                            <span class="avatar avatar-sm" aria-hidden="true"></span>
                            {rev.name}
                            <span class="stars" aria-label="5 out of 5 stars">★★★★★</span>
                          </figcaption>
                          <blockquote>{rev.text}</blockquote>
                        </figure>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <div class="wrap"><div class="cta-row" data-reveal><a class="btn btn-primary" href="#pricing">Join today <span class="nudge" aria-hidden="true">→</span></a></div></div>
      </section>

      <!-- ================= GUARANTEE ================= -->
      <section class="guarantee" aria-labelledby="guarantee-h">
        <div class="wrap">
          <div class="guarantee-card" data-reveal>
            <div class="seal" aria-hidden="true">
              <svg class="seal-ring" viewBox="0 0 150 150">
                <defs><path id="seal-path" d="M75,75 m-58,0 a58,58 0 1,1 116,0 a58,58 0 1,1 -116,0"></path></defs>
                <text><textPath href="#seal-path" textLength={sealLength} lengthAdjust="spacing">{sealText}</textPath></text>
              </svg>
              <div class="seal-core"><span>{guarantee.weeks}</span><small>weeks</small></div>
            </div>
            <div class="guarantee-copy">
              <p class="guarantee-label">{guarantee.label}</p>
              <h2 id="guarantee-h">{guarantee.heading}</h2>
              <p>{guarantee.terms}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= PRICING ================= -->
      <section class="pricing" id="pricing" aria-labelledby="pricing-h">
        <div class="glow glow-pricing" aria-hidden="true"></div>
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow" data-reveal>Pricing</p>
            <h2 id="pricing-h" class="section-title section-title-lg" data-split>{pricingTitle}</h2>
            <p data-reveal>{pricingSub}</p>
          </div>

          <div class="plans">
            {
              plans.map((plan) => (
                <article class:list={["plan", { featured: plan.featured }]} data-plan>
                  {plan.flag && <p class="plan-flag">{plan.flag}</p>}
                  <div class="plan-body">
                    <p class="plan-name">{plan.name}</p>
                    <p class="plan-price">
                      <span class="price" data-scramble>{plan.price}</span>
                      <span class="period">{plan.period}</span>
                    </p>
                    <p class="plan-for">{plan.note}</p>
                    <p class="plan-includes">Includes</p>
                    <ul class="plan-features">
                      {plan.features.map((f) => (
                        <li>
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={check}></path></svg>
                          {f}
                        </li>
                      ))}
                    </ul>
                    <a class:list={["btn", plan.featured ? "btn-primary" : "btn-outline"]} href={checkout(plan.checkoutUrl)}>
                      {plan.cta}
                    </a>
                    <p class="plan-small">Secure checkout with Stripe</p>
                  </div>
                </article>
              ))
            }
          </div>

          <p class="plans-note" data-reveal>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.9-7 9-4-1.1-7-4.5-7-9V6z"></path></svg>
            {plansNote}
          </p>

          <div class="free-call" data-reveal>
            <div>
              <h3>{freeCall.title}</h3>
              <p>{freeCall.body}</p>
            </div>
            <a class="btn btn-outline" href={freeCall.url} target="_blank" rel="noopener">{freeCall.cta} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <!-- ================= FAQ ================= -->
      <section class="section section-tight" aria-labelledby="faq-h">
        <div class="wrap wrap-narrow">
          <div class="section-head">
            <h2 id="faq-h" class="section-title" data-split>Any questions?</h2>
          </div>
          <div class="faq" data-reveal>
            {
              faqs.map((f) => (
                <details>
                  <summary>
                    <span class="plus" aria-hidden="true"></span>
                    {f.q}
                  </summary>
                  <div class="faq-a"><p>{f.a}</p></div>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ================= FINAL CTA ================= -->
      <section class="final">
        <div class="wrap final-inner" data-reveal>
          <h2 class="final-title">Ready? Let’s go.</h2>
          <p>Pick your plan, check out, and start this week. Backed by the {guarantee.label}.</p>
          <a class="btn btn-dark btn-xl" href="#pricing">Choose your plan ↑</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <span>© {year} Broghan Wilson Coaching. All rights reserved.</span>
        <span class="footer-links"><a href="/privacy/">Privacy Policy</a><a href="/terms/">Terms</a></span>
      </div>
    </footer>

    <a class="sticky-cta btn btn-primary" href="#pricing" aria-hidden="true" tabindex="-1">Join today →</a>

    <script>
      import "../scripts/page.ts";
    </script>
  </body>
</html>
