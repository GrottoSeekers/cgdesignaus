---
import "@fontsource-variable/grandstander";
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/600.css";
import "@fontsource/barlow/700.css";
import "../styles/global.css";

// Preview address until Curly's buys a domain; change here, in astro.config.mjs, robots.txt and sitemap.xml.
const site = "https://curlys-kitchen-five.vercel.app/";
const title = "Curly's Kitchen | Steak boxes & takeaway in Walkden, Worsley";
const description =
  "Steak, chicken and burger boxes cooked to order in Walkden, Worsley. 5.0 on Google, food hygiene 5. Open Mon to Fri 5 to 10pm, Sunday 3 to 9pm.";

// ---------- Business details (change them here) ----------
const phoneDisplay = "07309 449502";
const tel = "tel:+447309449502";
const instagram = "https://www.instagram.com/curlyskitchen1/";
const instagramDm = "https://ig.me/m/curlyskitchen1";
const maps = "https://share.google/6NVpR5qRHAozKfPLP"; // their Google Business link, from the Instagram bio
const fsa = "https://ratings.food.gov.uk/";
const address = ["First floor, Linnyshaw Mill", "260 Manchester Road", "Walkden, Worsley", "M28 3TR"];

// Opening hours. 0 = Sunday. Times are 24h, UK time. The live "Open now" badge reads this.
const hours = [
  { day: "Monday", d: 1, open: "17:00", close: "22:00" },
  { day: "Tuesday", d: 2, open: "17:00", close: "22:00" },
  { day: "Wednesday", d: 3, open: "17:00", close: "22:00" },
  { day: "Thursday", d: 4, open: "17:00", close: "22:00" },
  { day: "Friday", d: 5, open: "17:00", close: "22:00" },
  { day: "Saturday", d: 6, open: null, close: null },
  { day: "Sunday", d: 0, open: "15:00", close: "21:00" },
];
// Same hours grouped for the table.
const hourRows = [
  { label: "Monday to Friday", days: [1, 2, 3, 4, 5], open: "17:00", close: "22:00" },
  { label: "Saturday", days: [6], open: null, close: null },
  { label: "Sunday", days: [0], open: "15:00", close: "21:00" },
];
const fmt = (t: string | null) => {
  if (!t) return "";
  const [h, m] = t.split(":").map(Number);
  return `${h % 12 || 12}${m ? ":" + String(m).padStart(2, "0") : ""}${h < 12 ? "am" : "pm"}`;
};

// ---------- Drag-to-spin ring: real photos from their Instagram ----------
const spin = [
  { img: "steak-sliced", name: "Steak box", line: "Sliced steak, greens and the sauce." },
  { img: "boxes-two", name: "Loaded boxes", line: "Steak, crispy chicken, halloumi. Sauce on top." },
  { img: "crispy-chicken", name: "Crispy chicken & steak", line: "Half and half. Can't pick? Have both." },
  { img: "wraps", name: "Chicken wraps", line: "With curly fries and a pot of the sauce." },
  { img: "smash-burger", name: "Double smash burger", line: "Two patties, cheese, lettuce, the sauce." },
  { img: "mixed-box", name: "Steak, chicken & halloumi", line: "The full works in one box." },
  { img: "steak-asparagus", name: "Steak & asparagus", line: "Peppers, asparagus, sauce everywhere." },
  { img: "boxes-four", name: "Build your own", line: "Pick your meat, pick your sides." },
];

// ---------- Menu cards ----------
const menu = [
  { img: "steak-box", name: "Steak box", line: "Steak, curly fries and greens." },
  { img: "mixed-box", name: "Mixed grill box", line: "Steak, chicken and halloumi." },
  { img: "crispy-chicken", name: "Crispy chicken", line: "On its own or with steak." },
  { img: "wraps", name: "Wraps", line: "Steak or chicken, packed full." },
  { img: "smash-burger", name: "Smash burger", line: "Double patty, double cheese." },
  { img: "boxes-two", name: "Loaded box", line: "Everything, with the sauce." },
];

// ---------- Reviews (Google, word for word, trimmed) ----------
const reviews = [
  { q: "Food seasoned perfect and fresh when I collected it. Service was impeccable!", who: "Owen N." },
  { q: "The steak and chicken wraps were so good! Packed with meat and really tasty.", who: "Jenny H." },
  { q: "I actually licked the tray clean, then took the others out the bin and finished them.", who: "Charlie M." },
  { q: "The steak and fries are to die for and became a very dangerous Friday night meal!", who: "Thomas W." },
  { q: "Drove an hour, was not disappointed. If you haven't been, get yourself there!", who: "Jade S." },
  { q: "Amazing Biscoff shake, great service from the lads.", who: "Oliver W." },
  { q: "More than just a food place, it's a community.", who: "Jamosfooty_" },
  { q: "I hate spice and the boys always cater to it.", who: "Alex W." },
  { q: "Everything was cooked to perfection.", who: "Rachel A." },
  { q: "Food is bang on. Pre-orders available so you aren't waiting around.", who: "Jamie F." },
];
const rowA = reviews.slice(0, 5);
const rowB = reviews.slice(5);

// Tabler icons (MIT), outline.
const icon = {
  phone: '<path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"/>',
  pin: '<path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"/>',
  instagram: '<path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10"/><path d="M8.5 12a3.5 3.5 0 1 0 7 0a3.5 3.5 0 0 0 -7 0"/><path d="M17 7v.01"/>',
  message: '<path d="M8 9h8"/><path d="M8 13h6"/><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z"/>',
  arrow: '<path d="M5 12l14 0"/><path d="M13 18l6 -6"/><path d="M13 6l6 6"/>',
  left: '<path d="M15 6l-6 6l6 6"/>',
  right: '<path d="M9 6l6 6l-6 6"/>',
  star: '<path d="M8.243 7.34l-6.38 .925l-.113 .023a1 1 0 0 0 -.44 1.684l4.622 4.499l-1.09 6.355l-.013 .11a1 1 0 0 0 1.464 .944l5.706 -3l5.693 3l.1 .046a1 1 0 0 0 1.352 -1.1l-1.091 -6.355l4.624 -4.5l.078 -.085a1 1 0 0 0 -.633 -1.62l-6.38 -.926l-2.852 -5.78a1 1 0 0 0 -1.794 0l-2.853 5.78z"/>',
  bowl: '<path d="M4 11h16a1 1 0 0 1 1 1v.5c0 1.5 -2.517 5.573 -4 6.5v1a1 1 0 0 1 -1 1h-8a1 1 0 0 1 -1 -1v-1c-1.687 -1.054 -4 -5 -4 -6.5v-.5a1 1 0 0 1 1 -1z"/><path d="M12 4a2.4 2.4 0 0 0 -1 2a2.4 2.4 0 0 0 1 2"/><path d="M16 4a2.4 2.4 0 0 0 -1 2a2.4 2.4 0 0 0 1 2"/><path d="M8 4a2.4 2.4 0 0 0 -1 2a2.4 2.4 0 0 0 1 2"/>',
  chair: '<path d="M5 11a2 2 0 0 1 2 2v2h10v-2a2 2 0 1 1 4 0v4a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-4a2 2 0 0 1 2 -2z"/><path d="M5 11v-5a3 3 0 0 1 3 -3h8a3 3 0 0 1 3 3v5"/><path d="M6 19v2"/><path d="M18 19v2"/>',
  bag: '<path d="M6.331 8h11.339a2 2 0 0 1 1.977 2.304l-1.255 8.152a3 3 0 0 1 -2.966 2.544h-6.852a3 3 0 0 1 -2.965 -2.544l-1.255 -8.152a2 2 0 0 1 1.977 -2.304z"/><path d="M9 11v-5a3 3 0 0 1 6 0v5"/>',
  clock: '<path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M12 7v5l3 3"/>',
  hand: '<path d="M8 13v-7.5a1.5 1.5 0 0 1 3 0v6.5"/><path d="M11 5.5v-2a1.5 1.5 0 1 1 3 0v8.5"/><path d="M14 5.5a1.5 1.5 0 0 1 3 0v6.5"/><path d="M17 7.5a1.5 1.5 0 0 1 3 0v8.5a6 6 0 0 1 -6 6h-2h.208a6 6 0 0 1 -5.012 -2.7a69.74 69.74 0 0 1 -.196 -.3c-.312 -.479 -1.407 -2.388 -3.286 -5.728a1.5 1.5 0 0 1 .536 -2.022a1.867 1.867 0 0 1 2.28 .28l1.47 1.47"/>',
  globe: '<path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M3.6 9h16.8"/><path d="M3.6 15h16.8"/><path d="M11.5 3a17 17 0 0 0 0 18"/><path d="M12.5 3a17 17 0 0 1 0 18"/>',
  mail: '<path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/><path d="M3 7l9 6l9 -6"/>',
  whatsapp: '<path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"/><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"/>',
};

// CG Design & Co. credit strip (same links as the other client footers).
const cgLinks = [
  { label: "cgdesignaus.com", href: "https://cgdesignaus.com", external: true, icon: icon.globe },
  { label: "cgdesignaus@outlook.com", href: "mailto:cgdesignaus@outlook.com", external: false, icon: icon.mail },
  { label: "WhatsApp", href: "https://wa.me/447306100251", external: true, icon: icon.whatsapp },
  { label: "@cgdesignaus", href: "https://www.instagram.com/cgdesignaus", external: true, icon: icon.instagram },
];

const ext = { target: "_blank", rel: "noopener noreferrer" };
const svg = { viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true" } as const;

const dayCodes = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: "Curly's Kitchen",
  description,
  url: site,
  image: new URL("/media/og.jpg", site).href,
  logo: new URL("/media/logo.webp", site).href,
  telephone: "+447309449502",
  priceRange: "££",
  servesCuisine: ["Steak", "Grill", "Takeaway"],
  acceptsReservations: false,
  hasMenu: instagram,
  address: {
    "@type": "PostalAddress",
    streetAddress: "First floor, Linnyshaw Mill, 260 Manchester Road",
    addressLocality: "Walkden, Worsley",
    addressRegion: "Greater Manchester",
    postalCode: "M28 3TR",
    addressCountry: "GB",
  },
  openingHoursSpecification: hours
    .filter((h) => h.open)
    .map((h) => ({ "@type": "OpeningHoursSpecification", dayOfWeek: `https://schema.org/${h.day}`, opens: h.open, closes: h.close })),
  openingHours: hours.filter((h) => h.open).map((h) => `${dayCodes[h.d]} ${h.open}-${h.close}`),
  sameAs: [instagram],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <meta name="theme-color" content="#140d09" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Curly's Kitchen | Steak, chips & the sauce" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={new URL("/media/og.jpg", site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Hide animated elements only when JS runs; the failsafe shows them after 2.5s.
      document.documentElement.classList.add("js");
      setTimeout(function () { document.documentElement.classList.add("motion-ready"); }, 2500);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav" data-nav>
      <div class="wrap nav-inner">
        <a class="brand" href="#top" aria-label="Curly's Kitchen, back to top">
          <img src="/media/logo.webp" width="44" height="44" alt="" />
          <span class="brand-name">Curly's Kitchen</span>
        </a>
        <nav class="nav-links" aria-label="Sections">
          <a href="#menu">Menu</a>
          <a href="#reviews">Reviews</a>
          <a href="#visit">Find us</a>
        </nav>
        <div class="nav-end">
          <span class="status" data-status hidden><span class="status-dot"></span><span data-status-text></span></span>
          <a class="btn btn-sm nav-call" href={tel} data-magnetic>Call to order</a>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- Hero: orange, sticker headline, real food on a ring you can spin -->
      <section class="hero edge edge-ink" id="top" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="tag tag-cream" data-pop>Walkden, Worsley</p>
            <h1 id="hero-title" class="hero-title">
              <span class="stk stk-a" data-hero-line>Steak, chips</span>
              <span class="stk stk-b" data-hero-line>&amp; the sauce.</span>
            </h1>
            <p class="hero-sub" data-hero-fade>Steak, chicken and burger boxes, cooked to order. Big portions. Most meals £10 to £20.</p>
            <div class="hero-actions" data-hero-fade>
              <a class="btn btn-ink btn-lg" href={tel} data-magnetic>
                <svg {...svg} set:html={icon.phone} />
                Call to order
              </a>
              <a class="btn btn-line btn-lg" href="#menu">See the menu</a>
            </div>
            <ul class="proof" data-hero-fade>
              <li>
                <span class="stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24" fill="currentColor" set:html={icon.star} />)}</span>
                <span><strong>5.0</strong> from 42 Google reviews</span>
              </li>
              <li><span class="fhr-mini" aria-hidden="true">5</span><span>Food hygiene <strong>5</strong></span></li>
            </ul>
          </div>

          <div class="spin" data-spin>
            <div class="spin-stage">
              <canvas class="spin-canvas" data-spin-canvas aria-hidden="true"></canvas>
              <span class="spin-hint" data-hero-fade>
                <svg {...svg} set:html={icon.hand} />
                Drag to spin
              </span>
            </div>
            <div class="spin-foot" data-hero-fade>
              <button class="spin-btn" type="button" data-spin-prev aria-label="Previous dish"><svg {...svg} set:html={icon.left} /></button>
              <p class="spin-label" aria-live="polite">
                <span class="tag tag-ink spin-name" data-spin-name>{spin[0].name}</span>
                <span class="spin-line" data-spin-line>{spin[0].line}</span>
              </p>
              <button class="spin-btn" type="button" data-spin-next aria-label="Next dish"><svg {...svg} set:html={icon.right} /></button>
            </div>
            <!-- Without WebGL: the same photos as a swipeable row -->
            <ul class="spin-fallback">
              {spin.map((s) => (
                <li><img src={`/media/photo-${s.img}.webp`} alt={s.name} width="720" height="900" loading="lazy" decoding="async" /><span>{s.name}</span></li>
              ))}
            </ul>
          </div>
        </div>
        <p class="ribbon" data-hero-fade>
          <span class="ribbon-tag">News</span>
          New shop at Boothstown Precinct in the new year.
        </p>
      </section>

      <!-- Ways to eat -->
      <section class="ways dark" aria-label="Eat in, collect and opening hours">
        <div class="wrap ways-grid">
          <article class="way" data-way>
            <svg {...svg} set:html={icon.chair} />
            <h2>Eat in</h2>
            <p>Grab a seat. We're on the first floor of Linnyshaw Mill, Walkden.</p>
            <a class="btn btn-cream btn-sm" href={maps} {...ext}>Get directions</a>
          </article>
          <article class="way" data-way>
            <svg {...svg} set:html={icon.bag} />
            <h2>Collect</h2>
            <p>Ring ahead and it's ready when you get here. No waiting about.</p>
            <a class="btn btn-cream btn-sm" href={tel}>Call {phoneDisplay}</a>
          </article>
          <article class="way way-hours" data-way>
            <svg {...svg} set:html={icon.clock} />
            <h2>Opening hours</h2>
            <p>Mon to Fri 5 to 10pm. Sunday 3 to 9pm. Closed Saturday.</p>
            <span class="status status-dark" data-status hidden><span class="status-dot"></span><span data-status-text></span></span>
          </article>
        </div>
      </section>

      <!-- Menu -->
      <section class="menu edge edge-orange" id="menu" aria-labelledby="menu-title">
        <div class="wrap">
          <div class="menu-head">
            <h2 id="menu-title" class="display"><span class="stk stk-a" data-pop>What's in</span> <span class="stk stk-orange stk-b" data-pop>the box?</span></h2>
            <p class="lede" data-reveal>Pick your meat, pick your sides, and get it with the sauce. Everything's cooked when you order it.</p>
          </div>
          <ul class="cards">
            {menu.map((m, i) => (
              <li class="card" data-card>
                <div class="card-img">
                  <img src={`/media/photo-${m.img}.webp`} alt={m.name} width="720" height="900" loading="lazy" decoding="async" data-zoom />
                </div>
                <div class="card-copy">
                  <h3><span class={`stk stk-sm ${i % 2 ? "stk-b" : "stk-a"}`}>{m.name}</span></h3>
                  <p>{m.line}</p>
                </div>
              </li>
            ))}
          </ul>
          <p class="menu-note" data-reveal>
            Plus burritos, Biscoff shakes, vegan options and a kids' menu. Specials go up on <a href={instagram} {...ext}>Instagram</a> first.
          </p>
        </div>
      </section>

      <!-- The sauce -->
      <section class="sauce edge edge-ink" aria-label="What people say about the sauce">
        <div class="wrap sauce-inner">
          <p class="tag tag-ink" data-pop>The sauce</p>
          <blockquote>
            <p class="sauce-text" data-split>“10/10 food. The signature sauce is the best.”</p>
            <footer class="sauce-cite" data-reveal>Lorcan R., Google review</footer>
          </blockquote>
          <p class="sauce-reply" data-reveal>
            <img src="/media/logo.webp" width="44" height="44" alt="" loading="lazy" />
            <span><strong>Curly's replied:</strong> “We've put a lot of effort into mastering that sauce.”</span>
          </p>
        </div>
      </section>

      <!-- Reviews -->
      <section class="reviews dark" id="reviews" aria-labelledby="reviews-title">
        <div class="wrap reviews-head">
          <h2 id="reviews-title" class="display">
            <span class="stk stk-orange stk-a" data-pop><span data-score>5.0</span> on Google</span>
            <span class="stk stk-cream stk-b" data-pop>42 reviews. All five stars.</span>
          </h2>
        </div>
        <div class="belts" data-belts>
          {[rowA, rowB].map((row, r) => (
            <div class={`belt ${r ? "belt-rev" : ""}`}>
              <ul class="belt-track">
                {[...row, ...row].map((rv, i) => (
                  <li class="rv" aria-hidden={i >= row.length ? "true" : undefined}>
                    <span class="rv-stars" aria-label="5 stars">
                      {[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icon.star} />)}
                    </span>
                    <p>“{rv.q}”</p>
                    <span class="rv-who">{rv.who}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="wrap">
          <a class="text-link" href={maps} {...ext} data-reveal>
            Read them all on Google
            <svg {...svg} set:html={icon.arrow} />
          </a>
        </div>
      </section>

      <!-- Split panels: build a box / new shop -->
      <section class="split" aria-label="Build your box and our new shop">
        <article class="panel panel-photo" data-panel>
          <img src="/media/boxes-four-tall.webp" alt="Four Curly's boxes: steak, chicken, asparagus and crispy chicken, all with sauce" width="900" height="1200" loading="lazy" decoding="async" data-zoom />
          <div class="panel-copy">
            <h2 class="display"><span class="stk stk-a" data-pop>Build</span> <span class="stk stk-orange stk-b" data-pop>your box.</span></h2>
            <p class="panel-text" data-reveal>Big box or small box. Ring ahead and we'll have it ready.</p>
            <a class="btn btn-cream" href={tel} data-reveal data-magnetic>
              <svg {...svg} set:html={icon.phone} />
              Call to order
            </a>
          </div>
        </article>
        <article class="panel panel-photo" data-panel>
          <img src="/media/new-shop.webp" alt="How the new Curly's Kitchen shop will look, lit up in orange at night" width="900" height="1200" loading="lazy" decoding="async" data-zoom />
          <div class="panel-copy">
            <p class="tag tag-orange" data-pop>Coming 2027</p>
            <h2 class="display"><span class="stk stk-a" data-pop>New shop.</span> <span class="stk stk-cream stk-b" data-pop>Boothstown Precinct.</span></h2>
            <p class="panel-text" data-reveal>Bigger and better in the new year. Until Christmas, we're at Linnyshaw Mill as usual.</p>
            <a class="btn btn-cream" href={instagram} {...ext} data-reveal>
              <svg {...svg} set:html={icon.instagram} />
              Follow the build
            </a>
          </div>
          <p class="panel-note">How the new shop will look</p>
        </article>
      </section>

      <!-- Visit -->
      <section class="visit edge edge-orange" id="visit" aria-labelledby="visit-title">
        <div class="wrap visit-grid">
          <div class="visit-copy">
            <h2 id="visit-title" class="display"><span class="stk stk-a" data-pop>Come</span> <span class="stk stk-orange stk-b" data-pop>hungry.</span></h2>
            <address class="addr" data-reveal>{address.map((l) => <span>{l}</span>)}</address>
            <div class="visit-actions" data-reveal>
              <a class="btn btn-ink" href={tel} data-magnetic>
                <svg {...svg} set:html={icon.phone} />
                Call {phoneDisplay}
              </a>
              <a class="btn btn-line" href={maps} {...ext}>
                <svg {...svg} set:html={icon.pin} />
                Directions
              </a>
            </div>
            <ul class="extras" data-reveal>
              {["Pre-orders welcome", "Vegan options", "Kids' menu", "Dogs welcome outside"].map((e) => <li>{e}</li>)}
            </ul>
          </div>
          <div class="visit-side">
            <div class="hours" data-reveal>
              <div class="hours-head">
                <h3>Opening hours</h3>
                <span class="status" data-status hidden><span class="status-dot"></span><span data-status-text></span></span>
              </div>
              <table>
                <tbody>
                  {hourRows.map((h) => (
                    <tr data-days={h.days.join(",")}>
                      <th scope="row">{h.label}</th>
                      <td>{h.open ? `${fmt(h.open)} to ${fmt(h.close)}` : "Closed"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <a class="fhr" href={fsa} {...ext} data-reveal aria-label="Food hygiene rating 5, very good. Inspected 17 March 2026. Check on the Food Standards Agency website.">
              <span class="fhr-score" aria-hidden="true"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><b>5</b></span>
              <span class="fhr-copy"><strong>Food hygiene rating 5</strong><span>Very good. Inspected 17 March 2026.</span></span>
            </a>
          </div>
        </div>
      </section>

      <!-- Close -->
      <section class="close" aria-labelledby="close-title">
        <div class="wrap close-inner">
          <h2 id="close-title" class="display"><span class="stk stk-a" data-pop>Hungry?</span> <span class="stk stk-cream stk-b" data-pop>Give us a ring.</span></h2>
          <div class="close-actions" data-reveal>
            <a class="btn btn-ink btn-lg" href={tel} data-magnetic>
              <svg {...svg} set:html={icon.phone} />
              {phoneDisplay}
            </a>
            <a class="btn btn-line btn-lg" href={instagramDm} {...ext}>
              <svg {...svg} set:html={icon.message} />
              Message on Instagram
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot dark">
      <div class="wrap">
        <p class="foot-word" aria-hidden="true" data-foot-word>Curly's Kitchen</p>
        <div class="foot-grid">
          <ul class="foot-links">
            <li><a href={tel}><svg {...svg} set:html={icon.phone} /><span><strong>Call</strong> {phoneDisplay}</span></a></li>
            <li><a href={instagram} {...ext}><svg {...svg} set:html={icon.instagram} /><span><strong>Instagram</strong> @curlyskitchen1</span></a></li>
            <li><a href={maps} {...ext}><svg {...svg} set:html={icon.pin} /><span><strong>Find us</strong> 260 Manchester Road, M28 3TR</span></a></li>
          </ul>
          <p class="foot-small">&copy; {new Date().getFullYear()} Curly's Kitchen. Mon to Fri 5 to 10pm, Sun 3 to 9pm.</p>
        </div>
      </div>
    </footer>

    <aside class="cg-credit" aria-label="Website credit">
      <div class="wrap">
        <div class="cg-credit-lead">
          <img src="/media/cgd-logo.webp" alt="CG Design" width="62" height="24" />
          <span>Want a website like this? Reach out to CG Design.</span>
        </div>
        <div class="cg-credit-links">
          {cgLinks.map((l) => (
            <a href={l.href} {...(l.external && ext)}>
              <svg {...svg} set:html={l.icon} />
              {l.label}
            </a>
          ))}
        </div>
      </div>
    </aside>

    <!-- Phones: app-style tab bar, always on screen -->
    <nav class="tabbar" aria-label="Quick links">
      <a href="#menu" data-tab="menu"><svg {...svg} set:html={icon.bowl} />Menu</a>
      <a href="#reviews" data-tab="reviews"><svg {...svg} set:html={icon.star} />Reviews</a>
      <a class="tab-main" href={tel} aria-label={`Call to order, ${phoneDisplay}`}>
        <span class="tab-main-dot"><svg {...svg} set:html={icon.phone} /></span>
        Order
      </a>
      <a href="#visit" data-tab="visit"><svg {...svg} set:html={icon.pin} />Find us</a>
      <a href={instagram} {...ext}><svg {...svg} set:html={icon.instagram} />Instagram</a>
    </nav>

    <script type="application/json" id="hours-data" set:html={JSON.stringify(hours)} />
    <script type="application/json" id="spin-data" set:html={JSON.stringify(spin.map((s) => ({ ...s, src: `/media/spin-${s.img}.webp` })))} />
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
