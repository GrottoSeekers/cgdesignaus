---
// GitHub Pages serves this (built as 404.html) for any address that doesn't exist.
import HomeLayout from "../layouts/HomeLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const links = [
  { href: `${base}/work/`, label: "Our work", text: "Websites we've designed and launched" },
  { href: `${base}/pricing/`, label: "Pricing", text: "Fixed-price website packages" },
  { href: `${base}/quick-jobs/`, label: "Quick jobs", text: "Google profile, socials and booking setup" },
  { href: `${base}/how-it-works/`, label: "How it works & FAQ", text: "From first chat to live site" },
];
---

<HomeLayout
  title="Page not found | CG Design & Co."
  description="Sorry, we couldn't find that page. Find our work, pricing and contact details here."
  noindex
>
  <Header />
  <main id="main">
    <section style="padding: 112px 0 104px; background: #f3f0f8">
      <div class="wrap" style="max-width: 760px">
        <span class="eyebrow">Error 404</span>
        <h1 style="font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; margin: 16px 0 18px">
          We can't find <em style="font-style: italic; font-weight: 600; color: #5b2a96">that page.</em>
        </h1>
        <p style="color: rgba(20,17,26,0.68); font-size: 1.02rem; margin: 0 0 32px">
          It may have moved, or the link may have a typo. Try one of these instead.
        </p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 40px">
          <a href={`${base}/`} class="btn btn-primary">Go to the homepage</a>
          <a href={`${base}/contact/`} class="btn btn-ghost">Get your free business check</a>
        </div>
        <ul style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 12px">
          {links.map((l) => (
            <li>
              <a href={l.href} style="display: flex; flex-direction: column; gap: 2px; padding: 18px 20px; border-radius: 20px; background: #ffffff; border: 1px solid rgba(20,17,26,0.08); text-decoration: none; color: #14111a">
                <strong style="font-size: 1rem">{l.label} →</strong>
                <span style="font-size: 0.88rem; color: rgba(20,17,26,0.66)">{l.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
  <CookieConsent />
</HomeLayout>
