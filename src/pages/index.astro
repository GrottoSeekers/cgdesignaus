---
import HomeLayout from "../layouts/HomeLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Client from "../components/Client.astro";
import Compare from "../components/Compare.astro";
import Explore from "../components/Explore.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { GOOGLE_PROFILE_URL } from "../lib/business";

const businessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService", "WebDesignCompany"],
  name: "CG Design & Co.",
  alternateName: "CGD",
  description:
    "CG Design & Co. designs and builds fast, mobile-friendly websites for local businesses across Australia, with fixed pricing and a clear delivery timeline.",
  url: "https://cgdesignaus.com",
  logo: "https://cgdesignaus.com/logo-full.png",
  image: "https://cgdesignaus.com/logo-full.png",
  email: "info@cgdesignaus.com",
  sameAs: [GOOGLE_PROFILE_URL],
  hasMap: GOOGLE_PROFILE_URL,
  taxID: "25 672 082 550",
  address: {
    "@type": "PostalAddress",
    streetAddress: "St Luke Street",
    addressLocality: "Randwick",
    addressRegion: "NSW",
    postalCode: "2031",
    addressCountry: "AU",
  },
  areaServed: {
    "@type": "Country",
    name: "Australia",
  },
  contactPoint: {
    "@type": "ContactPoint",
    email: "info@cgdesignaus.com",
    contactType: "customer service",
    areaServed: "AU",
  },
  priceRange: "$500-$3000",
  currenciesAccepted: "AUD",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website design services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "New Website Builds",
          description: "Custom-built websites designed to generate local leads.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Website Redesigns",
          description: "Modernising an existing website on its current domain.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Local SEO",
          description: "Google Business optimisation and local keyword targeting so local customers can find the business.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Online Booking Systems",
          description: "Real-time appointment, table, or callout booking setup.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Online Store Setup",
          description: "Product catalogue and checkout for e-commerce.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Logo & Brand Identity",
          description: "Logo design, colour palette, fonts and a one-page brand guide for small businesses.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Business Setup Quick Jobs",
          description: "Fixed-price setup of Google Business Profiles, social media, business email, online bookings and review links.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Website Maintenance & Hosting",
          description: "Ongoing updates, security, and small content changes.",
        },
      },
    ],
  },
};
---

<HomeLayout
  title="CG Design & Co. | Websites & Branding for Local Businesses"
  description="CG Design & Co. designs fast, mobile-friendly websites, logos and branding for local businesses across Australia, with fixed pricing and a clear delivery timeline."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  </Fragment>
  <Header />
  <main id="main">
    <Hero />
    <Client />
    <Compare />
    <Explore />
    <CtaBand />
  </main>
  <Footer />
  <CookieConsent />
  <script is:inline>
    // Sections that used to live on this page now have their own pages: forward old links
    // (ads, bookmarks, the Google profile) such as /#pricing to the right one.
    (function () {
      var moved = {
        "#before-after": "/work#before-after",
        "#pricing": "/pricing",
        "#process": "/how-it-works",
        "#faq": "/how-it-works#faq",
        "#contact": "/contact",
      };
      var to = moved[location.hash];
      if (to) location.replace(to);
    })();
  </script>
</HomeLayout>
