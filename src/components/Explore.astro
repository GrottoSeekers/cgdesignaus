---
// Homepage signposts: one card per page, so visitors go deeper as their interest grows
// instead of scrolling one long page.
import { aud, lowestPackagePrice, lowestQuickJobPrice } from "../lib/pricing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const cards = [
  {
    href: `${base}/work#before-after`,
    kicker: "Before & after",
    title: "See a real redesign",
    text: "Drag the slider on a client's old site and the one we built.",
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M12 4v16M8 10l-2 2 2 2M16 10l2 2-2 2"></path>',
  },
  {
    href: `${base}/pricing`,
    kicker: `From ${aud(lowestPackagePrice)}`,
    title: "Website packages",
    text: "Three fixed-price packages, or build your own quote in seconds.",
    icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5M9 14l2 2 4-4"></path>',
  },
  {
    href: `${base}/quick-jobs`,
    kicker: `From ${aud(lowestQuickJobPrice)}`,
    title: "Quick jobs",
    text: "Google profile, social media, business email and more, done for you.",
    icon: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"></path>',
  },
  {
    href: `${base}/how-it-works`,
    kicker: "Under a week",
    title: "How it works",
    text: "One designer, a fixed price and a launch date, plus your questions answered.",
    icon: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>',
  },
];
---

<section id="explore" style="position: relative; padding: 104px 0 96px; background: #f3f0f8; border-top: 1px solid rgba(20,17,26,0.1); border-bottom: 1px solid rgba(20,17,26,0.1)">
<div class="wrap">
<div style="max-width: 640px; margin-bottom: 40px">
<span class="eyebrow">Take a look around</span>
<h2 style="font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; margin-top: 16px">Find what you need, <em style="font-style: italic; font-weight: 600; color: #5b2a96">at your own pace.</em></h2>
</div>
<div class="explore-grid">
{cards.map((c) => (
<a href={c.href} class="explore-card">
<span class="explore-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} /></span>
<span class="explore-kicker">{c.kicker}</span>
<span class="explore-title">{c.title}</span>
<span class="explore-text">{c.text}</span>
<span class="explore-go" aria-hidden="true">→</span>
</a>
))}
</div>
</div>
</section>

<style>
  .explore-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: 20px;
  }

  .explore-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 28px 28px 64px;
    border-radius: 22px;
    background: #ffffff;
    border: 1px solid rgba(20, 17, 26, 0.08);
    color: #14111a;
    text-decoration: none;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s, border-color 0.35s;
  }

  @media (hover: hover) {
    .explore-card:hover {
      transform: translateY(-6px);
      border-color: rgba(91, 42, 150, 0.3);
      box-shadow: 0 30px 56px -34px rgba(47, 17, 71, 0.45);
      color: #14111a;
    }

    .explore-card:hover .explore-icon {
      background: #2f1147;
      color: #ffffff;
    }

    .explore-card:hover .explore-go {
      transform: translateX(5px);
    }
  }

  .explore-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-bottom: 12px;
    border-radius: 14px;
    background: rgba(91, 42, 150, 0.1);
    color: #5b2a96;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .explore-kicker {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5b2695;
  }

  .explore-title {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .explore-text {
    font-size: 0.94rem;
    color: rgba(20, 17, 26, 0.68);
  }

  .explore-go {
    position: absolute;
    left: 28px;
    bottom: 24px;
    font-size: 1.2rem;
    font-weight: 700;
    color: #5b2a96;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Phones: compact rows (icon, words, arrow) so the four cards don't add a screen of scrolling. */
  @media (max-width: 560px) {
    .explore-grid {
      gap: 12px;
    }

    .explore-card {
      display: grid;
      grid-template-columns: 44px 1fr 20px;
      column-gap: 14px;
      row-gap: 2px;
      align-items: center;
      padding: 18px;
    }

    .explore-icon {
      grid-row: 1 / span 3;
      width: 44px;
      height: 44px;
      margin: 0;
    }

    .explore-kicker,
    .explore-title,
    .explore-text {
      grid-column: 2;
    }

    .explore-title {
      font-size: 1.2rem;
    }

    .explore-text {
      font-size: 0.88rem;
    }

    .explore-go {
      position: static;
      grid-column: 3;
      grid-row: 1 / span 3;
    }
  }
</style>
