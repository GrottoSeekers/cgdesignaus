---
// The speed lines from the J.Pickles Coaching hero, laid over a screenshot of his site so
// the mockup moves like the real thing (the live site draws them with Three.js; this is a
// light CSS version with the same look: bone and gold streaks, bright head, fading tail,
// clustered through the middle of the hero, nearer lines longer, thicker and faster).
//
// The screenshot was taken with the lines switched off. His photo is cropped out and laid
// back on top, so the lines pass behind it just as they do on his site.
//
// `area`: where the hero sits on the screenshot, `photo`: where the photo sits, both as
// percentages of the screenshot. `delay` holds the fade-in until the mockup has tilted in.
// Styles (streak keyframes) live in src/styles/home.css.
interface Box { left: number; top: number; width: number; height: number }
interface Props {
  area: Box;
  photo: Box & { src: string; w: number; h: number };
  /** Hero width in CSS px on the captured page, to turn line lengths and speeds into percentages. */
  heroWidth: number;
  count: number;
  seed: number;
  delay?: number;
}

const { area, photo, heroWidth, count, seed, delay = 0 } = Astro.props;

// Small seeded random, so every build draws the same lines.
let s = seed >>> 0;
const rand = () => {
  s = (s + 0x6d2b79f5) >>> 0;
  let t = s;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const round = (n: number, p = 2) => Math.round(n * 10 ** p) / 10 ** p;
const lines = Array.from({ length: count }, () => {
  const depth = rand() ** 1.6;
  const y = 0.5 + (rand() + rand() + rand() - 1.5) * 0.42;
  const lenPx = 120 + depth * 520 + rand() * 180;
  const speed = 60 + depth * 520; // px a second, as on his site
  const dur = (heroWidth + lenPx) / speed;
  return {
    top: round(Math.min(0.97, Math.max(0.03, y)) * 100),
    len: round((lenPx / heroWidth) * 100),
    dur: round(dur),
    lag: round(-rand() * dur), // start part-way through, so the hero is full from the first frame
    alpha: round(0.12 + depth * 0.5),
    thick: round(0.5 + depth * 1.2),
    gold: rand() < 0.22,
  };
});

const pct = (b: Box) => `left: ${b.left}%; top: ${b.top}%; width: ${b.width}%; height: ${b.height}%`;
---

<div class="jp-lines" aria-hidden="true" style={`${pct(area)}; animation-delay: ${delay}s`}>
  {lines.map((l) => (
    <span
      class:list={["jp-line", { gold: l.gold }]}
      style={`--l: ${l.len}%; top: ${l.top}%; height: ${l.thick}px; opacity: ${l.alpha}; animation-duration: ${l.dur}s; animation-delay: ${l.lag}s`}
    ><i style={`width: ${l.len}%`}></i></span>
  ))}
</div>
<img class="jp-photo" src={photo.src} width={photo.w} height={photo.h} alt="" decoding="async" style={pct(photo)} />
