---
// Prices come from one place: the quote builder's base price and options.
// Each package's RRP is the sum of what it includes; the founding price halves it.
const BASE_PRICE = 500;
const FOUNDING_DISCOUNT_RATE = 0.5;

const pageOptions = [
  { id: "about", label: "About", price: 90 },
  { id: "services", label: "Services / Menu", price: 140 },
  { id: "gallery", label: "Gallery", price: 110 },
  { id: "blog", label: "Blog", price: 200 },
  { id: "booking-page", label: "Booking page", price: 130 },
];

const featureOptions = [
  { id: "seo", label: "Local SEO", desc: "Google Business optimisation and local keyword targeting", price: 280, recurring: false },
  { id: "booking", label: "Online bookings", desc: "Real-time appointment, table, or callout booking", price: 400, recurring: false },
  { id: "store", label: "Online store", desc: "Product catalogue and checkout", price: 800, recurring: false },
  { id: "maintenance", label: "Maintenance", desc: "Hosting, security updates, and small content changes", price: 60, recurring: true },
];

const priceById: Record<string, number> = Object.fromEntries(
  [...pageOptions, ...featureOptions].map((o) => [o.id, o.price])
);

const aud = (n: number) => `$${Math.round(n).toLocaleString("en-AU")}`;
const founding = (n: number) => Math.round(n * FOUNDING_DISCOUNT_RATE);

const tier1Full = BASE_PRICE;
const tier2Full = tier1Full + priceById.about + priceById.services + priceById.gallery;
const tier3Full = tier2Full + priceById.booking + priceById.seo + priceById["booking-page"];

const tiers = [
  {
    id: "essentials",
    name: "Essentials",
    tagline: "A sharp one-pager that gets you found and called.",
    full: tier1Full,
    includes: ["Home + Contact pages", "Copywriting and images sourced", "Mobile-first build", "Live in under a week"],
    feature: false,
  },
  {
    id: "growth",
    name: "Growth",
    tagline: "The full shopfront — services, story and gallery.",
    full: tier2Full,
    includes: ["Everything in Essentials", "About, Services / Menu, Gallery", "Enquiry form to your inbox", "Google Business profile tidy-up"],
    feature: true,
  },
  {
    id: "complete",
    name: "Complete",
    tagline: "Bookings and local search, done properly.",
    full: tier3Full,
    includes: ["Everything in Growth", "Online booking system", "Local SEO package", "Dedicated booking page"],
    feature: false,
  },
];

const maintenance = priceById.maintenance;
const chip = (o: { label: string; price: number; recurring?: boolean }) => `+${aud(o.price)}${o.recurring ? "/mo" : ""}`;
---

<section id="pricing" style="position: relative; overflow: hidden; padding: 112px 0 104px; background: #f3f0f8; border-top: 1px solid rgba(20,17,26,0.1); border-bottom: 1px solid rgba(20,17,26,0.1)">
<div class="wrap" style="position: relative">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; margin-bottom: 40px">
<div style="max-width: 640px">
<span class="eyebrow">Pricing</span>
<h2 style="font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; margin-top: 16px">Three packages. <em style="font-style: italic; font-weight: 600; color: #5b2a96">One fixed price.</em></h2>
</div>
<p style="max-width: 380px; color: rgba(20,17,26,0.68); font-size: 1rem">The price you see is the price you pay.</p>
</div>

<div class="founding" style="position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; padding: 22px 28px; border-radius: 20px; background: #2f1147; color: #f3eefa; margin-bottom: 28px">
<span style="font-family: 'Fraunces', serif; font-size: 2.4rem; font-weight: 600; line-height: 1; color: #ffffff; letter-spacing: -0.02em">{Math.round(FOUNDING_DISCOUNT_RATE * 100)}% off</span>
<div style="display: flex; flex-direction: column; gap: 2px; flex: 1 1 360px">
<span style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #d8bff0"><span class="live-dot" style="width: 8px; height: 8px; border-radius: 50%; background: #7cd68c"></span>Founding client offer</span>
<p style="font-size: 0.96rem; color: #f3eefa">Every package, for the first businesses we work with — plus priority turnaround and a real say in how it turns out.</p>
</div>
</div>

<div class="tiers" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(272px, 100%), 1fr)); gap: 24px; align-items: stretch">
{tiers.map((t) => t.feature ? (
<div class="tier tier-feature sel" data-tier={t.id} style="position: relative; border-radius: 24px; padding: 2px">
<div style="position: relative; z-index: 1; height: 100%; box-sizing: border-box; background: #2f1147; border-radius: 22px; padding: 32px; display: flex; flex-direction: column; gap: 22px; color: #f3eefa">
<div><span style="display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #d8bff0; margin-bottom: 8px">Recommended</span><h3 style="font-size: 1.35rem; margin-bottom: 6px; color: #ffffff">{t.name}</h3><p style="font-size: 0.9rem; color: rgba(243,238,250,0.78)">{t.tagline}</p></div>
<div style="display: flex; align-items: baseline; gap: 12px"><span class="sr">{aud(founding(t.full))}</span><span class="price-count" aria-hidden="true" data-to={founding(t.full)} data-from={t.full} style="font-family: 'Fraunces', serif; font-size: 3.2rem; font-weight: 600; line-height: 1; letter-spacing: -0.02em; color: #ffffff">{aud(founding(t.full))}</span><span class="rrp" style="font-size: 1.05rem; color: rgba(243,238,250,0.55)">{aud(t.full)}</span></div>
<ul class="ticks" style="list-style: none; margin: 0; padding: 22px 0 0; border-top: 1px solid rgba(243,238,250,0.18); display: flex; flex-direction: column; gap: 12px; font-size: 0.92rem; color: rgba(243,238,250,0.9); flex: 1">
{t.includes.map((line) => <li><span class="tick tick-dark" aria-hidden="true">✓</span>{line}</li>)}
</ul>
<a href="#contact" class="btn btn-violet">Start with {t.name}</a>
</div>
<button type="button" class="tier-pick sr-only" data-tier-pick={t.id} aria-pressed="true" aria-controls="tier-detail">Show what's in {t.name}</button>
</div>
) : (
<div class="tier" data-tier={t.id} style="background: #ffffff; border: 1px solid rgba(20,17,26,0.1); border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 22px">
<div><h3 style="font-size: 1.35rem; margin-bottom: 6px">{t.name}</h3><p style="font-size: 0.9rem; color: rgba(20,17,26,0.68)">{t.tagline}</p></div>
<div style="display: flex; align-items: baseline; gap: 12px"><span class="sr">{aud(founding(t.full))}</span><span class="price-count" aria-hidden="true" data-to={founding(t.full)} data-from={t.full} style="font-family: 'Fraunces', serif; font-size: 3.2rem; font-weight: 600; line-height: 1; letter-spacing: -0.02em">{aud(founding(t.full))}</span><span class="rrp" style="font-size: 1.05rem; color: rgba(20,17,26,0.45)">{aud(t.full)}</span></div>
<ul class="ticks" style="list-style: none; margin: 0; padding: 22px 0 0; border-top: 1px solid rgba(20,17,26,0.1); display: flex; flex-direction: column; gap: 12px; font-size: 0.92rem; color: rgba(20,17,26,0.78); flex: 1">
{t.includes.map((line) => <li><span class="tick" aria-hidden="true">✓</span>{line}</li>)}
</ul>
<a href="#contact" class="btn btn-ghost">Start with {t.name}</a>
<button type="button" class="tier-pick sr-only" data-tier-pick={t.id} aria-pressed="false" aria-controls="tier-detail">Show what's in {t.name}</button>
</div>
))}
</div>
<div class="tier-detail" id="tier-detail" aria-live="polite">
{tiers.map((t) => (
<div class:list={["tier-panel", { show: t.feature }]} data-panel={t.id}>
<p class="tier-panel-tag"><strong>{t.name}:</strong> {t.tagline}</p>
<ul class="tier-panel-list">{t.includes.map((line) => <li><span class="tick" aria-hidden="true">✓</span>{line}</li>)}</ul>
<a href="#contact" class="btn btn-primary">Start with {t.name}</a>
</div>
))}
</div>
<p style="font-size: 0.86rem; color: rgba(20,17,26,0.6); margin-top: 22px; text-align: center">Hosting and maintenance optional at {aud(maintenance)}/month. Domains registered at cost.</p>

<div class="quote" id="quote" data-base-price={BASE_PRICE} data-founding-rate={FOUNDING_DISCOUNT_RATE} style="margin-top: 28px; border-radius: 22px; border: 1px solid rgba(20,17,26,0.12); background: #ffffff; overflow: hidden">
<button type="button" class="quote-toggle" id="quote-toggle" aria-expanded="false" aria-controls="quote-body" style="display: flex; align-items: center; gap: 16px; width: 100%; padding: 20px 24px; border: 0; background: transparent; text-align: left; font-family: inherit; color: #14111a; cursor: pointer">
<span class="quote-chev" style="width: 40px; height: 40px; border-radius: 50%; background: rgba(47,17,71,0.1); color: #2f1147; display: flex; align-items: center; justify-content: center; flex-shrink: 0"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span>
<span style="display: flex; flex-direction: column; flex: 1"><span style="font-weight: 700; font-size: 1.05rem">Or build your own quote</span><span style="font-size: 0.86rem; color: rgba(20,17,26,0.6)">Pick pages and extras, and watch the price update</span></span>
<span style="font-family: 'Fraunces', serif; font-size: 1.5rem; font-weight: 600; color: #2f1147"><span data-quote-total>{aud(founding(BASE_PRICE))}</span></span>
</button>
<div class="quote-body" id="quote-body">
<div style="overflow: hidden">
<div class="quote-inner" style="display: flex; flex-wrap: wrap; gap: 32px; padding: 4px 24px 26px; border-top: 1px solid rgba(20,17,26,0.08)">
<div style="flex: 1 1 520px; display: flex; flex-direction: column; gap: 22px; padding-top: 22px">
<div>
<p style="font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(20,17,26,0.6); margin-bottom: 10px">Pages <span style="text-transform: none; letter-spacing: 0; font-weight: 600">· Home &amp; Contact included</span></p>
<div style="display: flex; flex-wrap: wrap; gap: 8px">
{pageOptions.map((o) => <button type="button" class="chip" aria-pressed="false" data-kind="page" data-label={o.label} data-price={o.price}>{o.label} <span style="opacity: 0.7">{chip(o)}</span></button>)}
</div>
</div>
<div>
<p style="font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(20,17,26,0.6); margin-bottom: 10px">Extras</p>
<div style="display: flex; flex-wrap: wrap; gap: 8px">
{featureOptions.map((o) => <button type="button" class="chip" aria-pressed="false" data-kind="extra" data-label={o.label} data-price={o.price} data-recurring={o.recurring ? "1" : undefined} title={o.desc}>{o.label} <span style="opacity: 0.7">{chip(o)}</span></button>)}
</div>
</div>
</div>
<div style="flex: 1 1 260px; display: flex; flex-direction: column; gap: 6px; padding: 22px; margin-top: 22px; border-radius: 18px; background: #2f1147; color: #f3eefa">
<span style="font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #d8bff0">Your estimate</span>
<span style="display: flex; align-items: baseline; gap: 10px"><span style="font-family: 'Fraunces', serif; font-size: 2.6rem; font-weight: 600; line-height: 1.05; color: #ffffff"><span data-quote-total aria-live="polite">{aud(founding(BASE_PRICE))}</span></span><span style="font-size: 1rem; text-decoration: line-through; color: rgba(243,238,250,0.5)"><span data-quote-rrp>{aud(BASE_PRICE)}</span></span></span>
<span style="font-size: 0.86rem; color: rgba(243,238,250,0.72)"><span data-quote-monthly>One-off, no lock-in</span></span>
<a href="#contact" class="btn btn-violet" id="quote-send" style="margin-top: 14px">Send me this quote</a>
<span style="font-size: 0.78rem; color: rgba(243,238,250,0.6); text-align: center">No payment, no obligation.</span>
</div>
</div>
</div>
</div>
</div>
</div>
</section>

<style>
  /* The tap-to-select button only exists for keyboard/screen-reader users on phones. */
  .tier-pick {
    display: none;
  }

  @media (max-width: 640px) {
    .tier-pick {
      display: block;
    }
    .tier:has(.tier-pick:focus-visible) {
      outline: 2px solid #2f1147;
      outline-offset: 3px;
    }
  }
</style>

<script>
  import { animate, inView } from "motion";

  const aud = (n: number) => `$${Math.round(n).toLocaleString("en-AU")}`;

  // ---- Prices count down from the full price to the founding price, then the
  // old price gets struck through and the ticks pop in one by one. ----
  const tiersEl = document.querySelector<HTMLElement>(".tiers");
  const counts = Array.from(document.querySelectorAll<HTMLElement>(".price-count")).map((el) => ({
    el,
    from: Number(el.dataset.from),
    to: Number(el.dataset.to),
  }));
  const tickLists = Array.from(document.querySelectorAll<HTMLElement>(".tiers .ticks"));
  const onScreen = (el: Element) => {
    const r = el.getBoundingClientRect();
    return r.top < window.innerHeight * 0.92 && r.bottom > 0;
  };

  if (tiersEl && !onScreen(tiersEl)) {
    tiersEl.classList.add("pre");
    tickLists.forEach((t) => t.classList.add("pre"));
    counts.forEach((c) => (c.el.textContent = aud(c.from)));

    inView(
      tiersEl,
      () => {
        animate(0, 1, {
          duration: 1.4,
          ease: [0.33, 1, 0.68, 1],
          onUpdate: (k) => counts.forEach((c) => (c.el.textContent = aud(c.from - (c.from - c.to) * k))),
          onComplete: () => counts.forEach((c) => (c.el.textContent = aud(c.to))),
        });
        tiersEl.classList.add("go");
        tickLists.forEach((t) => {
          t.querySelectorAll<HTMLElement>(".tick").forEach((tick, j) => {
            tick.style.transitionDelay = `${0.5 + j * 0.12}s`;
          });
          t.classList.add("go");
        });
      },
      { margin: "0px 0px -20% 0px" }
    );
  }

  // ---- Phones: tap a package block to see what's in it ----
  const tierEls = Array.from(document.querySelectorAll<HTMLElement>(".tier[data-tier]"));
  const selectTier = (id: string) => {
    tierEls.forEach((t) => t.classList.toggle("sel", t.dataset.tier === id));
    document.querySelectorAll<HTMLButtonElement>("[data-tier-pick]").forEach((b) => {
      b.setAttribute("aria-pressed", String(b.dataset.tierPick === id));
    });
    document.querySelectorAll<HTMLElement>(".tier-panel").forEach((p) => p.classList.toggle("show", p.dataset.panel === id));
  };
  tierEls.forEach((t) =>
    t.addEventListener("click", (e) => {
      // On larger screens the cards' own "Start with …" links just go to the form.
      if ((e.target as Element).closest("a")) return;
      selectTier(t.dataset.tier ?? "");
    })
  );

  // ---- Quote builder ----
  const quote = document.getElementById("quote");
  const toggle = document.getElementById("quote-toggle");
  const body = document.getElementById("quote-body");
  const BASE_PRICE = Number(quote?.dataset.basePrice ?? 500);
  const FOUNDING_RATE = Number(quote?.dataset.foundingRate ?? 0.5);
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".quote .chip"));

  toggle?.addEventListener("click", () => {
    const open = !body?.classList.contains("open");
    body?.classList.toggle("open", open);
    toggle.querySelector(".quote-chev")?.classList.toggle("open", open);
    toggle.setAttribute("aria-expanded", String(open));
  });

  function calculate() {
    const picked = chips.filter((c) => c.classList.contains("on"));
    let full = BASE_PRICE;
    let monthly = 0;
    picked.forEach((c) => {
      const price = Number(c.dataset.price);
      if (c.hasAttribute("data-recurring")) monthly += price;
      else full += price;
    });
    return { picked, full, oneOff: full * FOUNDING_RATE, monthly };
  }

  function updateQuote() {
    const { full, oneOff, monthly } = calculate();
    document.querySelectorAll("[data-quote-total]").forEach((el) => (el.textContent = aud(oneOff)));
    document.querySelectorAll("[data-quote-rrp]").forEach((el) => (el.textContent = aud(full)));
    document.querySelectorAll("[data-quote-monthly]").forEach((el) => {
      el.textContent = monthly ? `One-off, plus ${aud(monthly)}/month maintenance` : "One-off, no lock-in";
    });
  }

  chips.forEach((c) =>
    c.addEventListener("click", () => {
      const on = !c.classList.contains("on");
      c.classList.toggle("on", on);
      c.setAttribute("aria-pressed", String(on));
      updateQuote();
    })
  );

  // "Send me this quote": pass the estimate to the contact form (the link itself glides to it).
  document.getElementById("quote-send")?.addEventListener("click", () => {
    const { picked, oneOff, monthly } = calculate();
    const pages = picked.filter((c) => c.dataset.kind === "page").map((c) => c.dataset.label);
    const extras = picked.filter((c) => c.dataset.kind === "extra").map((c) => c.dataset.label);
    const summary = [
      "Website build",
      pages.length ? `+ ${pages.join(", ")}` : "",
      extras.length ? `with ${extras.join(", ")}` : "",
    ].filter(Boolean);
    const price = `$${Math.round(oneOff)}${monthly ? ` + $${monthly}/mo` : ""}`;

    const estimateInput = document.getElementById("estimate_details") as HTMLInputElement | null;
    if (estimateInput) estimateInput.value = `${summary.join(" ")} — estimated ${price} (founding client discount applied)`;

    const notice = document.getElementById("prefill-notice");
    if (notice) {
      const strong = document.createElement("strong");
      strong.textContent = price;
      notice.replaceChildren("Your estimate: ", strong, " — tell us a bit more below.");
      notice.hidden = false;
    }

    const serviceInput = document.getElementById("service") as HTMLInputElement | null;
    if (serviceInput) {
      serviceInput.value = "New Site";
      serviceInput.dispatchEvent(new Event("change"));
    }

    const business = document.getElementById("business_name") as HTMLInputElement | null;
    if (business && !business.value) window.setTimeout(() => business.focus({ preventScroll: true }), 1400);
  });
</script>
