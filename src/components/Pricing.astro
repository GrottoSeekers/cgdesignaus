---
// Prices live in src/lib/pricing.ts so the packages, quote builder and quick jobs always agree.
import {
  FOUNDING_DISCOUNT_RATE, pageOptions, featureOptions, tiers, carePlan,
  lowestQuickJobPrice, brandTidyUp, brandIdentity, selfEdit, aud, founding,
} from "../lib/pricing";
import { contactHref } from "../lib/prefill";

interface Props {
  /** "h1" when this section opens its own page. */
  heading?: "h1" | "h2";
}
const { heading: Heading = "h2" } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Chips show what you actually pay, so the estimate visibly adds up: the founding price for
// most extras, the full price for fixed ones (branding, admin login) and monthly ones.
const chip = (o: { label: string; price: number; recurring?: boolean; fixed?: boolean }) =>
  `+${aud(o.recurring || o.fixed ? o.price : founding(o.price))}${o.recurring ? "/mo" : ""}`;
const brandHref = contactHref(base, {
  service: "Branding",
  pick: "Branding",
  price: `from ${aud(brandTidyUp.price)}`,
  details: `Branding: ${brandTidyUp.name} (${aud(brandTidyUp.price)}) or ${brandIdentity.name} (${aud(brandIdentity.price)})`,
});
// The quote builder starts from the recommended package.
const startTier = tiers.find((t) => t.feature) ?? tiers[0];
const included = (id: string) => startTier.parts.includes(id);

const careHref = contactHref(base, {
  service: "Not Sure",
  pick: "Hosting & care plan",
  price: `${aud(carePlan.price)}/month`,
  details: `Hosting & care plan — ${aud(carePlan.price)}/month (${carePlan.firstMonthFree.toLowerCase()})`,
});
const adminHref = contactHref(base, {
  service: "Quick Job",
  pick: selfEdit.name,
  price: `${aud(selfEdit.price)} one-off`,
  details: `Website extra: ${selfEdit.name} — ${aud(selfEdit.price)} one-off`,
});
const startHref = (t: (typeof tiers)[number]) =>
  contactHref(base, {
    service: "New Site",
    pick: `${t.name} package`,
    price: aud(founding(t.full)),
    details: `${t.name} package — ${aud(founding(t.full))} (founding client price, full price ${aud(t.full)})`,
  });
---

<section id="pricing" style="position: relative; overflow: hidden; padding: 112px 0 104px; background: #f3f0f8; border-top: 1px solid rgba(20,17,26,0.1); border-bottom: 1px solid rgba(20,17,26,0.1)">
<div class="wrap" style="position: relative">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; margin-bottom: 40px">
<div style="max-width: 640px">
<span class="eyebrow">Pricing</span>
<Heading style="font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; margin-top: 16px">Three packages. <em style="font-style: italic; font-weight: 600; color: #5b2a96">One fixed price.</em></Heading>
</div>
<p style="max-width: 380px; color: rgba(20,17,26,0.68); font-size: 1rem">The price you see is the price you pay.</p>
</div>

<div class="founding" style="position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; padding: 22px 28px; border-radius: 20px; background: #2f1147; color: #f3eefa; margin-bottom: 28px">
<span style="font-family: 'Fraunces', serif; font-size: 2.4rem; font-weight: 600; line-height: 1; color: #ffffff; letter-spacing: -0.02em">{Math.round(FOUNDING_DISCOUNT_RATE * 100)}% off</span>
<div style="display: flex; flex-direction: column; gap: 2px; flex: 1 1 360px">
<span style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #d8bff0"><span class="live-dot" style="width: 8px; height: 8px; border-radius: 50%; background: #7cd68c"></span>Founding client offer</span>
<p style="font-size: 0.96rem; color: #f3eefa">Every package, for the first businesses we work with — plus priority turnaround and a real say in how it turns out.</p>
</div>
</div>

<div class="tiers" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(272px, 100%), 1fr)); gap: 24px; align-items: stretch">
{tiers.map((t) => t.feature ? (
<div class="tier tier-feature sel" data-tier={t.id} style="position: relative; border-radius: 24px; padding: 2px">
<div style="position: relative; z-index: 1; height: 100%; box-sizing: border-box; background: #2f1147; border-radius: 22px; padding: 32px; display: flex; flex-direction: column; gap: 22px; color: #f3eefa">
<div><span style="display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #d8bff0; margin-bottom: 8px">Recommended</span><h3 style="font-size: 1.35rem; margin-bottom: 6px; color: #ffffff">{t.name}</h3><p style="font-size: 0.9rem; color: rgba(243,238,250,0.78)">{t.tagline}</p></div>
<div style="display: flex; align-items: baseline; gap: 12px"><span class="sr">{aud(founding(t.full))}</span><span class="price-count" aria-hidden="true" data-to={founding(t.full)} data-from={t.full} style="font-family: 'Fraunces', serif; font-size: 3.2rem; font-weight: 600; line-height: 1; letter-spacing: -0.02em; color: #ffffff">{aud(founding(t.full))}</span><span class="rrp" style="font-size: 1.05rem; color: rgba(243,238,250,0.55)">{aud(t.full)}</span></div>
{t.note && <p class="tier-note tier-note-dark">{t.note}</p>}
<ul class="ticks" style="list-style: none; margin: 0; padding: 22px 0 0; border-top: 1px solid rgba(243,238,250,0.18); display: flex; flex-direction: column; gap: 12px; font-size: 0.92rem; color: rgba(243,238,250,0.9); flex: 1">
{t.includes.map((line) => <li><span class="tick tick-dark" aria-hidden="true">✓</span>{line}</li>)}
</ul>
<a href={startHref(t)} class="btn btn-violet">Start with {t.name}</a>
</div>
<button type="button" class="tier-pick sr-only" data-tier-pick={t.id} aria-pressed="true" aria-controls="tier-detail">Show what's in {t.name}</button>
</div>
) : (
<div class="tier" data-tier={t.id} style="background: #ffffff; border: 1px solid rgba(20,17,26,0.1); border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 22px">
<div><h3 style="font-size: 1.35rem; margin-bottom: 6px">{t.name}</h3><p style="font-size: 0.9rem; color: rgba(20,17,26,0.68)">{t.tagline}</p></div>
<div style="display: flex; align-items: baseline; gap: 12px"><span class="sr">{aud(founding(t.full))}</span><span class="price-count" aria-hidden="true" data-to={founding(t.full)} data-from={t.full} style="font-family: 'Fraunces', serif; font-size: 3.2rem; font-weight: 600; line-height: 1; letter-spacing: -0.02em">{aud(founding(t.full))}</span><span class="rrp" style="font-size: 1.05rem; color: rgba(20,17,26,0.45)">{aud(t.full)}</span></div>
{t.note && <p class="tier-note">{t.note}</p>}
<ul class="ticks" style="list-style: none; margin: 0; padding: 22px 0 0; border-top: 1px solid rgba(20,17,26,0.1); display: flex; flex-direction: column; gap: 12px; font-size: 0.92rem; color: rgba(20,17,26,0.78); flex: 1">
{t.includes.map((line) => <li><span class="tick" aria-hidden="true">✓</span>{line}</li>)}
</ul>
<a href={startHref(t)} class="btn btn-ghost">Start with {t.name}</a>
<button type="button" class="tier-pick sr-only" data-tier-pick={t.id} aria-pressed="false" aria-controls="tier-detail">Show what's in {t.name}</button>
</div>
))}
</div>
<div class="tier-detail" id="tier-detail" aria-live="polite">
{tiers.map((t) => (
<div class:list={["tier-panel", { show: t.feature }]} data-panel={t.id}>
<p class="tier-panel-tag"><strong>{t.name}:</strong> {t.tagline}</p>
{t.note && <p class="tier-note">{t.note}</p>}
<ul class="tier-panel-list">{t.includes.map((line) => <li><span class="tick" aria-hidden="true">✓</span>{line}</li>)}</ul>
<a href={startHref(t)} class="btn btn-primary">Start with {t.name}</a>
</div>
))}
</div>
<p class="pay-line">Pay 50% to start and 50% when you're live. Domains at cost, nothing hidden.</p>

<div class="extras">
<div class="extra-card">
<p class="extra-tag">Branding</p>
<h3 class="extra-title">Need a logo?</h3>
<div class="extra-option"><div><strong>{brandTidyUp.name}</strong><span>{brandTidyUp.desc}</span></div><span class="extra-price">{aud(brandTidyUp.price)}</span></div>
<div class="extra-option"><div><strong>{brandIdentity.name}</strong><span>{brandIdentity.desc}</span></div><span class="extra-price">{aud(brandIdentity.price)}</span></div>
<p class="extra-foot"><a href={brandHref} class="extra-ask">Ask about branding <span aria-hidden="true">→</span></a></p>
</div>
<div class="extra-card">
<p class="extra-tag">Website extra</p>
<h3 class="extra-title">{selfEdit.name}</h3>
<ul class="extra-list">{selfEdit.includes.map((line) => <li><span class="tick" aria-hidden="true">✓</span>{line}</li>)}</ul>
<p class="extra-foot"><span class="extra-price">{aud(selfEdit.price)}</span> <span class="extra-per">one-off</span> <a href={adminHref} class="extra-ask">Ask for this <span aria-hidden="true">→</span></a></p>
</div>
<div class="extra-card extra-care">
<p class="extra-tag">Monthly</p>
<h3 class="extra-title">Hosting &amp; care</h3>
<ul class="extra-list">{carePlan.perks.map((line) => <li><span class="tick tick-dark" aria-hidden="true">✓</span>{line}</li>)}</ul>
