---
// Prices live in src/lib/pricing.ts so the packages, quote builder and quick jobs always agree.
import {
  FOUNDING_DISCOUNT_RATE, tiers, carePlan, lowestQuickJobPrice, brandTidyUp, brandIdentity, selfEdit, aud, founding,
} from "../lib/pricing";
import { contactHref } from "../lib/prefill";
import QuoteBuilder from "./QuoteBuilder.astro";

interface Props {
  /** "h1" when this section opens its own page. */
  heading?: "h1" | "h2";
}
const { heading: Heading = "h2" } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Buttons open the contact form with the quote builder already set.
const startTier = tiers.find((t) => t.feature) ?? tiers[0];
const startHref = (t: (typeof tiers)[number]) => contactHref(base, { pkg: t.id });
const brandHref = contactHref(base, { pkg: "small" });
const adminHref = contactHref(base, { pkg: "small", items: ["admin"] });
const careHref = contactHref(base, { pkg: "small", items: ["maintenance"] });
---

<section id="pricing" style="position: relative; overflow: hidden; padding: 112px 0 104px; background: #f3f0f8; border-top: 1px solid rgba(20,17,26,0.1); border-bottom: 1px solid rgba(20,17,26,0.1)">
<div class="wrap" style="position: relative">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; margin-bottom: 40px">
<div style="max-width: 640px">
<span class="eyebrow">Pricing</span>
<Heading style="font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; margin-top: 16px">Three packages. <em style="font-style: italic; font-weight: 600; color: #5b2a96">One fixed price.</em></Heading>
</div>
<p style="max-width: 380px; color: rgba(20,17,26,0.68); font-size: 1rem">The price you see is the price you pay.</p>
</div>

<div class="founding" style="position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; padding: 22px 28px; border-radius: 20px; background: #2f1147; color: #f3eefa; margin-bottom: 28px">
<span style="font-family: 'Fraunces', serif; font-size: 2.4rem; font-weight: 600; line-height: 1; color: #ffffff; letter-spacing: -0.02em">{Math.round(FOUNDING_DISCOUNT_RATE * 100)}% off</span>
<div style="display: flex; flex-direction: column; gap: 2px; flex: 1 1 360px">
<span style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #d8bff0"><span class="live-dot" style="width: 8px; height: 8px; border-radius: 50%; background: #7cd68c"></span>Founding client offer</span>
<p style="font-size: 0.96rem; color: #f3eefa">Every package, for the first businesses we work with — plus priority turnaround and a real say in how it turns out.</p>
</div>
</div>

<div class="tiers" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(272px, 100%), 1fr)); gap: 24px; align-items: stretch">
{tiers.map((t) => t.feature ? (
<div class="tier tier-feature sel" data-tier={t.id} style="position: relative; border-radius: 24px; padding: 2px">
<div style="position: relative; z-index: 1; height: 100%; box-sizing: border-box; background: #2f1147; border-radius: 22px; padding: 32px; display: flex; flex-direction: column; gap: 22px; color: #f3eefa">
<div><span style="display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #d8bff0; margin-bottom: 8px">Recommended</span><h3 style="font-size: 1.35rem; margin-bottom: 6px; color: #ffffff">{t.name}</h3><p style="font-size: 0.9rem; color: rgba(243,238,250,0.78)">{t.tagline}</p></div>
<div style="display: flex; align-items: baseline; gap: 12px"><span class="sr">{aud(founding(t.full))}</span><span class="price-count" aria-hidden="true" data-to={founding(t.full)} data-from={t.full} style="font-family: 'Fraunces', serif; font-size: 3.2rem; font-weight: 600; line-height: 1; letter-spacing: -0.02em; color: #ffffff">{aud(founding(t.full))}</span><span class="rrp" style="font-size: 1.05rem; color: rgba(243,238,250,0.55)">{aud(t.full)}</span></div>
{t.note && <p class="tier-note tier-note-dark">{t.note}</p>}
<ul class="ticks" style="list-style: none; margin: 0; padding: 22px 0 0; border-top: 1px solid rgba(243,238,250,0.18); display: flex; flex-direction: column; gap: 12px; font-size: 0.92rem; color: rgba(243,238,250,0.9); flex: 1">
{t.includes.map((line) => <li><span class="tick tick-dark" aria-hidden="true">✓</span>{line}</li>)}
</ul>
<a href={startHref(t)} class="btn btn-violet">Start with {t.name}</a>
</div>
<button type="button" class="tier-pick sr-only" data-tier-pick={t.id} aria-pressed="true" aria-controls="tier-detail">Show what's in {t.name}</button>
</div>
) : (
<div class="tier" data-tier={t.id} style="background: #ffffff; border: 1px solid rgba(20,17,26,0.1); border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 22px">
<div><h3 style="font-size: 1.35rem; margin-bottom: 6px">{t.name}</h3><p style="font-size: 0.9rem; color: rgba(20,17,26,0.68)">{t.tagline}</p></div>
<div style="display: flex; align-items: baseline; gap: 12px"><span class="sr">{aud(founding(t.full))}</span><span class="price-count" aria-hidden="true" data-to={founding(t.full)} data-from={t.full} style="font-family: 'Fraunces', serif; font-size: 3.2rem; font-weight: 600; line-height: 1; letter-spacing: -0.02em">{aud(founding(t.full))}</span><span class="rrp" style="font-size: 1.05rem; color: rgba(20,17,26,0.45)">{aud(t.full)}</span></div>
{t.note && <p class="tier-note">{t.note}</p>}
<ul class="ticks" style="list-style: none; margin: 0; padding: 22px 0 0; border-top: 1px solid rgba(20,17,26,0.1); display: flex; flex-direction: column; gap: 12px; font-size: 0.92rem; color: rgba(20,17,26,0.78); flex: 1">
{t.includes.map((line) => <li><span class="tick" aria-hidden="true">✓</span>{line}</li>)}
</ul>
<a href={startHref(t)} class="btn btn-ghost">Start with {t.name}</a>
<button type="button" class="tier-pick sr-only" data-tier-pick={t.id} aria-pressed="false" aria-controls="tier-detail">Show what's in {t.name}</button>
</div>
))}
</div>
<div class="tier-detail" id="tier-detail" aria-live="polite">
{tiers.map((t) => (
<div class:list={["tier-panel", { show: t.feature }]} data-panel={t.id}>
<p class="tier-panel-tag"><strong>{t.name}:</strong> {t.tagline}</p>
{t.note && <p class="tier-note">{t.note}</p>}
<ul class="tier-panel-list">{t.includes.map((line) => <li><span class="tick" aria-hidden="true">✓</span>{line}</li>)}</ul>
<a href={startHref(t)} class="btn btn-primary">Start with {t.name}</a>
</div>
))}
</div>
<p class="pay-line">Pay 50% to start and 50% when you're live. Domains at cost, nothing hidden.</p>

<div class="extras">
<div class="extra-card">
<p class="extra-tag">Branding</p>
<h3 class="extra-title">Need a logo?</h3>
<div class="extra-option"><div><strong>{brandTidyUp.name}</strong><span>{brandTidyUp.desc}</span></div><span class="extra-price">{aud(brandTidyUp.price)}</span></div>
<div class="extra-option"><div><strong>{brandIdentity.name}</strong><span>{brandIdentity.desc}</span></div><span class="extra-price">{aud(brandIdentity.price)}</span></div>
<p class="extra-foot"><a href={brandHref} class="extra-ask">Ask about branding <span aria-hidden="true">→</span></a></p>
</div>
<div class="extra-card">
<p class="extra-tag">Website extra</p>
<h3 class="extra-title">{selfEdit.name}</h3>
<ul class="extra-list">{selfEdit.includes.map((line) => <li><span class="tick" aria-hidden="true">✓</span>{line}</li>)}</ul>
<p class="extra-foot"><span class="extra-price">{aud(selfEdit.price)}</span> <span class="extra-per">one-off</span> <a href={adminHref} class="extra-ask">Ask for this <span aria-hidden="true">→</span></a></p>
</div>
<div class="extra-card extra-care">
<p class="extra-tag">Monthly</p>
<h3 class="extra-title">Hosting &amp; care</h3>
<ul class="extra-list">{carePlan.perks.map((line) => <li><span class="tick tick-dark" aria-hidden="true">✓</span>{line}</li>)}</ul>
<p class="extra-foot"><span class="extra-price">{aud(carePlan.price)}</span> <span class="extra-per">/month</span> <a href={careHref} class="extra-ask">Add it <span aria-hidden="true">→</span></a></p>
</div>
</div>
<a href={`${base}/quick-jobs`} class="quick-link">Not after a full website? <strong>See quick jobs from {aud(lowestQuickJobPrice)}</strong> <span aria-hidden="true">→</span></a>

<div class="quote" id="quote" style="margin-top: 28px; border-radius: 22px; border: 1px solid rgba(20,17,26,0.12); background: #ffffff; overflow: hidden">
<button type="button" class="quote-toggle" id="quote-toggle" aria-expanded="false" aria-controls="quote-body" style="display: flex; align-items: center; gap: 16px; width: 100%; padding: 20px 24px; border: 0; background: transparent; text-align: left; font-family: inherit; color: #14111a; cursor: pointer">
<span class="quote-chev" style="width: 40px; height: 40px; border-radius: 50%; background: rgba(47,17,71,0.1); color: #2f1147; display: flex; align-items: center; justify-content: center; flex-shrink: 0"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span>
<span style="display: flex; flex-direction: column; flex: 1"><span style="font-weight: 700; font-size: 1.05rem">Add extras to a package</span><span style="font-size: 0.86rem; color: rgba(20,17,26,0.6)">Pick a package, add what you need, see your price</span></span>
<span style="font-family: 'Fraunces', serif; font-size: 1.5rem; font-weight: 600; color: #2f1147"><span data-quote-total>{aud(founding(startTier.full))}</span></span>
</button>
<div class="quote-body" id="quote-body">
<div style="overflow: hidden">
<QuoteBuilder mode="pricing" />
</div>
</div>
</div>
</div>
</section>

<style>
  .tier-note {
    margin-top: -8px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #5b2695;
  }

  .tier-note-dark {
    color: #d8bff0;
  }

  .tier-panel .tier-note {
    margin: 0 0 12px;
  }

  .pay-line {
    margin-top: 22px;
    text-align: center;
    font-size: 0.92rem;
    font-weight: 600;
    color: rgba(20, 17, 26, 0.72);
  }

  .extras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  .extra-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border-radius: 24px;
    background: #ffffff;
    border: 1px solid rgba(20, 17, 26, 0.1);
  }

  .extra-care {
    background: #2f1147;
    border-color: #2f1147;
    color: #f3eefa;
    box-shadow: 0 40px 70px -40px rgba(47, 17, 71, 0.7);
  }

  .extra-care .extra-tag {
    color: #d8bff0;
  }

  .extra-care .extra-title,
  .extra-care .extra-price {
    color: #ffffff;
  }

  .extra-care .extra-list,
  .extra-care .extra-per {
    color: rgba(243, 238, 250, 0.85);
  }

  .extra-care .extra-ask {
    color: #d8bff0;
  }

  .extra-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5b2695;
  }

  .extra-title {
    font-size: 1.4rem;
  }

  .extra-desc {
    font-size: 0.92rem;
    color: rgba(20, 17, 26, 0.68);
  }

  .extra-option {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding: 12px 0;
    border-top: 1px solid rgba(20, 17, 26, 0.1);
  }

  .extra-option div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.86rem;
    color: rgba(20, 17, 26, 0.64);
  }

  .extra-option strong {
    font-size: 0.96rem;
    color: #14111a;
  }

  .extra-price {
    font-family: "Fraunces", serif;
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #2f1147;
    white-space: nowrap;
  }

  .extra-per {
    font-size: 0.86rem;
    font-weight: 600;
    color: rgba(20, 17, 26, 0.6);
  }

  .extra-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.9rem;
    color: rgba(20, 17, 26, 0.78);
  }

  .extra-list li {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .extra-foot {
    margin-top: auto;
    padding-top: 8px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 10px;
    font-size: 0.86rem;
    color: rgba(20, 17, 26, 0.6);
  }

  .extra-ask {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-left: auto;
    font-weight: 700;
    font-size: 0.92rem;
    color: #5b2695;
    text-decoration: none;
  }

  @media (max-width: 560px) {
    .extra-card {
      padding: 22px 20px;
    }
  }

  .quick-link {
    display: table;
    margin: 10px auto 0;
    font-size: 0.92rem;
    color: #5b2695;
    text-decoration: none;
  }

  .quick-link strong {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The tap-to-select button only exists for keyboard/screen-reader users on phones. */
  .tier-pick {
    display: none;
  }

  @media (max-width: 640px) {
    .tier-pick {
      display: block;
    }
    .tier:has(.tier-pick:focus-visible) {
      outline: 2px solid #2f1147;
      outline-offset: 3px;
    }
  }
</style>

<script>
  import { animate, inView } from "motion";

  const aud = (n: number) => `$${Math.round(n).toLocaleString("en-AU")}`;

  // ---- Prices count down from the full price to the founding price, then the
  // old price gets struck through and the ticks pop in one by one. ----
  const tiersEl = document.querySelector<HTMLElement>(".tiers");
  const counts = Array.from(document.querySelectorAll<HTMLElement>(".price-count")).map((el) => ({
    el,
    from: Number(el.dataset.from),
    to: Number(el.dataset.to),
  }));
  const tickLists = Array.from(document.querySelectorAll<HTMLElement>(".tiers .ticks"));
  const onScreen = (el: Element) => {
    const r = el.getBoundingClientRect();
    return r.top < window.innerHeight && r.bottom > 0;
  };

  // If any of the packages show when the page opens (the top of /pricing, even on a small
  // phone where they peek in at the bottom), count down right after the page fade-in.
  // Otherwise start as soon as they scroll into view. Never leave the full prices showing.
  if (tiersEl) {
    tiersEl.classList.add("pre");
    tickLists.forEach((t) => t.classList.add("pre"));
    counts.forEach((c) => (c.el.textContent = aud(c.from)));

    if (onScreen(tiersEl)) window.setTimeout(() => countDown(tiersEl), 450);
    else inView(tiersEl, () => countDown(tiersEl), { amount: 0.15 });
  }

  function countDown(tiersEl: HTMLElement) {
    animate(0, 1, {
      duration: 1.4,
      ease: [0.33, 1, 0.68, 1],
      onUpdate: (k) => counts.forEach((c) => (c.el.textContent = aud(c.from - (c.from - c.to) * k))),
      onComplete: () => counts.forEach((c) => (c.el.textContent = aud(c.to))),
    });
    tiersEl.classList.add("go");
    tickLists.forEach((t) => {
      t.querySelectorAll<HTMLElement>(".tick").forEach((tick, j) => {
        tick.style.transitionDelay = `${0.5 + j * 0.12}s`;
      });
      t.classList.add("go");
    });
  }

  // ---- Phones: tap a package block to see what's in it ----
  const tierEls = Array.from(document.querySelectorAll<HTMLElement>(".tier[data-tier]"));
  const selectTier = (id: string) => {
    tierEls.forEach((t) => t.classList.toggle("sel", t.dataset.tier === id));
    document.querySelectorAll<HTMLButtonElement>("[data-tier-pick]").forEach((b) => {
      b.setAttribute("aria-pressed", String(b.dataset.tierPick === id));
    });
    document.querySelectorAll<HTMLElement>(".tier-panel").forEach((p) => p.classList.toggle("show", p.dataset.panel === id));
  };
  tierEls.forEach((t) =>
    t.addEventListener("click", (e) => {
      // On larger screens the cards' own "Start with …" links just go to the form.
      if ((e.target as Element).closest("a")) return;
      selectTier(t.dataset.tier ?? "");
    })
  );

  // ---- Quote builder: open and close (the builder itself is QuoteBuilder.astro) ----
  const toggle = document.getElementById("quote-toggle");
  const body = document.getElementById("quote-body");
  toggle?.addEventListener("click", () => {
    const open = !body?.classList.contains("open");
    body?.classList.toggle("open", open);
    toggle.querySelector(".quote-chev")?.classList.toggle("open", open);
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
