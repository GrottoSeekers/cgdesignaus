{pageOptions.map((o) => <button type="button" class:list={["chip", { inc: included(o.id) }]} aria-pressed="false" disabled={included(o.id)} data-id={o.id} data-kind="page" data-label={o.label} data-price={o.price}>{o.label} <span class="chip-price" data-text={chip(o)}>{included(o.id) ? "✓ Included" : chip(o)}</span></button>)}
</div>
</div>
<div>
<p style="font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(20,17,26,0.6); margin-bottom: 10px" class="quote-step">3. Add extras</p>
<div style="display: flex; flex-wrap: wrap; gap: 8px">
{featureOptions.map((o) => <button type="button" class:list={["chip", { inc: included(o.id) }]} aria-pressed="false" disabled={included(o.id)} data-id={o.id} data-kind="extra" data-label={o.label} data-price={o.price} data-recurring={o.recurring ? "1" : undefined} data-fixed={o.fixed ? "1" : undefined} title={o.desc}>{o.label} <span class="chip-price" data-text={chip(o)}>{included(o.id) ? "✓ Included" : chip(o)}</span></button>)}
</div>
</div>
</div>
<div style="flex: 1 1 260px; display: flex; flex-direction: column; gap: 6px; padding: 22px; margin-top: 22px; border-radius: 18px; background: #2f1147; color: #f3eefa">
<span style="font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #d8bff0">Your estimate</span>
<span style="display: flex; align-items: baseline; gap: 10px"><span style="font-family: 'Fraunces', serif; font-size: 2.6rem; font-weight: 600; line-height: 1.05; color: #ffffff"><span data-quote-total aria-live="polite">{aud(founding(startTier.full))}</span></span><span style="font-size: 1rem; text-decoration: line-through; color: rgba(243,238,250,0.5)"><span data-quote-rrp>{aud(startTier.full)}</span></span></span>
<span style="font-size: 0.86rem; color: rgba(243,238,250,0.72)"><span data-quote-monthly>One-off, no lock-in</span></span>
