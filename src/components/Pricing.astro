<div class="pkgs" role="group" aria-label="Package">
{tiers.map((t) => <button type="button" class:list={["pkg", { on: t.id === startTier.id }]} aria-pressed={t.id === startTier.id ? "true" : "false"} data-pkg={t.id} data-name={t.name} data-full={t.full} data-parts={t.parts.join(",")}><span class="pkg-name">{t.name}</span><span class="pkg-price">{aud(founding(t.full))}</span></button>)}
</div>
