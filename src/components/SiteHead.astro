---
// Shared <head> meta for every page (SEO, social cards, favicon, PWA, fonts).
interface Props {
  title: string;
  description: string;
  image: string;
  fontsHref: string;
}

const { title, description, image, fontsHref } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const isProd = import.meta.env.PROD;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
<link rel="icon" type="image/png" href={`${base}/favicon.png`} sizes="512x512" />
<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
<link rel="apple-touch-icon" sizes="167x167" href={`${base}/icons/apple-touch-icon-167.png`} />
<link rel="apple-touch-icon" sizes="152x152" href={`${base}/icons/apple-touch-icon-152.png`} />
<link rel="manifest" href={`${base}/manifest.json`} />
<meta name="theme-color" content="#2f1147" />
<meta name="application-name" content="CG Design" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="CG Design" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="CG Design & Co.: Your business online in under a week." />
<meta property="og:site_name" content="CG Design & Co." />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="color-scheme" content="light" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href={fontsHref} rel="stylesheet" />
{isProd && (
  <script is:inline>
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", () => {
        navigator.serviceWorker.register("/sw.js", { scope: "/" }).catch(() => {});
      });
    }
  </script>
)}
