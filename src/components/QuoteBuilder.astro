---
// One quote builder, used in two places:
// - mode "pricing": pick a package, add extras, "Send me this quote" (Pricing page)
// - mode "form": the same picks inside the contact form, plus "Something smaller" (quick
//   jobs, branding and other extras on their own) and "Not sure yet" (a free business check).
//   It writes a plain summary into the form, so the email and WhatsApp say exactly what's wanted.
import {
  tiers, pageOptions, featureOptions, quickJobs, starterBundle, brandTidyUp, brandIdentity,
  selfEdit, carePlan, FOUNDING_DISCOUNT_RATE, aud, founding,
} from "../lib/pricing";

interface Props {
  mode: "pricing" | "form";
}
const { mode } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const startTier = tiers.find((t) => t.feature) ?? tiers[0];
// The Pricing builder starts on the recommended package; the form starts on "Not sure yet".
const startPkg = mode === "pricing" ? startTier.id : "check";
const startParts: string[] = mode === "pricing" ? startTier.parts : [];

// Chips show what you actually pay: the founding price for most website extras, the full
// price for fixed ones (branding, admin login) and monthly ones.
type SiteOption = { id: string; label: string; price: number; recurring?: boolean; fixed?: boolean; desc?: string };
const sitePrice = (o: SiteOption) => (o.recurring || o.fixed ? o.price : founding(o.price));
const siteChip = (o: SiteOption) => `+${aud(sitePrice(o))}${o.recurring ? "/mo" : ""}`;
const discounted = (o: SiteOption) => !o.recurring && !o.fixed;

// Things that can be bought without a website package.
const smallOptions = [
  ...quickJobs.map((j) => ({ id: `job-${j.id}`, label: j.name, price: j.price, suffix: j.per ? ` ${j.per}` : "", recurring: false })),
  { id: "job-starter-bundle", label: starterBundle.name, price: starterBundle.price, suffix: "", recurring: false },
  { id: "brand-tidy", label: brandTidyUp.name, price: brandTidyUp.price, suffix: "", recurring: false },
  { id: "brand", label: brandIdentity.name, price: brandIdentity.price, suffix: "", recurring: false },
  { id: "admin", label: selfEdit.name, price: selfEdit.price, suffix: "", recurring: false },
  { id: "maintenance", label: "Hosting & care", price: carePlan.price, suffix: "/mo", recurring: true },
];

const included = (id: string) => startParts.includes(id);
const isTier = tiers.some((t) => t.id === startPkg);

// Pricing page: website features as chips, branding and the admin login tucked into a dropdown,
// and hosting & care always part of the quote (explained just under the builder).
const tucked = ["brand-tidy", "brand", "admin"];
const shownFeatures = mode === "pricing" ? featureOptions.filter((o) => !tucked.includes(o.id) && o.id !== "maintenance") : featureOptions;
const tuckedOptions = tucked.map((id) => featureOptions.find((o) => o.id === id)!);
const tuckedName: Record<string, string> = { "brand-tidy": brandTidyUp.name, brand: brandIdentity.name, admin: selfEdit.name };
const tuckedDesc: Record<string, string> = {
  "brand-tidy": brandTidyUp.desc,
  brand: brandIdentity.desc,
  admin: "Sign in and change your own text, photos, prices and hours, any time.",
};
// Quick jobs alongside a website, domain first. Fixed prices, no founding discount.
const jobOrder = ["domain", "google-profile", "social", "reviews"];
const siteJobs = jobOrder.map((id) => quickJobs.find((j) => j.id === id)!).map((j) => ({
  id: `job-${j.id}`, label: j.name, price: j.price, chip: `+${aud(j.price)}${j.per ? ` ${j.per}` : ""}`,
}));
// Everything each package gets, written out in full (not "Everything in Growth").
const fullIncludes = tiers.map((t, i) =>
  tiers.slice(0, i + 1).flatMap((x) => x.includes).filter((line) => !line.startsWith("Everything in"))
);
---

<div class:list={["qb", `qb-${mode}`]} data-qb={mode} data-rate={FOUNDING_DISCOUNT_RATE} data-base={base} data-care={carePlan.price}>
<div class="qb-picks">
<div>
<p class="quote-step">{mode === "pricing" ? "1. Pick a package" : "What would you like?"}</p>
<div class="pkgs" role="group" aria-label={mode === "pricing" ? "Package" : "What would you like?"}>
{tiers.map((t) => (
<button type="button" class:list={["pkg", { on: t.id === startPkg }]} aria-pressed={t.id === startPkg ? "true" : "false"} data-pkg={t.id} data-name={`${t.name} package`} data-full={t.full} data-parts={t.parts.join(",")}><span class="pkg-name">{t.name}</span><span class="pkg-prices"><span class="pkg-price">{aud(founding(t.full))}</span><s class="pkg-was">{aud(t.full)}</s></span></button>
))}
{mode === "form" && (
<>
<button type="button" class="pkg pkg-wide" aria-pressed="false" data-pkg="small" data-name="Something smaller"><span class="pkg-name">Something smaller</span><span class="pkg-sub">Quick jobs, logos &amp; extras</span></button>
<button type="button" class:list={["pkg", "pkg-wide", { on: startPkg === "check" }]} aria-pressed={startPkg === "check" ? "true" : "false"} data-pkg="check" data-name="Not sure yet"><span class="pkg-name">Not sure yet</span><span class="pkg-sub">Free business check</span></button>
</>
)}
</div>
</div>

{mode === "pricing" && (
<div class="qb-incl">
<p class="quote-step">What you get</p>
{tiers.map((t, i) => (
<div class="incl" data-incl={t.id} hidden={t.id !== startPkg}>
<ul class="incl-list">{fullIncludes[i].map((line) => <li><span class="tick" aria-hidden="true">✓</span>{line}</li>)}</ul>
{t.note && <p class="incl-note">{t.note}</p>}
</div>
))}
</div>
)}

<div class="qb-site" hidden={!isTier}>
<div>
<p class="quote-step">{mode === "pricing" ? "2. Want more? " : ""}Add extra pages <span>· Home &amp; Contact always included</span></p>
<div class="chips">
{pageOptions.map((o) => <button type="button" class:list={["chip", { inc: included(o.id) }]} aria-pressed="false" disabled={included(o.id)} data-id={o.id} data-label={o.label} data-price={o.price}>{o.label} {discounted(o) && <s class="chip-was">{aud(o.price)}</s>} <span class="chip-price" data-text={siteChip(o)}>{included(o.id) ? "✓ Included" : siteChip(o)}</span></button>)}
</div>
</div>
<div>
<p class="quote-step">{mode === "pricing" ? "3. " : ""}Add extras</p>
<div class="chips">
{shownFeatures.map((o) => <button type="button" class:list={["chip", { inc: included(o.id) }]} aria-pressed="false" disabled={included(o.id)} data-id={o.id} data-label={o.label} data-price={o.price} data-recurring={o.recurring ? "1" : undefined} data-fixed={o.fixed ? "1" : undefined} title={o.desc}>{o.label} {discounted(o) && <s class="chip-was">{aud(o.price)}</s>} <span class="chip-price" data-text={siteChip(o)}>{included(o.id) ? "✓ Included" : siteChip(o)}</span></button>)}
</div>
</div>
<div>
<p class="quote-step">{mode === "pricing" ? "4. " : ""}Quick jobs <span>· most websites need a domain</span></p>
<div class="chips">
{siteJobs.map((o) => <button type="button" class:list={["chip", { inc: included(o.id) }]} aria-pressed="false" disabled={included(o.id)} data-id={o.id} data-label={o.label} data-price={o.price} data-fixed="1">{o.label} <span class="chip-price" data-text={o.chip}>{included(o.id) ? "✓ Included" : o.chip}</span></button>)}
</div>
</div>
{mode === "pricing" && (
<details class="more">
<summary><span>Need a logo, or your own admin login?</span><span class="more-chev" aria-hidden="true">+</span></summary>
<div class="more-list">
{tuckedOptions.map((o) => (
<button type="button" class="chip opt" aria-pressed="false" data-id={o.id} data-label={tuckedName[o.id]} data-price={o.price} data-fixed="1" data-group={o.id.startsWith("brand") ? "brand" : undefined}><span class="opt-box" aria-hidden="true"></span><span class="opt-text"><strong>{tuckedName[o.id]}</strong><span>{tuckedDesc[o.id]}</span></span><span class="opt-price">+{aud(o.price)}</span></button>
))}
</div>
</details>
)}
</div>

{mode === "form" && (
<div class="qb-small" hidden>
<p class="quote-step">Pick what you need</p>
<div class="chips">
{smallOptions.map((o) => <button type="button" class="chip" aria-pressed="false" data-id={o.id} data-label={o.label} data-price={o.price} data-recurring={o.recurring ? "1" : undefined}>{o.label} <span class="chip-price">+{aud(o.price)}{o.suffix}</span></button>)}
</div>
</div>
)}
</div>

{mode === "pricing" ? (
<div class="qb-estimate">
<span class="qb-estimate-tag">Your estimate</span>
<span class="qb-estimate-row"><span class="qb-estimate-total"><span data-quote-total aria-live="polite">{aud(founding(startTier.full))}</span></span><span class="qb-estimate-rrp"><span data-quote-rrp>{aud(startTier.full)}</span></span></span>
<span class="qb-estimate-note"><span data-quote-monthly>One-off, plus {aud(carePlan.price)}/month hosting &amp; care</span></span>
<a href={`${base}/contact`} class="btn btn-violet" data-qb-send style="margin-top: 14px">Send me this quote</a>
<span class="qb-estimate-small">No payment, no obligation.</span>
</div>
) : (
<p class="qb-total" hidden>Your estimate: <strong data-quote-total aria-live="polite"></strong> <s class="qb-total-was" data-quote-rrp></s> <span data-quote-monthly></span></p>
)}
</div>

<style>
