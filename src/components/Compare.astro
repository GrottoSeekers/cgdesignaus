---
// "A typical agency vs us": the promises side by side, so visitors see the difference at a glance.
import { aud, lowestPackagePrice } from "../lib/pricing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const rows = [
  { label: "Cost", agency: "$3,000 to $10,000+", us: `From ${aud(lowestPackagePrice)}` },
  { label: "Time to launch", agency: "4 to 8 weeks", us: "Under a week" },
  { label: "Who you deal with", agency: "An account manager", us: "The designer, start to finish" },
  { label: "Copy and photos", agency: "Usually extra", us: "Included" },
  { label: "Who owns the site", agency: "Often locked to their platform", us: "100% yours" },
];
---

<section id="compare" style="position: relative; padding: 104px 0 96px; background: #ffffff">
<div class="wrap">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; margin-bottom: 40px">
<div style="max-width: 640px">
<span class="eyebrow">Why CG Design</span>
<h2 style="font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; margin-top: 16px">Big-agency polish. <em style="font-style: italic; font-weight: 600; color: #5b2a96; white-space: nowrap">Small-business price.</em></h2>
</div>
<p style="max-width: 380px; color: rgba(20,17,26,0.68); font-size: 1rem">Everything you'd expect from an agency, without the wait, the jargon or the bill.</p>
</div>

<div class="compare">
<div class="compare-card compare-agency">
<p class="compare-head">A typical agency</p>
<dl>
{rows.map((r) => (
<div class="compare-row"><dt>{r.label}</dt><dd>{r.agency}</dd></div>
))}
</dl>
</div>
<div class="compare-card compare-us">
<p class="compare-head"><img src={`${base}/logo-full.png?v=2`} alt="CG Design &amp; Co." width="566" height="241" loading="lazy" class="compare-logo"></p>
<dl>
{rows.map((r) => (
<div class="compare-row"><dt>{r.label}</dt><dd><span class="compare-tick" aria-hidden="true">✓</span>{r.us}</dd></div>
))}
</dl>
</div>
</div>
</div>
</section>

<style>
  .compare {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .compare-card {
    padding: 32px;
    border-radius: 24px;
  }

  .compare-agency {
    background: #f3f0f8;
    border: 1px solid rgba(20, 17, 26, 0.08);
  }

  .compare-us {
    background: #2f1147;
    color: #f3eefa;
    box-shadow: 0 40px 80px -40px rgba(47, 17, 71, 0.7);
  }

  .compare-head {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 14px;
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: rgba(20, 17, 26, 0.7);
  }

  .compare-logo {
    display: block;
    height: 36px;
    width: auto;
    padding: 6px 10px;
    border-radius: 10px;
    background: #ffffff;
  }

  .compare dl {
    margin: 0;
  }

  .compare-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid rgba(20, 17, 26, 0.1);
  }

  .compare-us .compare-row {
    border-top-color: rgba(243, 238, 250, 0.16);
  }

  .compare dt {
    font-size: 0.88rem;
    color: rgba(20, 17, 26, 0.6);
  }

  .compare dd {
    margin: 0;
    text-align: right;
    font-size: 0.98rem;
    font-weight: 600;
    color: rgba(20, 17, 26, 0.72);
  }

  .compare-us dt {
    color: rgba(243, 238, 250, 0.68);
  }

  .compare-us dd {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-weight: 700;
  }

  .compare-tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #7c4fc7;
    color: #ffffff;
    font-size: 0.68rem;
  }

  @media (max-width: 560px) {
    .compare-card {
      padding: 24px 22px;
    }
  }
</style>
