---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const img = `${base}/previews`;

// Add a client = add one entry here. Layout follows the count:
// 1 → single centred, 2 → two centred, 3 → row with the middle one raised,
// 4+ → swipeable track, three per view, with arrows and dots.
// `palette` and `fonts` are the client's brand, shown under the blurb; `made` is what we
// designed for them, shown as a badge on the phone.
const clients = [
  {
    name: "J.Pickles Coaching",
    kicker: "Personal trainer · Leigh",
    blurb: "Prices, WhatsApp sign-up, Friday check-ins and a private coach dashboard.",
    href: "https://www.jpicklesfitnesscoaching.com",
    linkLabel: "Visit the live site",
    palette: ["#0C0C0D", "#F4F1EA", "#C9A45C", "#A9A59D"],
    fonts: "Bodoni Moda + Hanken Grotesk",
    made: ["Brand", "Website"],
    shots: [{ src: "jpickles-mobile.webp", alt: "J.Pickles Coaching full mobile homepage", width: 780, height: 14292 }],
  },
  {
    name: "MYAH",
    kicker: "House & pet sitting · Launching soon",
    blurb: "A launch site for a new house and pet sitting platform, with an early-access waitlist.",
    href: "https://www.myahsits.com/callumandniamh",
    linkLabel: "See Callum & Niamh's page",
    palette: ["#2C1A0E", "#FAF6EE", "#2F5D45", "#C4AB8A"],
    fonts: "Marcellus + Montserrat",
    made: ["Logo", "Brand", "Website"],
    shots: [{ src: "myah-callumandniamh.webp", alt: "Callum & Niamh's house and pet sitting page on MYAH", width: 390, height: 2802 }],
  },
  {
    name: "NIR-MA-TA",
    kicker: "Espresso cart · Lombok",
    blurb: "A full menu, live pricing and an order builder, in Indonesian and English.",
    href: "https://www.nir-ma-ta.com",
    linkLabel: "Visit nir-ma-ta.com",
    palette: ["#EE1C25", "#121212", "#FFFFFF", "#F0F0F0"],
    fonts: "Archivo Black + Work Sans",
    made: ["Brand", "Website"],
    shots: [
      { src: "nirmata-hero.webp", alt: "NIR-MA-TA homepage", width: 760, height: 1652 },
      { src: "nirmata-menu.webp", alt: "NIR-MA-TA menu with prices", width: 620, height: 1348 },
    ],
  },
  {
    name: "Nigel's Hairdressing",
    kicker: "Mobile hairdresser · Wigan & Rochdale",
    blurb: "Rebuilt from a dated Wix template: recent work, clear prices and one-tap booking.",
    href: "https://www.nigelshairdressingwiganandrochdale.com",
    linkLabel: "Visit the live site",
    palette: ["#2A1A14", "#F7F0E6", "#EFC3B0", "#C98B5A"],
    fonts: "Gloock + Hanken Grotesk",
    made: ["Logo", "Brand", "Website"],
    shots: [{ src: "nigels-after-mobile.webp", alt: "Nigel's Hairdressing full mobile homepage", width: 390, height: 6874 }],
  },
  {
    name: "Rochses",
    kicker: "Womenswear label · Launching soon",
    blurb: "A coming-soon site collecting priority access ahead of the first collection.",
    href: "https://rochses.com",
    linkLabel: "Preview rochses.com",
    palette: ["#F3EFE7", "#CBC2B2", "#8B7765", "#46403A"],
    fonts: "Cormorant Garamond + Inter",
    made: ["Logo", "Brand", "Website"],
    shots: [
      { src: "rochses-hero.webp", alt: "Rochses coming-soon homepage", width: 760, height: 1644 },
      { src: "rochses-signup.webp", alt: "Rochses priority access signup", width: 620, height: 1341 },
    ],
  },
];

const n = clients.length;
const track = n > 3;
const pageCount = Math.ceil(n / 3);
const gridCols = track ? "none" : `repeat(${n}, minmax(0, 1fr))`;
const gridMax = n === 1 ? "380px" : n === 2 ? "760px" : "none";
const offset = (i: number) => (n === 3 && i !== 1 ? "56px" : "0px");

interface Props {
  /** "h1" when this section opens its own page. */
  heading?: "h1" | "h2";
}
const { heading: Heading = "h2" } = Astro.props;
// Headings inside the section sit one level below its title (h2 under a page h1). The
// "sub-h" class keeps them looking the same whichever level they are.
const Sub = Heading === "h1" ? "h2" : "h3";
---

<section id="client" style="position: relative; padding: 112px 0 96px; background: #ffffff; overflow: hidden">
<div aria-hidden="true" style="position: absolute; inset: 0; background-image: radial-gradient(rgba(47,17,71,0.12) 1px, transparent 1px); background-size: 22px 22px; -webkit-mask-image: radial-gradient(ellipse at 50% 60%, #000 10%, transparent 65%); mask-image: radial-gradient(ellipse at 50% 60%, #000 10%, transparent 65%); pointer-events: none"></div>
<div class="wrap" style="position: relative">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; margin-bottom: 64px">
<div style="max-width: 640px">
<span class="eyebrow" style="margin-bottom: 18px">Our work</span>
<Heading style="font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; margin-top: 14px">A few of the businesses we've helped <em style="font-style: italic; font-weight: 600; color: #5b2a96">get online.</em></Heading>
</div>
<div style="max-width: 360px">
<p style="color: rgba(20,17,26,0.68); font-size: 1rem; margin-bottom: 10px">We branded, designed, wrote and launched every one of these ourselves. Tap any phone to see the live site.</p>
<a href={`${base}/contact/`} style="display: inline-flex; align-items: center; gap: 7px; min-height: 44px; font-weight: 700; font-size: 0.9rem; color: #5b2695; text-decoration: none">Start your project →</a>
</div>
</div>
<div class:list={["showcase", track ? "showcase-track" : "showcase-grid"]} id="showcase" style={`gap: 40px; align-items: start; grid-template-columns: ${gridCols}; max-width: ${gridMax}; margin: 0 auto`}>
{clients.map((c, i) => (
<div class="work-card" style={`display: flex; flex-direction: column; align-items: center; margin-top: ${offset(i)}`}>
<a href={c.href} target="_blank" rel="noopener" class="device" aria-label={`Visit ${c.name}`} style="display: block; width: 276px; max-width: 100%; padding: 10px; border-radius: 46px; background: #14111a; box-shadow: 0 50px 80px -40px rgba(47,17,71,0.45), inset 0 0 0 1px rgba(255,255,255,0.08)">
<span style="position: relative; display: block; height: 540px; border-radius: 36px; overflow: hidden; background: #ffffff">
<span aria-hidden="true" style="position: absolute; z-index: 2; top: 10px; left: 50%; width: 84px; height: 24px; margin-left: -42px; border-radius: 999px; background: #14111a"></span>
<span class="scroll-col" style="display: block">{c.shots.map((shot) => <img src={`${img}/${shot.src}`} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" style="display: block; width: 100%; height: auto" />)}</span>
</span>
</a>
<span class="made"><span class="sr-only">We designed: </span>{c.made.join(" · ")}</span>
<div style="width: 100%; max-width: 320px; margin-top: 18px; text-align: center">
<span style="font-size: 0.74rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(20,17,26,0.64)">{c.kicker}</span>
<Sub class="sub-h" style="font-size: 1.5rem; margin: 6px 0 8px">{c.name}</Sub>
<p style="font-size: 0.92rem; color: rgba(20,17,26,0.68); margin-bottom: 6px">{c.blurb}</p>
<div class="brand-row">
<ul class="swatches" aria-label={`${c.name} brand colours`}>
{c.palette.map((hex) => <li class="swatch" style={`background: ${hex}`} data-hex={hex}><span class="sr-only">{hex}</span></li>)}
</ul>
<span class="fonts"><span aria-hidden="true" class="fonts-aa">Aa</span><span class="sr-only">Fonts: </span>{c.fonts}</span>
</div>
<a href={c.href} target="_blank" rel="noopener" class="visit">{c.linkLabel} <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg></a>
</div>
</div>
))}
</div>
{track && (
<div class="work-nav" style="display: flex; align-items: center; justify-content: center; gap: 18px; margin-top: 36px">
<button type="button" aria-label="Previous clients" class="work-nav-btn" data-work-prev disabled><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button>
<div style="display: flex; gap: 8px">
{Array.from({ length: pageCount }, (_, i) => (
<button type="button" aria-label={`Show clients ${i * 3 + 1}–${Math.min(n, i * 3 + 3)}`} class:list={["work-dot", { active: i === 0 }]} data-work-page={i}></button>
))}
</div>
<button type="button" aria-label="Next clients" class="work-nav-btn" data-work-next><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button>
</div>
)}
<p class="swipe-hint" style="align-items: center; justify-content: center; gap: 8px; margin-top: 8px; font-size: 0.82rem; font-weight: 600; color: rgba(20,17,26,0.6)">Swipe to see more <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></p>
</div>
</section>

<style>
  .made {
    position: relative;
    z-index: 3;
    margin-top: -16px;
    padding: 7px 14px;
    border-radius: 999px;
    background: #2f1147;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    white-space: nowrap;
    box-shadow: 0 10px 24px -10px rgba(47, 17, 71, 0.8);
  }

  .brand-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin: 12px 0 10px;
  }

  .swatches {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fonts {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(20, 17, 26, 0.6);
  }

  .fonts-aa {
    font-family: "Fraunces", Georgia, serif;
    font-size: 0.9rem;
    color: #5b2a96;
  }

  .swatch {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(20, 17, 26, 0.14);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .swatch {
    position: relative;
  }

  /* Hovering a dot shows its colour code. */
  .swatch::after {
    content: attr(data-hex);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    padding: 4px 8px;
    border-radius: 6px;
    background: #14111a;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  @media (hover: hover) {
    .swatch:hover::after {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  @media (hover: hover) {
    .work-card:hover .swatch {
      transform: translateY(-3px);
    }

    .work-card:hover .swatch:nth-child(2) {
      transition-delay: 0.04s;
    }

    .work-card:hover .swatch:nth-child(3) {
      transition-delay: 0.08s;
    }

    .work-card:hover .swatch:nth-child(4) {
      transition-delay: 0.12s;
    }
  }

  @media (max-width: 760px) {
    .work-nav {
      display: none !important;
    }
  }
</style>

<script>
  // 4+ clients: arrows and dots page the track three cards at a time.
  const track = document.querySelector<HTMLElement>("#showcase.showcase-track");
  if (track) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>(".work-card"));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-work-page]"));
    const prev = document.querySelector<HTMLButtonElement>("[data-work-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-work-next]");
    const pageCount = dots.length;
    let page = 0;

    const goPage = (i: number) => {
      const card = cards[Math.max(0, Math.min(pageCount - 1, i)) * 3];
      if (card) track.scrollTo({ left: card.offsetLeft - cards[0].offsetLeft, behavior: "smooth" });
    };

    const sync = () => {
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      const step = cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth;
      page = atEnd ? pageCount - 1 : Math.round(track.scrollLeft / (step * 3));
      dots.forEach((d, i) => d.classList.toggle("active", i === page));
      if (prev) prev.disabled = page <= 0;
      if (next) next.disabled = page >= pageCount - 1;
    };

    dots.forEach((d, i) => d.addEventListener("click", () => goPage(i)));
    prev?.addEventListener("click", () => goPage(page - 1));
    next?.addEventListener("click", () => goPage(page + 1));
    track.addEventListener("scroll", sync, { passive: true });
    sync();
  }
</script>

<script>
  // Brand colours "paint in" one dot at a time as each client's details scroll into view.
  import { animate, inView, stagger } from "motion";
  import { prefersReducedMotion, SPRING_BOUNCY } from "../lib/motion-utils.js";

  if (!prefersReducedMotion()) {
    document.querySelectorAll<HTMLElement>(".swatches").forEach((row) => {
      if (row.getBoundingClientRect().top < window.innerHeight) return; // already on screen
      const dots = row.querySelectorAll<HTMLElement>(".swatch");
      dots.forEach((d) => (d.style.transform = "scale(0)"));
      inView(row, () => {
        // Hand the dots back to CSS afterwards so the card's hover lift still works.
        animate(dots, { scale: [0, 1] }, { ...SPRING_BOUNCY, delay: stagger(0.08, { startDelay: 0.15 }) }).then(() =>
          dots.forEach((d) => (d.style.transform = ""))
        );
      }, { amount: 1 });
    });
  }
</script>

<script>
  // Auto-scroll: every phone starts at the top at the same moment and scrolls down at the same
  // steady speed. Shorter pages wait at the bottom until the longest one gets there, then they all
  // glide back to the top together and go again. Hovering a phone pauses just that one.
  // Distances are measured from the real layout, so the speed matches at every screen size.
  import { animate } from "motion";

  const PACE = 70; // px a second while scrolling down (on a 540px-tall screen; smaller phones scale it)
  const START = 2; // s at the top before scrolling
  const HOLD = 2; // s at the bottom once the longest page arrives
  const BACK = 2.5; // s to glide back to the top

  const cols = Array.from(document.querySelectorAll<HTMLElement>("#client .scroll-col"));
  let runs: ReturnType<typeof animate>[] = [];

  function start() {
    runs.forEach((r) => r.stop());
    if (!cols.length) return;
    const win = cols[0].parentElement!.clientHeight;
    const pace = PACE * (win / 540);
    const dists = cols.map((c) => Math.max(0, c.offsetHeight - c.parentElement!.clientHeight));
    const times = dists.map((d) => d / pace);
    const loop = START + Math.max(...times) + HOLD + BACK;
    runs = cols.map((col, i) => {
      const down = (START + times[i]) / loop;
      return animate(
        col,
        { y: [0, 0, -dists[i], -dists[i], 0] },
        {
          duration: loop,
          times: [0, START / loop, down, (loop - BACK) / loop, 1],
          ease: ["linear", "linear", "linear", [0.65, 0, 0.35, 1]],
          repeat: Infinity,
        }
      );
    });
    cols.forEach((col, i) => {
      const device = col.closest<HTMLElement>(".device");
      if (!device || device.dataset.hoverPause) return;
      device.dataset.hoverPause = "1";
      device.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && runs[i]?.pause());
      device.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && runs[i]?.play());
    });
  }

  start();
  // Phone sizes change at a few breakpoints: restart in step when the layout changes width.
  let lastW = window.innerWidth;
  let t: number | undefined;
  window.addEventListener("resize", () => {
    if (window.innerWidth === lastW) return; // ignore iOS address-bar height changes
    lastW = window.innerWidth;
    clearTimeout(t);
    t = window.setTimeout(start, 200);
  });
</script>
