---
const img = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/previews`;

// Add a client = add one entry here. Layout follows the count:
// 1 → single centred, 2 → two centred, 3 → row with the middle one raised,
// 4+ → swipeable track, three per view, with arrows and dots.
// `dur`/`delay` set the phone screenshot's auto-scroll speed and offset.
const clients = [
  {
    name: "NIR-MA-TA",
    kicker: "Espresso cart · Lombok",
    blurb: "A full menu, live pricing and an order builder, in Indonesian and English.",
    href: "https://www.nir-ma-ta.com",
    linkLabel: "Visit nir-ma-ta.com",
    dur: "20s",
    delay: "0s",
    shots: [
      { src: "nirmata-hero.webp", alt: "NIR-MA-TA homepage", width: 760, height: 1652 },
      { src: "nirmata-menu.webp", alt: "NIR-MA-TA menu with prices", width: 620, height: 1348 },
    ],
  },
  {
    name: "Nigel's Hairdressing",
    kicker: "Mobile hairdresser · Wigan & Rochdale",
    blurb: "Rebuilt from a dated Wix template: recent work, clear prices and one-tap booking.",
    href: "https://www.nigelshairdressingwiganandrochdale.com",
    linkLabel: "Visit the live site",
    dur: "34s",
    delay: "0s",
    shots: [{ src: "nigels-after-mobile.webp", alt: "Nigel's Hairdressing full mobile homepage", width: 390, height: 6874 }],
  },
  {
    name: "Rochses",
    kicker: "Womenswear label · Launching soon",
    blurb: "A coming-soon site collecting priority access ahead of the first collection.",
    href: "https://rochses.com",
    linkLabel: "Preview rochses.com",
    dur: "18s",
    delay: "-6s",
    shots: [
      { src: "rochses-hero.webp", alt: "Rochses coming-soon homepage", width: 760, height: 1644 },
      { src: "rochses-signup.webp", alt: "Rochses priority access signup", width: 620, height: 1341 },
    ],
  },
];

const n = clients.length;
const track = n > 3;
const pageCount = Math.ceil(n / 3);
const gridCols = track ? "none" : `repeat(${n}, minmax(0, 1fr))`;
const gridMax = n === 1 ? "380px" : n === 2 ? "760px" : "none";
const offset = (i: number) => (n === 3 && i !== 1 ? "56px" : "0px");
---

<section id="client" style="position: relative; padding: 112px 0 96px; background: #ffffff; overflow: hidden">
<div aria-hidden="true" style="position: absolute; inset: 0; background-image: radial-gradient(rgba(47,17,71,0.12) 1px, transparent 1px); background-size: 22px 22px; -webkit-mask-image: radial-gradient(ellipse at 50% 60%, #000 10%, transparent 65%); mask-image: radial-gradient(ellipse at 50% 60%, #000 10%, transparent 65%); pointer-events: none"></div>
<div class="wrap" style="position: relative">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; margin-bottom: 64px">
<div style="max-width: 640px">
<span class="eyebrow" style="margin-bottom: 18px">Our work</span>
<h2 style="font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; margin-top: 14px">A few of the businesses we've helped <em style="font-style: italic; font-weight: 600; color: #5b2a96">get online.</em></h2>
</div>
<div style="max-width: 360px">
<p style="color: rgba(20,17,26,0.68); font-size: 1rem; margin-bottom: 10px">We designed, wrote and launched every one of these ourselves. Tap any phone to see the live site.</p>
<a href="#contact" style="display: inline-flex; align-items: center; gap: 7px; min-height: 44px; font-weight: 700; font-size: 0.9rem; color: #5b2695; text-decoration: none">Start your project →</a>
</div>
</div>
<div class:list={["showcase", track ? "showcase-track" : "showcase-grid"]} id="showcase" style={`gap: 40px; align-items: start; grid-template-columns: ${gridCols}; max-width: ${gridMax}; margin: 0 auto`}>
{clients.map((c, i) => (
<div class="work-card" style={`display: flex; flex-direction: column; align-items: center; margin-top: ${offset(i)}`}>
<a href={c.href} target="_blank" rel="noopener" class="device" aria-label={`Visit ${c.name}`} style="display: block; width: 276px; max-width: 100%; padding: 10px; border-radius: 46px; background: #14111a; box-shadow: 0 50px 80px -40px rgba(47,17,71,0.45), inset 0 0 0 1px rgba(255,255,255,0.08)">
<span style="position: relative; display: block; height: 540px; border-radius: 36px; overflow: hidden; background: #ffffff">
<span aria-hidden="true" style="position: absolute; z-index: 2; top: 10px; left: 50%; width: 84px; height: 24px; margin-left: -42px; border-radius: 999px; background: #14111a"></span>
<span class="scroll-col" style={`display: block; animation-duration: ${c.dur}; animation-delay: ${c.delay}`}>{c.shots.map((shot) => <img src={`${img}/${shot.src}`} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" style="display: block; width: 100%; height: auto" />)}</span>
</span>
</a>
<div style="width: 100%; max-width: 320px; margin-top: 32px; text-align: center">
<span style="font-size: 0.74rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(20,17,26,0.55)">{c.kicker}</span>
<h3 style="font-size: 1.5rem; margin: 6px 0 8px">{c.name}</h3>
<p style="font-size: 0.92rem; color: rgba(20,17,26,0.68); margin-bottom: 6px">{c.blurb}</p>
<a href={c.href} target="_blank" rel="noopener" class="visit">{c.linkLabel} <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg></a>
</div>
</div>
))}
</div>
{track && (
<div class="work-nav" style="display: flex; align-items: center; justify-content: center; gap: 18px; margin-top: 36px">
<button type="button" aria-label="Previous clients" class="work-nav-btn" data-work-prev disabled><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button>
<div style="display: flex; gap: 8px">
{Array.from({ length: pageCount }, (_, i) => (
<button type="button" aria-label={`Show clients ${i * 3 + 1}–${Math.min(n, i * 3 + 3)}`} class:list={["work-dot", { active: i === 0 }]} data-work-page={i}></button>
))}
</div>
<button type="button" aria-label="Next clients" class="work-nav-btn" data-work-next><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button>
</div>
)}
<p class="swipe-hint" style="align-items: center; justify-content: center; gap: 8px; margin-top: 8px; font-size: 0.82rem; font-weight: 600; color: rgba(20,17,26,0.6)">Swipe to see more <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></p>
</div>
</section>

<style>
  @media (max-width: 760px) {
    .work-nav {
      display: none !important;
    }
  }
</style>

<script>
  // 4+ clients: arrows and dots page the track three cards at a time.
  const track = document.querySelector<HTMLElement>("#showcase.showcase-track");
  if (track) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>(".work-card"));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-work-page]"));
    const prev = document.querySelector<HTMLButtonElement>("[data-work-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-work-next]");
    const pageCount = dots.length;
    let page = 0;

    const goPage = (i: number) => {
      const card = cards[Math.max(0, Math.min(pageCount - 1, i)) * 3];
      if (card) track.scrollTo({ left: card.offsetLeft - cards[0].offsetLeft, behavior: "smooth" });
    };

    const sync = () => {
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      const step = cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth;
      page = atEnd ? pageCount - 1 : Math.round(track.scrollLeft / (step * 3));
      dots.forEach((d, i) => d.classList.toggle("active", i === page));
      if (prev) prev.disabled = page <= 0;
      if (next) next.disabled = page >= pageCount - 1;
    };

    dots.forEach((d, i) => d.addEventListener("click", () => goPage(i)));
    prev?.addEventListener("click", () => goPage(page - 1));
    next?.addEventListener("click", () => goPage(page + 1));
    track.addEventListener("scroll", sync, { passive: true });
    sync();
  }
</script>
