---
const img = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/previews`;

const facts = [
  { old: "Dated Wix template", now: "Fast custom build", desc: "Off the template and onto a modern, mobile-first site you own outright." },
  { old: "Stock photos", now: "Your real work", desc: "Visitors see what you actually do, not someone else's photos." },
  { old: "Plain price list", now: "Clear prices, one-tap booking", desc: "Prices that are easy to scan and a call button that's always one tap away." },
];
---

<section id="before-after" style="position: relative; padding: 104px 0 96px; background: #ffffff">
<div class="wrap" style="position: relative">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; margin-bottom: 48px">
<div style="max-width: 660px">
<span class="eyebrow">Before &amp; after</span>
<h2 style="font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; margin-top: 16px">This is what your website <em style="font-style: italic; font-weight: 600; color: #5b2a96">could become.</em></h2>
</div>
<p style="max-width: 380px; color: rgba(20,17,26,0.68); font-size: 1rem">Same business, same name, a completely different first impression. Drag the handle and see the difference for yourself.</p>
</div>

<div class="ba-frame auto" id="ba-frame" style="position: relative; height: 600px; border-radius: 22px; overflow: hidden; background: #ffffff; border: 1px solid rgba(20,17,26,0.12); box-shadow: 0 50px 100px -50px rgba(47,17,71,0.45)">
<div style="position: absolute; inset: 0 0 auto 0; z-index: 6; display: flex; align-items: center; gap: 10px; height: 42px; padding: 0 16px; background: #f3f0f8; border-bottom: 1px solid rgba(20,17,26,0.08)">
<span style="display: flex; gap: 6px"><span style="width: 10px; height: 10px; border-radius: 50%; background: rgba(20,17,26,0.18)"></span><span style="width: 10px; height: 10px; border-radius: 50%; background: rgba(20,17,26,0.18)"></span><span style="width: 10px; height: 10px; border-radius: 50%; background: rgba(20,17,26,0.18)"></span></span>
<span style="flex: 1; max-width: 420px; margin: 0 auto; text-align: center; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.03em; color: rgba(20,17,26,0.5); overflow: hidden; text-overflow: ellipsis; white-space: nowrap">nigelshairdressingwiganandrochdale.com</span>
</div>
<div class="ba-scroll" style="position: absolute; inset: 42px 0 0 0; overflow-y: auto">
<div style="position: sticky; top: 0; z-index: 5; height: 0">
<div class="ba-overlay" style="position: relative; height: 558px">
<input type="range" class="ba-range" min="0" max="100" step="1" value="46" id="ba-range" aria-label="Compare Nigel's old Wix website with the new one">
<div class="ba-handle" id="ba-handle" style="position: absolute; top: 0; bottom: 0; left: 46%; width: 0; pointer-events: none">
<span style="position: absolute; top: 0; bottom: 0; left: -1px; width: 2px; background: #ffffff; box-shadow: 0 0 0 1px rgba(47,17,71,0.15), 0 0 16px rgba(91,42,150,0.45)"></span>
<span class="ba-grip" style="position: absolute; top: 50%; left: -28px; width: 56px; height: 56px; margin-top: -28px; border-radius: 50%; background: #ffffff; color: #2f1147; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 6px rgba(91,42,150,0.14), 0 14px 34px -8px rgba(20,17,26,0.5)"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7 3 12l5 5M16 7l5 5-5 5"></path></svg></span>
</div>
</div>
</div>
<div style="position: relative">
<img src={`${img}/nigels-after.webp`} width="1440" height="5449" loading="lazy" decoding="async" alt="Nigel's Hairdressing's new website by CG Design &amp; Co." style="display: block; width: 100%; height: auto">
<div class="ba-before" id="ba-before" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: #f3f0f8; -webkit-clip-path: inset(0 54% 0 0); clip-path: inset(0 54% 0 0)">
<img src={`${img}/nigels-before.webp`} width="1440" height="4330" loading="lazy" decoding="async" alt="Nigel's Hairdressing's old Wix website" style="display: block; width: 100%; height: auto">
</div>
</div>
</div>
</div>
<p style="display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 18px; font-size: 0.84rem; color: rgba(20,17,26,0.6); margin-top: 18px; text-align: center"><span>Drag the handle to compare</span><span aria-hidden="true">·</span><span>Scroll inside the frame to read both pages</span><span aria-hidden="true">·</span><a href="https://www.nigelshairdressingwiganandrochdale.com" target="_blank" rel="noopener" style="color: #5b2695; font-weight: 700; text-decoration: none">See the live site →</a></p>

<div class="ba-facts" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 20px; margin-top: 56px">
{facts.map((f) => (
<div class="ba-fact" style="padding: 26px; border-radius: 20px; background: #f3f0f8; border: 1px solid rgba(20,17,26,0.08)">
<div style="display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: 10px; row-gap: 6px; font-size: 1rem"><span style="grid-column: 1 / -1; font-size: 0.88rem; color: rgba(20,17,26,0.5); text-decoration: line-through">{f.old}</span><svg class="ba-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#5b2a96" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg><strong>{f.now}</strong></div>
<p style="margin-top: 10px; font-size: 0.88rem; color: rgba(20,17,26,0.68)">{f.desc}</p>
</div>
))}
</div>
</div>
</section>

<script>
  // The handle demos the drag (CSS keyframes on .ba-frame.auto) until the visitor
  // first moves it, then stays where they leave it. Drag anywhere on the frame with
  // a mouse or finger: a horizontal drag moves the handle, a vertical swipe still
  // scrolls the pages inside. The range input stays for keyboard users.
  const frame = document.getElementById("ba-frame");
  const range = document.getElementById("ba-range") as HTMLInputElement | null;
  const handle = document.getElementById("ba-handle");
  const before = document.getElementById("ba-before");

  if (frame && range && handle && before) {
    const setPos = (value: number) => {
      const v = Math.max(0, Math.min(100, Math.round(value)));
      frame.classList.remove("auto");
      range.value = String(v);
      handle.style.left = `${v}%`;
      const clip = `inset(0 ${100 - v}% 0 0)`;
      before.style.setProperty("-webkit-clip-path", clip);
      before.style.clipPath = clip;
    };

    range.addEventListener("input", () => setPos(Number(range.value)));

    let drag: { x: number; y: number; live: boolean } | null = null;
    const posFrom = (e: PointerEvent) => {
      const r = frame.getBoundingClientRect();
      return ((e.clientX - r.left) / r.width) * 100;
    };

    frame.addEventListener("pointerdown", (e) => {
      if ((e.target as Element).closest("a")) return;
      drag = { x: e.clientX, y: e.clientY, live: e.pointerType === "mouse" };
      if (drag.live) {
        setPos(posFrom(e));
        e.preventDefault();
      }
    });

    window.addEventListener(
      "pointermove",
      (e) => {
        if (!drag) return;
        if (!drag.live) {
          const dx = Math.abs(e.clientX - drag.x);
          const dy = Math.abs(e.clientY - drag.y);
          if (dy > 8 && dy > dx) {
            drag = null;
            return;
          }
          if (dx > 6) drag.live = true;
          else return;
        }
        setPos(posFrom(e));
      },
      { passive: true }
    );

    const end = () => {
      drag = null;
    };
    window.addEventListener("pointerup", end);
    window.addEventListener("pointercancel", end);
  }
</script>
