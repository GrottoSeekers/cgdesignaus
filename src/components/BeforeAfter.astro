---
import NigelStrands from "./NigelStrands.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Real client redesign: Nigel's Hairdressing (Wigan & Rochdale).
// Full-page screenshots captured October 2026 (old Wix site archived in
// clients/nigels-hairdressing/archive/old-wix-site/). The desktop captures
// are shown at every screen size: zoomed out, and never upscaled (so sharp).
const shots = {
  before: {
    desktop: `${base}/previews/nigels-before.webp`,
    alt: "Nigel's Hairdressing's old Wix website: orange header, stock photo hero and plain price list",
  },
  after: {
    desktop: `${base}/previews/nigels-after-base.webp`,
    alt: "Nigel's Hairdressing's new website by CG Design & Co.: chocolate and blush design with recent work, prices and FAQ",
  },
};
const liveUrl = "https://www.nigelshairdressingwiganandrochdale.com";
---

<section class="section" id="before-after">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Before &amp; after</span>
      <h2>Nigel's old website, and the one we built him.</h2>
      <p>Nigel has been cutting hair around Wigan and Rochdale for 37 years, but his website didn't show it. Drag the handle to see where he started and where he is now.</p>
    </div>

    <div class="compare reveal">
      <div class="compare-frame" id="compare-frame">
        <div class="compare-scroll" id="compare-scroll">
          <div class="compare-overlay-pin">
            <div class="compare-overlay">
              <input
                type="range"
                class="compare-range"
                id="compare-range"
                min="0"
                max="100"
                value="46"
                step="1"
                aria-label="Compare Nigel's Hairdressing's old Wix website with the new one"
              />
              <div class="compare-handle" id="compare-handle">
                <span class="handle-line"></span>
                <span class="handle-grip" id="compare-grip" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7 3 12l5 5M16 7l5 5-5 5"/></svg>
                </span>
              </div>
              <span class="scroll-hint">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
                Scroll inside to see the whole page
              </span>
            </div>
          </div>

          <div class="compare-stack">
            <div class="compare-after">
              <picture class="compare-shot">
                <img src={shots.after.desktop} alt={shots.after.alt} width="1440" height="5449" loading="lazy" decoding="async" />
              </picture>
              <!-- The new site's animated hair strands, drawn when the slider scrolls into view -->
              <NigelStrands autoplay={false} box={{ left: 42, top: 1.5049, width: 58, height: 11.3846 }} />
            </div>

            <div class="compare-before" id="compare-before">
              <picture class="compare-shot">
                <img src={shots.before.desktop} alt={shots.before.alt} width="1440" height="4330" loading="lazy" decoding="async" />
              </picture>
            </div>
          </div>
        </div>
      </div>
      <p class="compare-hint">Drag the arrows to compare · scroll inside the frame to read both pages top to bottom · <a href={liveUrl} target="_blank" rel="noopener noreferrer">See the live site →</a></p>
    </div>
  </div>
</section>

<style>
  .compare {
    max-width: 760px;
    margin: 0 auto;
  }

  .compare-frame {
    --pos: 46%;
    position: relative;
    height: clamp(440px, 46vw, 580px);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    background: var(--accent-2);
    -webkit-user-select: none;
    user-select: none;
  }

  .compare-scroll {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
  }

  .compare-overlay-pin {
    position: sticky;
    top: 0;
    height: 0;
    z-index: 6;
  }

  .compare-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: clamp(440px, 46vw, 580px);
    pointer-events: none;
  }

  .compare-stack {
    position: relative;
  }

  /* The "after" screenshot sets the scroll height; the "before" one sits on
     top of it and is clipped to the left of the handle. */
  .compare-after {
    position: relative;
    z-index: 1;
  }

  .compare-before {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #fff;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
    will-change: clip-path;
  }

  .compare-shot,
  .compare-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---- Drag handle ---- */
  .compare-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    z-index: 3;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .handle-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: var(--bg);
    box-shadow: 0 0 0 1px rgba(20, 17, 26, 0.2);
  }

  .handle-grip {
    position: relative;
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--bg);
    color: var(--accent-2);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 26px -8px rgba(0, 0, 0, 0.5);
  }

  .handle-grip.is-dragging {
    cursor: grabbing;
  }


  .handle-grip svg {
    width: 20px;
    height: 20px;
  }

  .compare-range {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    /* Keyboard only: taps and clicks pass through to the frame, so only the
       arrow handle moves the slider. */
    pointer-events: none;
    -webkit-tap-highlight-color: transparent;
  }

  .compare-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: transparent;
  }

  .compare-range::-moz-range-thumb {
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: transparent;
  }

  .compare-range::-moz-range-track {
    background: transparent;
    border: none;
  }

  .compare-range:focus-visible ~ .compare-handle .handle-grip {
    outline: 3px solid var(--accent-2);
    outline-offset: 3px;
  }

  .scroll-hint {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(20, 17, 26, 0.72);
    color: var(--paper-on-dark);
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    backdrop-filter: blur(6px);
  }

  .scroll-hint svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  .compare-hint {
    text-align: center;
    margin: 16px 0 0;
    font-size: 0.82rem;
    color: var(--text-faint);
  }


  .compare-hint a {
    color: inherit;
    font-weight: 700;
  }
</style>

<script>
  import { animate, inView, press } from "motion";

  const frame = document.getElementById("compare-frame");
  const range = document.getElementById("compare-range") as HTMLInputElement | null;
  const grip = document.getElementById("compare-grip");

  let pendingFrame = 0;
  let sweep: ReturnType<typeof animate> | null = null;

  const update = (value: number | string) => {
    frame?.style.setProperty("--pos", `${value}%`);
  };

  const scheduleUpdate = (value: number | string) => {
    if (pendingFrame) cancelAnimationFrame(pendingFrame);
    pendingFrame = requestAnimationFrame(() => {
      pendingFrame = 0;
      update(value);
    });
  };

  const setValue = (value: number) => {
    const clamped = Math.min(100, Math.max(0, value));
    if (range) range.value = String(Math.round(clamped));
    scheduleUpdate(clamped);
  };

  // Any interaction cancels the intro sweep so it never fights the visitor.
  const stopSweep = () => {
    sweep?.stop();
    sweep = null;
  };

  if (frame && range) {
    update(range.value);
    range.addEventListener("input", () => {
      stopSweep();
      scheduleUpdate(range.value);
    });

    // Only the arrow handle drags the slider. Taps elsewhere in the frame do
    // nothing, so scrolling inside the frame never jumps the handle.
    if (grip) {
      let startX = 0;
      let startValue = 0;
      grip.addEventListener("pointerdown", (e) => {
        e.preventDefault();
        stopSweep();
        startX = e.clientX;
        startValue = Number(range.value);
        grip.setPointerCapture(e.pointerId);
        grip.classList.add("is-dragging");
      });
      grip.addEventListener("pointermove", (e) => {
        if (!grip.hasPointerCapture(e.pointerId)) return;
        const width = frame.getBoundingClientRect().width;
        setValue(startValue + ((e.clientX - startX) / width) * 100);
      });
      const endDrag = (e: PointerEvent) => {
        if (grip.hasPointerCapture(e.pointerId)) grip.releasePointerCapture(e.pointerId);
        grip.classList.remove("is-dragging");
      };
      grip.addEventListener("pointerup", endDrag);
      grip.addEventListener("pointercancel", endDrag);
    }

    if (grip) {
      press(grip, () => {
        animate(grip, { scale: 1.15 }, { type: "spring", stiffness: 500, damping: 15, mass: 0.8 });
        return () => {
          animate(grip, { scale: 1 }, { type: "spring", stiffness: 400, damping: 12, mass: 1 });
        };
      });
    }

    // Intro: when the slider first scrolls into view, glide the handle across
    // to reveal more of each site, then settle in the middle.
    const glide = (from: number, to: number, duration: number) => {
      sweep = animate(from, to, {
        duration,
        ease: "easeInOut",
        onUpdate: (latest) => {
          range.value = String(Math.round(latest));
          update(latest);
        },
      });
      return sweep;
    };
    inView(
      frame,
      () => {
        const steps: [number, number][] = [[78, 1.1], [22, 1.3], [50, 0.9]];
        let from = Number(range.value);
        (async () => {
          for (const [to, duration] of steps) {
            const step = glide(from, to, duration);
            await step;
            if (sweep !== step) return; // stopped by the visitor
            from = to;
          }
          sweep = null;
        })();
      },
      { amount: 0.6 }
    );
  }
</script>
