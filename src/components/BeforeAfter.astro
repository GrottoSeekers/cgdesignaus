---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Real client redesign: Nigel's Hairdressing (Wigan & Rochdale).
// Full-page screenshots captured October 2026 (old Wix site archived in
// clients/nigels-hairdressing/archive/old-wix-site/). Phones get the
// phone-width captures so the text stays readable inside the frame.
const shots = {
  before: {
    desktop: `${base}/previews/nigels-before.webp`,
    mobile: `${base}/previews/nigels-before-mobile.webp`,
    alt: "Nigel's Hairdressing's old Wix website: orange header, stock photo hero and plain price list",
  },
  after: {
    desktop: `${base}/previews/nigels-after.webp`,
    mobile: `${base}/previews/nigels-after-mobile.webp`,
    alt: "Nigel's Hairdressing's new website by CG Design & Co.: chocolate and blush design with recent work, prices and FAQ",
  },
};
const liveUrl = "https://www.nigelshairdressingwiganandrochdale.com";
---

<section class="section" id="before-after">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Real redesign</span>
      <h2>Nigel's Hairdressing, before and after.</h2>
      <p>A mobile hairdresser in Wigan &amp; Rochdale, moved off a dated Wix template. Drag to compare the old site with the one we built.</p>
    </div>

    <div class="compare reveal">
      <div class="compare-frame" id="compare-frame">
        <div class="compare-scroll" id="compare-scroll">
          <div class="compare-overlay-pin">
            <div class="compare-overlay">
              <input
                type="range"
                class="compare-range"
                id="compare-range"
                min="0"
                max="100"
                value="46"
                step="1"
                aria-label="Drag to compare Nigel's Hairdressing's old Wix website with the new one"
              />
              <div class="compare-handle" id="compare-handle">
                <span class="handle-line"></span>
                <span class="handle-grip">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7 3 12l5 5M16 7l5 5-5 5"/></svg>
                </span>
              </div>
              <span class="scroll-hint">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
                Scroll inside to see the whole page
              </span>
            </div>
          </div>

          <div class="compare-stack">
            <div class="compare-after">
              <div class="compare-pin"><span class="compare-badge badge-after">After<span class="badge-more">: built by CG Design</span></span></div>
              <picture class="compare-shot">
                <source media="(max-width: 640px)" srcset={shots.after.mobile} width="390" height="6874" />
                <img src={shots.after.desktop} alt={shots.after.alt} width="1440" height="5449" loading="lazy" decoding="async" />
              </picture>
            </div>

            <div class="compare-before" id="compare-before">
              <div class="compare-pin"><span class="compare-badge badge-before">Before<span class="badge-more">: old Wix site</span></span></div>
              <picture class="compare-shot">
                <source media="(max-width: 640px)" srcset={shots.before.mobile} width="390" height="3198" />
                <img src={shots.before.desktop} alt={shots.before.alt} width="1440" height="4330" loading="lazy" decoding="async" />
              </picture>
            </div>
          </div>
        </div>
      </div>
      <p class="compare-hint">Drag the handle to compare · scroll inside the frame to read both pages top to bottom · <a href={liveUrl} target="_blank" rel="noopener noreferrer">See the live site →</a></p>
    </div>
  </div>
</section>

<style>
  .compare {
    max-width: 980px;
    margin: 0 auto;
  }

  .compare-frame {
    --pos: 46%;
    position: relative;
    height: clamp(360px, 48vw, 470px);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    background: var(--accent-2);
    -webkit-user-select: none;
    user-select: none;
  }

  .compare-scroll {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
  }

  .compare-overlay-pin {
    position: sticky;
    top: 0;
    height: 0;
    z-index: 6;
  }

  .compare-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: clamp(360px, 48vw, 470px);
    pointer-events: none;
  }

  .compare-stack {
    position: relative;
  }

  /* The "after" screenshot sets the scroll height; the "before" one sits on
     top of it and is clipped to the left of the handle. */
  .compare-after {
    position: relative;
    z-index: 1;
  }

  .compare-before {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #fff;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
    will-change: clip-path;
  }

  .compare-shot,
  .compare-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .compare-pin {
    position: sticky;
    top: 0;
    height: 0;
    z-index: 3;
  }

  .compare-badge {
    position: absolute;
    top: 16px;
    display: inline-flex;
    align-items: center;
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
    box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.5);
  }

  .badge-after {
    right: 16px;
    background: var(--accent-2);
    color: #fff;
  }

  .badge-before {
    left: 16px;
    background: var(--error);
    color: #fff;
  }

  /* ---- Drag handle ---- */
  .compare-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    z-index: 3;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .handle-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: var(--bg);
    box-shadow: 0 0 0 1px rgba(20, 17, 26, 0.2);
  }

  .handle-grip {
    position: relative;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--bg);
    color: var(--accent-2);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 26px -8px rgba(0, 0, 0, 0.5);
  }

  .handle-grip svg {
    width: 20px;
    height: 20px;
  }

  .compare-range {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    pointer-events: auto;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
  }

  .compare-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: transparent;
  }

  .compare-range::-moz-range-thumb {
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: transparent;
  }

  .compare-range::-moz-range-track {
    background: transparent;
    border: none;
  }

  .compare-range:focus-visible ~ .compare-handle .handle-grip {
    outline: 3px solid var(--accent-2);
    outline-offset: 3px;
  }

  .scroll-hint {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(20, 17, 26, 0.72);
    color: var(--paper-on-dark);
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    backdrop-filter: blur(6px);
  }

  .scroll-hint svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  .compare-hint {
    text-align: center;
    margin: 16px 0 0;
    font-size: 0.82rem;
    color: var(--text-faint);
  }

  @media (max-width: 640px) {
    .badge-more { display: none; }
    .compare-badge { top: 12px; padding: 6px 12px; }
    .badge-before { left: 12px; }
    .badge-after { right: 12px; }
  }

  .compare-hint a {
    color: inherit;
    font-weight: 700;
  }
</style>

<script>
  import { animate, press } from "motion";
  import { prefersReducedMotion } from "../lib/motion-utils.js";

  const frame = document.getElementById("compare-frame");
  const range = document.getElementById("compare-range") as HTMLInputElement | null;
  const grip = document.querySelector<HTMLElement>(".handle-grip");

  let pendingFrame = 0;

  const update = (value: string) => {
    frame?.style.setProperty("--pos", `${value}%`);
  };

  const scheduleUpdate = (value: string) => {
    if (pendingFrame) cancelAnimationFrame(pendingFrame);
    pendingFrame = requestAnimationFrame(() => {
      pendingFrame = 0;
      update(value);
    });
  };

  if (range) {
    update(range.value);
    range.addEventListener("input", () => scheduleUpdate(range.value));

    if (grip && !prefersReducedMotion()) {
      press(range, () => {
        animate(grip, { scale: 1.15 }, { type: "spring", stiffness: 500, damping: 15, mass: 0.8 });
        return () => {
          animate(grip, { scale: 1 }, { type: "spring", stiffness: 400, damping: 12, mass: 1 });
        };
      });
    }
  }
</script>
