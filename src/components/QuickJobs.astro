---
// Fixed-price setup jobs for businesses that don't need a whole website.
// Prices live in src/lib/pricing.ts.
import { quickJobs, starterBundle, selfEdit, maintenancePrice, aud } from "../lib/pricing";
import { contactHref } from "../lib/prefill";

interface Props {
  /** "h1" when this section opens its own page. */
  heading?: "h1" | "h2";
}
const { heading: Heading = "h2" } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const priceLabel = (j: { price: number; per?: string }) => `${aud(j.price)}${j.per ? ` ${j.per}` : ""}`;
const askHref = (name: string, price: string) =>
  contactHref(base, { service: "Quick Job", pick: name, price, details: `Quick job: ${name} — ${price}` });
const saving = starterBundle.separately - starterBundle.price;
const selfEditPrice = `${aud(selfEdit.price)} + ${aud(maintenancePrice)}/mo`;
---

<section id="quick-jobs" style="position: relative; padding: 112px 0 104px; background: #ffffff">
<div class="wrap" style="position: relative">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; margin-bottom: 40px">
<div style="max-width: 660px">
<span class="eyebrow">Quick jobs</span>
<Heading style="font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; margin-top: 16px">Just need a hand with <em style="font-style: italic; font-weight: 600; color: #5b2a96">something smaller?</em></Heading>
</div>
<p style="max-width: 380px; color: rgba(20,17,26,0.68); font-size: 1rem">Fixed prices, paid upfront, usually done within a few days. Everything is set up in your name, so it's 100% yours.</p>
</div>

<div class="jobs">
{quickJobs.map((j) => (
<div class="job-card">
<h3 class="job-name">{j.name}</h3>
<p class="job-price">{aud(j.price)}{j.per && <span class="job-per"> {j.per}</span>}</p>
<p class="job-desc">{j.desc}</p>
<a href={askHref(j.name, priceLabel(j))} class="job-ask">Ask for this <span aria-hidden="true">→</span></a>
</div>
))}
</div>

<div class="self-edit">
<div class="self-edit-copy">
<span class="self-edit-tag">New · Edit it yourself</span>
<h3 class="self-edit-name">{selfEdit.name}</h3>
<p class="self-edit-sub">Update your own website whenever you like, without waiting on us.</p>
<ul class="self-edit-list">
{selfEdit.includes.map((line) => <li><span class="tick" aria-hidden="true">✓</span>{line}</li>)}
</ul>
<div class="self-edit-buy">
<p class="self-edit-price">{aud(selfEdit.price)} <span>setup</span></p>
<p class="self-edit-note">Comes with the {aud(maintenancePrice)}/month hosting &amp; maintenance plan.</p>
<a href={askHref(selfEdit.name, selfEditPrice)} class="job-ask">Ask for this <span aria-hidden="true">→</span></a>
</div>
</div>
<div class="self-edit-mock" aria-hidden="true">
<div class="mock-window">
<p class="mock-url">yourbusiness.com.au/admin</p>
<p class="mock-title">Sign in</p>
<span class="mock-label">Email</span>
<span class="mock-input">you@yourbusiness.com.au</span>
<span class="mock-label">Password</span>
<span class="mock-input">••••••••••</span>
<span class="mock-btn">Sign in</span>
</div>
</div>
</div>

<div class="bundle">
<div class="bundle-copy">
<span class="bundle-tag">Best value</span>
<h3 class="bundle-name">{starterBundle.name}</h3>
<p class="bundle-sub">Everything a new business needs to be found and look the part.</p>
<ul class="bundle-list">
{starterBundle.includes.map((line) => <li><span class="bundle-tick" aria-hidden="true">✓</span>{line}</li>)}
</ul>
</div>
<div class="bundle-buy">
<p class="bundle-price"><span class="sr-only">{aud(starterBundle.price)}, instead of {aud(starterBundle.separately)}</span><span aria-hidden="true" class="bundle-count" data-from={starterBundle.separately} data-to={starterBundle.price}>{aud(starterBundle.price)}</span> <span aria-hidden="true" class="bundle-was">{aud(starterBundle.separately)}</span></p>
<p class="bundle-save">Save {aud(saving)} on doing them one by one. Domain cost extra.</p>
<a href={askHref(starterBundle.name, aud(starterBundle.price))} class="btn btn-violet">Get the starter bundle</a>
</div>
</div>

<p class="jobs-more">Need something else? <a href="https://wa.me/447306100251" target="_blank" rel="noopener noreferrer">Just ask on WhatsApp</a> and we'll give you a fixed price.</p>
</div>
</section>

<style>
  .jobs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }

  .job-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border-radius: 22px;
    background: #f3f0f8;
    border: 1px solid rgba(20, 17, 26, 0.08);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s, border-color 0.35s;
  }

  @media (hover: hover) {
    .job-card:hover {
      transform: translateY(-6px);
      border-color: rgba(91, 42, 150, 0.3);
      box-shadow: 0 30px 56px -34px rgba(47, 17, 71, 0.45);
    }
  }

  .job-name {
    font-size: 1.2rem;
  }

  .job-price {
    font-family: "Fraunces", serif;
    font-size: 2.2rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #2f1147;
  }

  .job-per {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0;
    color: rgba(20, 17, 26, 0.6);
  }

  .job-desc {
    flex: 1;
    font-size: 0.94rem;
    color: rgba(20, 17, 26, 0.68);
  }

  .job-ask {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    align-self: flex-start;
    min-height: 44px;
    font-weight: 700;
    font-size: 0.92rem;
    color: #5b2695;
    text-decoration: none;
    transition: gap 0.25s ease, color 0.25s ease;
  }

  @media (hover: hover) {
    .job-ask:hover {
      gap: 12px;
      color: #2f1147;
    }
  }

  .self-edit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px 48px;
    margin-top: 24px;
    padding: 36px;
    border-radius: 24px;
    background: #f3f0f8;
    border: 1px solid rgba(91, 42, 150, 0.22);
  }

  .self-edit-copy {
    flex: 1 1 420px;
  }

  .self-edit-tag {
    display: inline-block;
    margin-bottom: 10px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5b2695;
  }

  .self-edit-name {
    font-size: 1.6rem;
  }

  .self-edit-sub {
    margin-top: 6px;
    font-size: 0.95rem;
    color: rgba(20, 17, 26, 0.68);
  }

  .self-edit-list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
    font-size: 0.92rem;
    color: rgba(20, 17, 26, 0.78);
  }

  .self-edit-list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .self-edit-buy {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    margin-top: 20px;
  }

  .self-edit-price {
    font-family: "Fraunces", serif;
    font-size: 2.2rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #2f1147;
  }

  .self-edit-price span {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0;
    color: rgba(20, 17, 26, 0.6);
  }

  .self-edit-note {
    flex-basis: 100%;
    order: 3;
    font-size: 0.86rem;
    color: rgba(20, 17, 26, 0.6);
  }

  /* A small, non-interactive picture of the sign-in screen. */
  .self-edit-mock {
    flex: 0 1 300px;
  }

  .mock-window {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px;
    border-radius: 18px;
    background: #ffffff;
    border: 1px solid rgba(20, 17, 26, 0.1);
    box-shadow: 0 40px 70px -40px rgba(47, 17, 71, 0.55);
    transform: rotate(1.5deg);
  }

  .mock-url {
    margin-bottom: 8px;
    padding: 5px 10px;
    border-radius: 8px;
    background: #f3f0f8;
    font-size: 0.68rem;
    font-weight: 600;
    color: rgba(20, 17, 26, 0.55);
    text-align: center;
  }

  .mock-title {
    margin-bottom: 4px;
    font-family: "Fraunces", serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .mock-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: rgba(20, 17, 26, 0.6);
  }

  .mock-input {
    padding: 9px 12px;
    border-radius: 10px;
    border: 1px solid rgba(20, 17, 26, 0.14);
    font-size: 0.8rem;
    color: rgba(20, 17, 26, 0.7);
  }

  .mock-btn {
    margin-top: 8px;
    padding: 10px;
    border-radius: 999px;
    background: #5b2a96;
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    text-align: center;
  }

  @media (max-width: 760px) {
    .self-edit-mock {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .self-edit {
      padding: 26px 22px;
    }

    .self-edit-list {
      grid-template-columns: 1fr;
    }
  }

  .bundle {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px 48px;
    margin-top: 24px;
    padding: 36px;
    border-radius: 24px;
    background: #2f1147;
    color: #f3eefa;
  }

  .bundle-copy {
    flex: 1 1 460px;
  }

  .bundle-tag {
    display: inline-block;
    margin-bottom: 10px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #d8bff0;
  }

  .bundle-name {
    font-size: 1.6rem;
    color: #ffffff;
  }

  .bundle-sub {
    margin-top: 6px;
    font-size: 0.95rem;
    color: rgba(243, 238, 250, 0.78);
  }

  .bundle-list {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
    font-size: 0.92rem;
    color: rgba(243, 238, 250, 0.9);
  }

  .bundle-list li {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .bundle-tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 50%;
    background: rgba(124, 79, 199, 0.45);
    color: #ffffff;
    font-size: 0.7rem;
  }

  .bundle-buy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 0 1 280px;
  }

  .bundle-price {
    font-family: "Fraunces", serif;
    font-size: 3.2rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .bundle-was {
    position: relative;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0;
    color: rgba(243, 238, 250, 0.55);
    vertical-align: middle;
  }

  /* The strike draws across once the count-down lands (see the script below). */
  .bundle-was::after {
    content: "";
    position: absolute;
    left: -2px;
    right: -2px;
    top: 52%;
    height: 2px;
    background: currentColor;
    transform-origin: left center;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bundle.pre .bundle-was::after {
    transform: scaleX(0);
  }

  .bundle-save {
    margin-bottom: 8px;
    font-size: 0.86rem;
    color: rgba(243, 238, 250, 0.7);
  }

  .jobs-more {
    margin-top: 28px;
    text-align: center;
    font-size: 0.95rem;
    color: rgba(20, 17, 26, 0.68);
  }

  .jobs-more a {
    font-weight: 700;
    color: #5b2695;
  }

  @media (max-width: 560px) {
    .job-card {
      padding: 24px;
    }

    .bundle {
      padding: 28px 24px;
    }

    .bundle-list {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // The bundle counts down from the one-by-one price to the bundle price as it scrolls in,
  // then the old price is struck through (the same idea as the packages on Pricing).
  import { animate, inView } from "motion";
  import { prefersReducedMotion } from "../lib/motion-utils.js";

  const bundle = document.querySelector<HTMLElement>(".bundle");
  const count = bundle?.querySelector<HTMLElement>(".bundle-count");
  // If any of the bundle shows when the page opens, count down right after the page
  // fade-in; otherwise start as soon as it scrolls into view.
  if (bundle && count && !prefersReducedMotion()) {
    const from = Number(count.dataset.from);
    const to = Number(count.dataset.to);
    const aud = (n: number) => `$${Math.round(n).toLocaleString("en-AU")}`;
    const r = bundle.getBoundingClientRect();
    const visibleAtLoad = r.top < window.innerHeight && r.bottom > 0;
    bundle.classList.add("pre");
    count.textContent = aud(from);
    const countDown = (box: HTMLElement, el: HTMLElement) =>
      animate(from, to, {
        duration: 1.2,
        ease: [0.33, 1, 0.68, 1],
        onUpdate: (v) => (el.textContent = aud(v)),
        onComplete: () => {
          el.textContent = aud(to);
          box.classList.remove("pre");
        },
      });
    if (visibleAtLoad) window.setTimeout(() => countDown(bundle, count), 450);
    else inView(bundle, () => countDown(bundle, count), { amount: 0.3 });
  }
</script>
