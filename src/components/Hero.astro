---
import NigelStrands from "./NigelStrands.astro";

const img = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/previews`;

// Services only, no client names. Rendered twice so the marquee loops seamlessly.
const services = [
  "Custom website builds",
  "Website redesigns",
  "Local SEO",
  "Online booking systems",
  "Online stores",
  "Maintenance & hosting",
  "Copywriting & images included",
];
---

<section id="hero" class="hero-dark" style="position: relative; overflow: hidden; padding: 48px 0 0; background: #12071c; color: #f3eefa">
<div aria-hidden="true" style="position: absolute; inset: 0; pointer-events: none">
<div class="blob-a" style="position: absolute; width: 640px; height: 640px; border-radius: 50%; background: #5b2a96; opacity: 0.55; filter: blur(110px); top: -260px; right: -120px"></div>
<div class="blob-b" style="position: absolute; width: 520px; height: 520px; border-radius: 50%; background: #7c4fc7; opacity: 0.35; filter: blur(120px); bottom: -200px; left: -160px"></div>
<div class="blob-c" style="position: absolute; width: 360px; height: 360px; border-radius: 50%; background: #c58ef0; opacity: 0.18; filter: blur(100px); top: 30%; left: 38%"></div>
<div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(243,238,250,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(243,238,250,0.05) 1px, transparent 1px); background-size: 64px 64px; -webkit-mask-image: radial-gradient(ellipse at 60% 40%, #000 20%, transparent 75%); mask-image: radial-gradient(ellipse at 60% 40%, #000 20%, transparent 75%)"></div>
</div>
<div class="wrap" style="position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 64px; align-items: center; padding-bottom: 88px">
<div>
<span class="fade hero-badge" style="position: relative; display: inline-flex; align-items: center; gap: 12px; padding: 8px 18px 8px 12px; border-radius: 999px; background: linear-gradient(rgba(29,15,43,0.85), rgba(29,15,43,0.85)) padding-box, linear-gradient(120deg, rgba(216,191,240,0.55), rgba(124,79,199,0.15) 45%, rgba(216,191,240,0.4)) border-box; border: 1px solid transparent; box-shadow: 0 10px 30px -14px rgba(124,79,199,0.7), inset 0 1px 0 rgba(255,255,255,0.06); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #e9dcfa; margin-bottom: 28px; overflow: hidden; animation-delay: 0.05s">
<span class="live-dot" style="width: 8px; height: 8px; border-radius: 50%; background: #7cd68c; flex-shrink: 0"></span>
<span>Web design studio</span>
<span aria-hidden="true" style="width: 1px; height: 12px; background: rgba(216,191,240,0.3)"></span>
<span style="color: rgba(233,220,250,0.7)">Sydney, Australia</span>
</span>
<h1 style="font-weight: 500; font-size: clamp(3rem, 6.4vw, 5.6rem); line-height: 0.98; letter-spacing: -0.035em; margin: 0 0 28px; color: #ffffff">
<span class="line"><span style="animation-delay: 0.15s">Your business</span></span>
<span class="line"><span style="animation-delay: 0.28s">online in</span></span>
<span class="line" style="position: relative; padding-bottom: 0.18em"><span style="animation-delay: 0.41s"><em class="shimmer" style="font-style: italic; font-weight: 600">under a week.</em></span>
<svg class="underline" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true" style="position: absolute; left: 0; bottom: 0; width: min(100%, 9.2em); height: 0.22em; overflow: visible"><path d="M4 16 C 90 4, 200 4, 396 12" fill="none" stroke="#b58cf0" stroke-width="5" stroke-linecap="round"></path></svg></span>
</h1>
<p class="fade" style="font-size: 1.22rem; color: rgba(243,238,250,0.76); max-width: 30em; margin-bottom: 36px; animation-delay: 0.6s">Fast, mobile-first websites for local businesses — with a fixed price and a launch date agreed in writing before any work begins.</p>
<div class="fade" style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 44px; animation-delay: 0.72s">
<a href="#contact" class="btn btn-glow" style="min-height: 56px; padding: 0 32px; font-size: 1rem">Get your free website check <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
<a href="#client" class="btn btn-line" style="min-height: 56px; padding: 0 30px; font-size: 1rem">See our work</a>
</div>
<div class="fade" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; max-width: 520px; padding-top: 28px; border-top: 1px solid rgba(243,238,250,0.12); animation-delay: 0.84s">
<div style="display: flex; flex-direction: column; gap: 2px"><span class="hero-stat" style="font-family: 'Fraunces', serif; font-size: 2rem; font-weight: 600; color: #ffffff; line-height: 1.1">&lt;7 days</span><span style="font-size: 0.82rem; color: rgba(243,238,250,0.62)">From go-ahead to live</span></div>
<div style="display: flex; flex-direction: column; gap: 2px"><span class="hero-stat" style="font-family: 'Fraunces', serif; font-size: 2rem; font-weight: 600; color: #ffffff; line-height: 1.1">Fixed</span><span style="font-size: 0.82rem; color: rgba(243,238,250,0.62)">Price agreed up front</span></div>
<div style="display: flex; flex-direction: column; gap: 2px"><span class="hero-stat" style="font-family: 'Fraunces', serif; font-size: 2rem; font-weight: 600; color: #ffffff; line-height: 1.1">100%</span><span style="font-size: 0.82rem; color: rgba(243,238,250,0.62)">Yours to own</span></div>
</div>
</div>
<div style="position: relative; width: 100%; max-width: 580px; justify-self: end; padding: 24px 0 40px 24px; box-sizing: border-box">
<div class="bob">
<div class="browser" style="border-radius: 20px; overflow: hidden; border: 1px solid rgba(243,238,250,0.18); background: #1d0f2b; box-shadow: 0 60px 120px -40px rgba(0,0,0,0.8), 0 0 0 1px rgba(181,140,240,0.08), 0 0 80px -20px rgba(124,79,199,0.6)">
<div style="display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: rgba(255,255,255,0.06); border-bottom: 1px solid rgba(243,238,250,0.08)">
<span style="display: flex; gap: 6px"><span style="width: 10px; height: 10px; border-radius: 50%; background: #ff5f57"></span><span style="width: 10px; height: 10px; border-radius: 50%; background: #febc2e"></span><span style="width: 10px; height: 10px; border-radius: 50%; background: #28c840"></span></span>
<span style="flex: 1; margin: 0 24px; padding: 5px 10px; border-radius: 8px; background: rgba(255,255,255,0.07); text-align: center; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.03em; color: rgba(243,238,250,0.6); overflow: hidden; text-overflow: ellipsis; white-space: nowrap">nigelshairdressingwiganandrochdale.com</span>
</div>
<div style="position: relative; overflow: hidden; line-height: 0">
<img src={`${img}/nigels-desktop-base.webp`} width="1120" height="680" fetchpriority="high" alt="Nigel's Hairdressing homepage: 'Beautiful hair, done at home.'" style="display: block; width: 100%; height: auto">
<NigelStrands box={{ left: 42, top: 9.382, width: 58, height: 70.977 }} delay={0.9} />
</div>
</div>
</div>
<div class="phone" style="position: absolute; bottom: 0; left: -18px; width: 128px; padding: 6px; border-radius: 24px; background: #0b0512; border: 1px solid rgba(243,238,250,0.2); box-shadow: 0 40px 60px -24px rgba(0,0,0,0.8)">
<div style="position: relative; overflow: hidden; border-radius: 18px; line-height: 0">
<img src={`${img}/nigels-hero-base.webp`} width="760" height="1652" fetchpriority="high" alt="Nigel's Hairdressing on a phone" style="display: block; width: 100%; height: auto">
<NigelStrands box={{ left: 0, top: 8.2324, width: 100, height: 36.3196 }} delay={1.3} />
</div>
</div>
</div>
</div>
<div aria-hidden="true" style="position: relative; border-top: 1px solid rgba(243,238,250,0.1); background: rgba(0,0,0,0.25); overflow: hidden; padding: 18px 0; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent)">
<div class="marquee-track" style="display: flex; gap: 48px; width: max-content; font-family: 'Fraunces', serif; font-size: 1.3rem; font-style: italic; color: rgba(243,238,250,0.55); white-space: nowrap">
{[0, 1].map(() => services.map((s) => (<><span>{s}</span><span style="color: #7c4fc7">✦</span></>)))}
</div>
</div>
</section>
