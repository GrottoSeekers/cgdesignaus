---
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const trustItems = [
  "Fixed price up front",
  "Live in under a week",
  "You own everything",
  "Remote in any timezone",
];
---

<section class="hero" id="hero">
  <div class="orb orb-a" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <div class="hero-copy stagger">
      <span class="eyebrow">Web design studio · Sydney, Australia</span>
      <h1>Your business online in <em>under a week.</em></h1>
      <p class="lead">
        Fast, mobile-first websites for local businesses — with a fixed
        price and a delivery date agreed before a single pixel is drawn.
      </p>

      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">
          Get your free website check
          <Icon name="arrow-right" class="btn-icon" />
        </a>
        <a href="#client" class="btn btn-ghost">See our work</a>
      </div>

      <div class="trust-row">
        {trustItems.map((item) => (
          <span class="trust-item"><span class="trust-dot"></span>{item}</span>
        ))}
      </div>
    </div>

    <div class="hero-visual">
      <div class="browser-frame">
        <span class="browser-bar" aria-hidden="true">
          <span class="traffic-lights"><span></span><span></span><span></span></span>
          <span class="browser-url">nigelshairdressingwiganandrochdale.com</span>
        </span>
        <a
          href="https://www.nigelshairdressingwiganandrochdale.com"
          target="_blank"
          rel="noopener noreferrer"
          class="browser-body"
          aria-label="Visit Nigel's Hairdressing, a site we built"
        >
          <img
            src={`${base}/previews/nigels-desktop.webp`}
            alt="Nigel's Hairdressing homepage: 'Beautiful hair, done at home.' with call and price buttons"
            loading="eager"
            width="1120"
            height="680"
          />
        </a>
      </div>

      <div class="phone-inset">
        <img
          src={`${base}/previews/nigels-hero.webp`}
          alt="Nigel's Hairdressing on a phone"
          loading="eager"
          width="760"
          height="1652"
        />
      </div>

      <span class="mobile-badge">
        <span class="badge-dot"></span>
        Built mobile-first
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(56px, 7vw, 96px) 0 clamp(64px, 8vw, 104px);
    position: relative;
    overflow: hidden;
  }

  .orb {
    width: 520px;
    height: 520px;
    filter: blur(90px);
  }

  .orb-a {
    background: var(--accent);
    top: -220px;
    right: -160px;
    opacity: 0.16;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }

  .eyebrow {
    margin-bottom: 22px;
  }

  h1 {
    font-weight: 500;
    font-size: clamp(2.7rem, 5.6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0 0 22px;
    text-wrap: pretty;
  }

  h1 em {
    font-style: italic;
    font-weight: 600;
    color: var(--accent-2);
  }

  .lead {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: rgba(20, 17, 26, 0.72);
    max-width: 31em;
    margin: 0 0 32px;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .hero-actions .btn-primary,
  .hero-actions .btn-ghost {
    min-height: 52px;
    padding: 0 30px;
  }

  .btn-icon {
    width: 16px;
    height: 16px;
  }

  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }

  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.88rem;
    font-weight: 600;
    color: rgba(20, 17, 26, 0.72);
  }

  .trust-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 520px;
    justify-self: end;
  }

  .browser-frame {
    display: block;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(20, 17, 26, 0.16);
    background: var(--bg-raised);
    box-shadow: 0 40px 80px -40px rgba(20, 17, 26, 0.4);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.3s ease;
  }

  .browser-frame:hover {
    transform: translateY(-4px);
    border-color: var(--accent-2);
    box-shadow: 0 30px 60px -20px rgba(20, 17, 26, 0.35);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    background: var(--bg-raised-2);
    border-bottom: 1px solid rgba(20, 17, 26, 0.08);
  }

  .traffic-lights {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .traffic-lights span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(20, 17, 26, 0.22);
  }

  .browser-url {
    flex: 1;
    text-align: center;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(20, 17, 26, 0.5);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser-body {
    display: block;
    line-height: 0;
  }

  .browser-body img {
    width: 100%;
    height: auto;
    display: block;
  }

  .phone-inset {
    position: absolute;
    bottom: -26px;
    left: -14px;
    width: 104px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(20, 17, 26, 0.18);
    background: var(--bg-raised);
    box-shadow: 0 24px 44px -22px rgba(20, 17, 26, 0.5);
  }

  .phone-inset img {
    display: block;
    width: 100%;
    height: auto;
  }

  .mobile-badge {
    position: absolute;
    top: -14px;
    right: -8px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 15px;
    border-radius: 999px;
    background: var(--accent-2);
    color: var(--paper-on-dark);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 14px 30px -14px rgba(20, 17, 26, 0.7);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-on-dark);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .hero-visual {
      justify-self: stretch;
      max-width: 100%;
      margin-top: 24px;
    }
  }
</style>
