---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Each link opens its own page; the free business check is the button.
const navItems = [
  { href: `${base}/work`, label: "Work" },
  { href: `${base}/pricing`, label: "Pricing" },
  { href: `${base}/quick-jobs`, label: "Quick jobs" },
  { href: `${base}/how-it-works`, label: "How it works" },
];

const drawerItems = [{ href: `${base}/`, label: "Home" }, ...navItems, { href: `${base}/contact`, label: "Contact" }];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => (href.replace(/\/$/, "") || "/") === path;
---

<header class="site-header" style="position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,0.86); -webkit-backdrop-filter: blur(16px) saturate(1.4); backdrop-filter: blur(16px) saturate(1.4); border-bottom: 1px solid rgba(20,17,26,0.08)">
<div class="scroll-bar" aria-hidden="true" style="position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; background: linear-gradient(90deg, #5b2a96, #b58cf0); transform-origin: left; transform: scaleX(0)"></div>
<div style="display: flex; align-items: center; gap: 28px; height: 70px; padding: 0 32px; max-width: 1440px; margin: 0 auto; box-sizing: border-box">
<a href={`${base}/`} aria-label="CG Design &amp; Co. home" style="display: inline-flex; flex-shrink: 0"><img src={`${base}/logo-full.png?v=2`} alt="CG Design &amp; Co." width="566" height="241" style="height: 34px; width: auto; display: block"></a>
<nav class="nav-links" aria-label="Primary" style="display: flex; gap: 2px; margin-left: auto; padding: 4px; border-radius: 999px; background: rgba(47,17,71,0.04); border: 1px solid rgba(20,17,26,0.06)">
{navItems.map((item) => (
<a href={item.href} class:list={["nav-link", { active: isCurrent(item.href) }]} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
))}
</nav>
<a href={`${base}/contact`} class="nav-cta" style="display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 22px; border-radius: 9999px; background: #2f1147; color: #ffffff; font-weight: 700; font-size: 0.9rem; text-decoration: none; white-space: nowrap">Free business check <svg class="cta-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
<button type="button" class="menu-btn" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-drawer" style="display: none; margin-left: auto; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; border-radius: 12px; border: 1px solid rgba(20,17,26,0.16); background: transparent; padding: 0 12px; box-sizing: border-box"><span style="display: block; height: 2px; background: #14111a"></span><span style="display: block; height: 2px; background: #14111a"></span><span style="display: block; height: 2px; background: #14111a"></span></button>
</div>
</header>

<a href={`${base}/contact`} class="mobile-cta" id="mobile-cta" aria-hidden="true" tabindex="-1" data-path={path}>Get your free business check <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>

<div class="drawer" id="nav-drawer" aria-hidden="true" inert>
  <button type="button" class="drawer-close" id="drawer-close" aria-label="Close menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
  </button>
  <nav class="drawer-nav" aria-label="Mobile">
    {drawerItems.map((item) => (
      <a href={item.href} class:list={["drawer-link", { active: isCurrent(item.href) }]} aria-current={isCurrent(item.href) ? "page" : undefined} data-drawer-link>{item.label}</a>
    ))}
  </nav>
  <a href={`${base}/contact`} class="drawer-cta" data-drawer-link>Free business check</a>
</div>

<style>
  /* Phones only: a slim call to action pinned to the bottom once you've scrolled a bit. */
  .mobile-cta {
    display: none;
  }

  @media (max-width: 760px) {
    .mobile-cta {
      position: fixed;
      left: 16px;
      right: 16px;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 52px;
      border-radius: 999px;
      background: #2f1147;
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      box-shadow: 0 18px 40px -14px rgba(47, 17, 71, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.08);
      transform: translateY(160%);
    }
  }

  .menu-btn {
    cursor: pointer;
  }

  .menu-btn span {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-btn.is-open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-btn.is-open span:nth-child(2) {
    opacity: 0;
  }

  .menu-btn.is-open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    background: rgba(255, 255, 255, 0.98);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .drawer.open {
    opacity: 1;
    visibility: visible;
  }

  .drawer-close {
    position: absolute;
    top: calc(20px + env(safe-area-inset-top, 0px));
    right: 20px;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(20, 17, 26, 0.16);
    background: transparent;
    color: #14111a;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .drawer-close:hover {
    border-color: #2f1147;
    color: #2f1147;
  }

  .drawer-close svg {
    width: 20px;
    height: 20px;
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .drawer-link {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 7vw, 2.6rem);
    letter-spacing: -0.01em;
    color: #14111a;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .drawer-link:hover {
    color: #2f1147;
  }

  /* the page you're on */
  .drawer-link.active {
    color: #5b2a96;
    font-style: italic;
  }

  .drawer-cta {
    display: inline-flex;
    align-items: center;
    min-height: 50px;
    padding: 0 40px;
    border-radius: 9999px;
    background: #2f1147;
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
  }
</style>

<script>
  import { animate } from "motion";
  import { prefersReducedMotion, SPRING_SNAPPY } from "../lib/motion-utils.js";

  const toggle = document.getElementById("menu-toggle");
  const drawer = document.getElementById("nav-drawer");
  const closeBtn = document.getElementById("drawer-close");
  const drawerLinks = Array.from(drawer?.querySelectorAll<HTMLElement>("[data-drawer-link]") ?? []);

  const openDrawer = () => {
    if (!drawer) return;
    drawer.classList.add("open");
    drawer.setAttribute("aria-hidden", "false");
    drawer.inert = false;
    toggle?.classList.add("is-open");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    closeBtn?.focus();

    if (prefersReducedMotion()) return;
    drawerLinks.forEach((el, i) => {
      animate(el, { opacity: [0, 1], y: [24, 0] }, { ...SPRING_SNAPPY, delay: i * 0.06 });
    });
  };

  const closeDrawer = () => {
    if (!drawer?.classList.contains("open")) return;
    drawer.classList.remove("open");
    drawer.setAttribute("aria-hidden", "true");
    drawer.inert = true;
    toggle?.classList.remove("is-open");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  toggle?.addEventListener("click", () => (drawer?.classList.contains("open") ? closeDrawer() : openDrawer()));

  // ---- Phones: bottom call-to-action bar ----
  // Shows after the first screen; steps aside while the page's own call to action, the
  // footer or the cookie notice is on screen, and never shows on the contact page.
  const bar = document.getElementById("mobile-cta");
  if (bar && bar.dataset.path !== "/contact" && window.matchMedia("(max-width: 760px)").matches) {
    const blockers = new Set<Element>();
    const watch = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? blockers.add(e.target) : blockers.delete(e.target)));
      update();
    });
    document.querySelectorAll(".cta-band-wrap, .site-footer, #contact").forEach((el) => watch.observe(el));
    const cookie = document.getElementById("cookie-banner");

    let shown = false;
    function update() {
      const want = window.scrollY > window.innerHeight * 0.75 && blockers.size === 0 && !cookie?.classList.contains("is-visible");
      if (!bar || want === shown) return;
      shown = want;
      bar.setAttribute("aria-hidden", String(!want));
      bar.tabIndex = want ? 0 : -1;
      if (prefersReducedMotion()) bar.style.transform = want ? "none" : "translateY(160%)";
      else animate(bar, { y: want ? "0%" : "160%" }, want ? SPRING_SNAPPY : { duration: 0.25, ease: "easeIn" });
    }
    window.addEventListener("scroll", update, { passive: true });
    if (cookie) new MutationObserver(update).observe(cookie, { attributes: true, attributeFilter: ["class"] });
    update();
  }
  closeBtn?.addEventListener("click", () => {
    closeDrawer();
    toggle?.focus();
  });
  drawerLinks.forEach((link) => link.addEventListener("click", closeDrawer));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeDrawer();
  });
</script>
