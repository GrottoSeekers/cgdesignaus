---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Links follow the page's section order (Contact is the button).
const navItems = [
  { id: "client", label: "Work" },
  { id: "before-after", label: "Redesign" },
  { id: "pricing", label: "Pricing" },
  { id: "process", label: "Process" },
  { id: "faq", label: "FAQ" },
];

const drawerItems = [{ id: "hero", label: "Home" }, ...navItems, { id: "contact", label: "Contact" }];
---

<header class="site-header" style="position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,0.86); -webkit-backdrop-filter: blur(16px) saturate(1.4); backdrop-filter: blur(16px) saturate(1.4); border-bottom: 1px solid rgba(20,17,26,0.08)">
<div class="scroll-bar" aria-hidden="true" style="position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; background: linear-gradient(90deg, #5b2a96, #b58cf0); transform-origin: left; transform: scaleX(0)"></div>
<div style="display: flex; align-items: center; gap: 28px; height: 70px; padding: 0 32px; max-width: 1440px; margin: 0 auto; box-sizing: border-box">
<a href="#hero" aria-label="CG Design &amp; Co. home" style="display: inline-flex; flex-shrink: 0"><img src={`${base}/logo-full.png`} alt="CG Design &amp; Co." width="566" height="241" style="height: 34px; width: auto; display: block"></a>
<nav class="nav-links" aria-label="Primary" style="display: flex; gap: 2px; margin-left: auto; padding: 4px; border-radius: 999px; background: rgba(47,17,71,0.04); border: 1px solid rgba(20,17,26,0.06)">
{navItems.map((item, i) => (
<a href={`#${item.id}`} class:list={["nav-link", { active: i === 0 }]} data-section={item.id}>{item.label}</a>
))}
</nav>
<a href="#contact" class="nav-cta" style="display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 22px; border-radius: 9999px; background: #2f1147; color: #ffffff; font-weight: 700; font-size: 0.9rem; text-decoration: none; white-space: nowrap">Free website check <svg class="cta-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
<button type="button" class="menu-btn" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-drawer" style="display: none; margin-left: auto; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; border-radius: 12px; border: 1px solid rgba(20,17,26,0.16); background: transparent; padding: 0 12px; box-sizing: border-box"><span style="display: block; height: 2px; background: #14111a"></span><span style="display: block; height: 2px; background: #14111a"></span><span style="display: block; height: 2px; background: #14111a"></span></button>
</div>
</header>

<div class="drawer" id="nav-drawer" aria-hidden="true" inert>
  <button type="button" class="drawer-close" id="drawer-close" aria-label="Close menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
  </button>
  <nav class="drawer-nav" aria-label="Mobile">
    {drawerItems.map((item) => (
      <a href={`#${item.id}`} class="drawer-link" data-drawer-link data-section={item.id === "hero" ? undefined : item.id}>{item.label}</a>
    ))}
  </nav>
  <a href="#contact" class="drawer-cta" data-drawer-link>Free website check</a>
</div>

<style>
  .menu-btn {
    cursor: pointer;
  }

  .menu-btn span {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-btn.is-open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-btn.is-open span:nth-child(2) {
    opacity: 0;
  }

  .menu-btn.is-open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    background: rgba(255, 255, 255, 0.98);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .drawer.open {
    opacity: 1;
    visibility: visible;
  }

  .drawer-close {
    position: absolute;
    top: calc(20px + env(safe-area-inset-top, 0px));
    right: 20px;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(20, 17, 26, 0.16);
    background: transparent;
    color: #14111a;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .drawer-close:hover {
    border-color: #2f1147;
    color: #2f1147;
  }

  .drawer-close svg {
    width: 20px;
    height: 20px;
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .drawer-link {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 7vw, 2.6rem);
    letter-spacing: -0.01em;
    color: #14111a;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .drawer-link:hover {
    color: #2f1147;
  }

  /* the section you're reading */
  .drawer-link.active {
    color: #5b2a96;
    font-style: italic;
  }

  .drawer-cta {
    display: inline-flex;
    align-items: center;
    min-height: 50px;
    padding: 0 40px;
    border-radius: 9999px;
    background: #2f1147;
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
  }
</style>

<script>
  import { animate } from "motion";
  import { prefersReducedMotion, SPRING_SNAPPY } from "../lib/motion-utils.js";

  const toggle = document.getElementById("menu-toggle");
  const drawer = document.getElementById("nav-drawer");
  const closeBtn = document.getElementById("drawer-close");
  const drawerLinks = Array.from(drawer?.querySelectorAll<HTMLElement>("[data-drawer-link]") ?? []);

  const openDrawer = () => {
    if (!drawer) return;
    drawer.classList.add("open");
    drawer.setAttribute("aria-hidden", "false");
    drawer.inert = false;
    toggle?.classList.add("is-open");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    closeBtn?.focus();

    if (prefersReducedMotion()) return;
    drawerLinks.forEach((el, i) => {
      animate(el, { opacity: [0, 1], y: [24, 0] }, { ...SPRING_SNAPPY, delay: i * 0.06 });
    });
  };

  const closeDrawer = () => {
    if (!drawer?.classList.contains("open")) return;
    drawer.classList.remove("open");
    drawer.setAttribute("aria-hidden", "true");
    drawer.inert = true;
    toggle?.classList.remove("is-open");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  toggle?.addEventListener("click", () => (drawer?.classList.contains("open") ? closeDrawer() : openDrawer()));
  closeBtn?.addEventListener("click", () => {
    closeDrawer();
    toggle?.focus();
  });
  drawerLinks.forEach((link) => link.addEventListener("click", closeDrawer));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeDrawer();
  });
</script>
