---
// Dot rail on the right edge (desktop only). The active dot and the white
// "on-dark" state are driven by src/scripts/home.ts.
const items = [
  { id: "client", label: "Work" },
  { id: "before-after", label: "Redesign" },
  { id: "pricing", label: "Pricing" },
  { id: "process", label: "Process" },
  { id: "faq", label: "FAQ" },
  { id: "contact", label: "Contact" },
];
---

<nav class="snav" id="snav" aria-label="Page sections" style="position: fixed; right: 28px; top: 50%; transform: translateY(-50%); z-index: 40; display: flex; flex-direction: column; align-items: center; gap: 18px">
<div aria-hidden="true" class="snav-rail" style="position: absolute; top: 6px; bottom: 6px; left: 3px; width: 1px; background: rgba(20,17,26,0.1); z-index: -1"></div>
{items.map((item, i) => (
<a href={`#${item.id}`} class:list={["dot", { active: i === 0 }]} data-section={item.id}><span class="dot-marker"></span><span class="dot-label">{item.label}</span></a>
))}
</nav>
