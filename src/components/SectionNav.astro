---
const items = [
  { id: "client", label: "Client" },
  { id: "before-after", label: "Redesign" },
  { id: "pricing", label: "Pricing" },
  { id: "process", label: "Process" },
  { id: "faq", label: "FAQ" },
  { id: "contact", label: "Contact" },
];
---

<nav class="section-nav" aria-label="Page sections">
  <div class="rail"></div>
  {items.map((item) => (
    <a href={`#${item.id}`} class="dot" data-section={item.id}>
      <span class="dot-marker"></span>
      <span class="dot-label">{item.label}</span>
    </a>
  ))}
</nav>

<style>
  .section-nav {
    position: fixed;
    right: 28px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .rail {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 3px;
    width: 1px;
    background: var(--line);
    z-index: -1;
  }

  .dot {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-faint);
    position: relative;
  }

  .dot-marker {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line-strong);
    transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    flex-shrink: 0;
  }

  .dot-label {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .dot:hover .dot-label {
    opacity: 1;
    transform: translateX(0);
  }

  .dot:hover .dot-marker {
    background: var(--accent-2);
  }

  .dot.active .dot-marker {
    background: var(--accent);
    transform: scale(1.5);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .dot.active .dot-label {
    color: var(--text);
  }

  @media (max-width: 1100px) {
    .section-nav {
      display: none;
    }
  }
</style>

<script>
  const dots = document.querySelectorAll<HTMLAnchorElement>(".section-nav .dot");
  const sections = Array.from(dots)
    .map((dot) => document.getElementById(dot.dataset.section || ""))
    .filter((el): el is HTMLElement => Boolean(el));

  const setActive = (id: string) => {
    dots.forEach((dot) => dot.classList.toggle("active", dot.dataset.section === id));
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: "-45% 0px -45% 0px" }
  );

  sections.forEach((section) => observer.observe(section));
</script>
