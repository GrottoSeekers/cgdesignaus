---
const base = import.meta.env.BASE_URL;
const home = base.replace(/\/$/, "") + "/";

const navItems = [
  { href: `${home}#client`, label: "Work" },
  { href: `${home}#pricing`, label: "Pricing" },
  { href: `${home}#process`, label: "Process" },
  { href: `${home}#faq`, label: "FAQ" },
];

const drawerItems = [
  { href: base, label: "Home" },
  { href: `${home}#client`, label: "Work" },
  { href: `${home}#pricing`, label: "Pricing" },
  { href: `${home}#process`, label: "Process" },
  { href: `${home}#faq`, label: "FAQ" },
  { href: `${home}#contact`, label: "Contact" },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a href={base} class="logo" aria-label="CG Design &amp; Co. home">
      <img
        src={`${base.replace(/\/$/, "")}/logo-full.png`}
        alt="CG Design & Co."
        class="logo-mark"
        width="566"
        height="241"
      />
    </a>

    <nav class="nav" aria-label="Primary" id="primary-nav">
      <span class="nav-indicator" id="nav-indicator" aria-hidden="true"></span>
      {navItems.map((item, i) => (
        <a href={item.href} data-nav-link class={i === 0 ? "active" : ""}>{item.label}</a>
      ))}
    </nav>

    <a href={`${home}#contact`} class="btn-cta">Free website check</a>

    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" id="menu-toggle">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="drawer" id="nav-drawer" aria-hidden="true">
    <button class="drawer-close" id="drawer-close" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>

    <nav class="drawer-nav" aria-label="Mobile" id="drawer-nav">
      {drawerItems.map((item) => (
        <a href={item.href} class="drawer-link" data-drawer-link>{item.label}</a>
      ))}
    </nav>
    <a href={`${home}#contact`} class="btn-cta drawer-cta" data-drawer-link>Free website check</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 28px;
    height: 70px;
    padding: 0 clamp(20px, 4vw, 32px);
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(20, 17, 26, 0.09);
  }

  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
    flex-shrink: 0;
  }

  .logo-mark {
    display: block;
    height: 34px;
    width: auto;
    flex-shrink: 0;
  }

  .nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    flex-wrap: wrap;
  }

  .nav a {
    position: relative;
    z-index: 1;
    padding: 10px 14px;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(20, 17, 26, 0.68);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease, transform 0.15s ease;
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a:active {
    transform: scale(0.94);
  }

  .nav a.active {
    color: var(--text);
  }

  .nav-indicator {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0;
    border-radius: 9999px;
    background: rgba(47, 17, 71, 0.09);
    transform: translateX(0);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
    pointer-events: none;
  }

  .btn-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: 9999px;
    background: var(--accent-2);
    color: var(--bg);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease, box-shadow 0.25s ease;
  }

  .btn-cta:hover {
    background: #170a26;
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -12px rgba(20, 17, 26, 0.6);
  }

  .btn-cta:active {
    transform: translateY(0) scale(0.98);
  }

  .btn-cta--mobile {
    display: none;
  }

  .menu-toggle {
    position: relative;
    z-index: 101;
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid rgba(20, 17, 26, 0.16);
    background: transparent;
    cursor: pointer;
    flex-shrink: 0;
  }

  .menu-toggle span {
    display: block;
    height: 2px;
    width: 18px;
    margin: 0 auto;
    background: var(--text);
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }

  .menu-toggle.is-open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle.is-open span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.is-open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .drawer.open {
    opacity: 1;
    visibility: visible;
  }

  .drawer-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(20, 17, 26, 0.16);
    background: transparent;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .drawer-close:hover {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  .drawer-close svg {
    width: 20px;
    height: 20px;
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .drawer-link {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 7vw, 2.6rem);
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .drawer-link:hover {
    color: var(--accent-2);
  }

  .drawer-cta {
    padding: 0 40px;
    min-height: 50px;
    font-size: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer {
      transition: none;
    }
  }

  @media (max-width: 800px) {
    .nav,
    .btn-cta:not(.drawer-cta) {
      display: none;
    }
    .menu-toggle {
      display: flex;
      margin-left: auto;
    }
    .bar {
      gap: 16px;
      padding: 0 20px;
    }
  }
</style>

<script>
  import { animate } from "motion";
  import { prefersReducedMotion, SPRING_SNAPPY } from "../../lib/motion-utils.js";

  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement | null;
  const drawer = document.getElementById("nav-drawer");
  const closeBtn = document.getElementById("drawer-close") as HTMLButtonElement | null;
  const drawerLinks = Array.from(drawer?.querySelectorAll<HTMLElement>("[data-drawer-link]") ?? []);

  const openDrawer = () => {
    drawer?.classList.add("open");
    drawer?.setAttribute("aria-hidden", "false");
    toggle?.classList.add("is-open");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";

    if (prefersReducedMotion()) return;
    drawerLinks.forEach((el, i) => {
      animate(el, { opacity: [0, 1], y: [24, 0] }, { ...SPRING_SNAPPY, delay: i * 0.06 });
    });
  };

  const closeDrawer = () => {
    drawer?.classList.remove("open");
    drawer?.setAttribute("aria-hidden", "true");
    toggle?.classList.remove("is-open");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  toggle?.addEventListener("click", () => {
    const isOpen = drawer?.classList.contains("open");
    isOpen ? closeDrawer() : openDrawer();
  });

  closeBtn?.addEventListener("click", closeDrawer);

  drawerLinks.forEach((link) => link.addEventListener("click", closeDrawer));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawer?.classList.contains("open")) closeDrawer();
  });

  const nav = document.getElementById("primary-nav");
  const indicator = document.getElementById("nav-indicator") as HTMLElement | null;
  const links = Array.from(nav?.querySelectorAll<HTMLAnchorElement>("[data-nav-link]") ?? []);

  const sections = links
    .map((link) => document.getElementById((link.getAttribute("href") ?? "").split("#")[1] ?? ""))
    .filter((el): el is HTMLElement => Boolean(el));

  const moveIndicator = (link: HTMLAnchorElement) => {
    if (!indicator || !nav) return;
    const navRect = nav.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    indicator.style.width = `${linkRect.width}px`;
    indicator.style.transform = `translateX(${linkRect.left - navRect.left}px)`;
  };

  const setActive = (id: string) => {
    const activeLink = links.find((l) => l.getAttribute("href")?.endsWith(`#${id}`));
    if (!activeLink) return;
    links.forEach((l) => l.classList.toggle("active", l === activeLink));
    moveIndicator(activeLink);
  };

  const initIndicator = () => {
    const current = links.find((l) => l.classList.contains("active")) ?? links[0];
    if (current) moveIndicator(current);
  };

  requestAnimationFrame(initIndicator);
  window.addEventListener("load", initIndicator);
  window.addEventListener("resize", initIndicator);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: "-45% 0px -45% 0px" }
  );

  sections.forEach((section) => observer.observe(section));
</script>
