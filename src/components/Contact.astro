---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const serviceOptions = [
  { value: "New Site", label: "New site" },
  { value: "Redesign", label: "Redesign" },
  { value: "Not Sure", label: "Not sure yet" },
];

const nextSteps = [
  "We reply within one business day",
  "You get an honest written read on your site",
  "If you'd like to go ahead, a fixed quote and a date",
];
---

<section id="contact" style="position: relative; overflow: hidden; padding: 112px 0 104px; background: #f3f0f8">
<div aria-hidden="true" class="blob-a" style="position: absolute; width: 560px; height: 560px; border-radius: 50%; background: #b58cf0; opacity: 0.18; filter: blur(110px); top: -200px; right: -160px; animation: cg-drift-a 20s ease-in-out infinite; pointer-events: none"></div>
<div class="wrap" style="position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 64px; align-items: start">
<div>
<span class="eyebrow">Get in touch</span>
<h2 style="font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; margin: 16px 0 18px">Get your free <em style="font-style: italic; font-weight: 600; color: #5b2a96">website check.</em></h2>
<p style="color: rgba(20,17,26,0.68); font-size: 1.02rem; margin-bottom: 32px">Tell us about the business. If you already have a site, add the link — we'll tell you honestly what we'd change, whether or not you hire us.</p>
<div class="contact-ways" style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px">
<a href="https://wa.me/447306100251" target="_blank" rel="noopener noreferrer" class="way whatsapp-link" style="display: flex; align-items: center; gap: 16px; padding: 18px 20px; border-radius: 20px; background: #ffffff; border: 1px solid rgba(20,17,26,0.08); text-decoration: none; color: #14111a">
<span class="way-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.6-4.8A8.5 8.5 0 1 1 7.8 19.4z"></path></svg></span>
<span style="display: flex; flex-direction: column; flex: 1; line-height: 1.35"><strong style="font-size: 1rem">WhatsApp</strong><span style="font-size: 0.86rem; color: rgba(20,17,26,0.6)">The quickest way to reach us</span></span>
<svg class="way-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
</a>
<a href="mailto:info@cgdesignaus.com" class="way" style="display: flex; align-items: center; gap: 16px; padding: 18px 20px; border-radius: 20px; background: #ffffff; border: 1px solid rgba(20,17,26,0.08); text-decoration: none; color: #14111a">
<span class="way-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></span>
<span style="display: flex; flex-direction: column; flex: 1; line-height: 1.35"><strong style="font-size: 1rem">info@cgdesignaus.com</strong><span style="font-size: 0.86rem; color: rgba(20,17,26,0.6)">Replies within one business day</span></span>
<svg class="way-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
</a>
</div>
<p style="font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(20,17,26,0.62); margin-bottom: 14px">What happens next</p>
<ol class="next-steps" style="list-style: none; margin: 0 0 28px; padding: 0; display: flex; flex-direction: column; gap: 12px">
{nextSteps.map((step, i) => <li style="display: flex; gap: 14px; align-items: center; font-size: 0.95rem"><span class="next-num" aria-hidden="true">{i + 1}</span>{step}</li>)}
</ol>
<p style="font-size: 0.84rem; color: rgba(20,17,26,0.66)">ABN 25 672 082 550</p>
</div>
<div class="contact-form-wrap">
<form class="contact-form" id="lead-form" action="https://api.web3forms.com/submit" method="POST" novalidate style="position: relative; display: flex; flex-direction: column; gap: 18px; background: #ffffff; border: 1px solid rgba(20,17,26,0.08); border-radius: 28px; padding: 36px; box-shadow: 0 50px 100px -50px rgba(47,17,71,0.45)">
<div style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 4px">
<h3 style="font-size: 1.5rem">Tell us about your business</h3>
<p style="font-size: 0.9rem; color: rgba(20,17,26,0.6)">Takes about a minute.</p>
<p class="form-note" id="prefill-notice" hidden></p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr)); gap: 16px">
<div class="field"><label for="client_name">Your name</label><input id="client_name" name="client_name" type="text" autocomplete="name" placeholder="Jane Doe" required><span class="field-error" id="err-client_name" role="alert"></span></div>
<div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" placeholder="jane@business.com.au" required><span class="field-error" id="err-email" role="alert"></span></div>
</div>
<div class="field"><label for="business_name">Business name</label><input id="business_name" name="business_name" type="text" autocomplete="organization" placeholder="Apex Heating &amp; Electrical" required><span class="field-error" id="err-business_name" role="alert"></span></div>
<div class="field"><label for="website">Existing website <span style="font-weight: 500; color: rgba(20,17,26,0.5)">(optional)</span></label><input id="website" name="website" type="text" inputmode="url" autocomplete="url" placeholder="yourbusiness.com.au"><span class="field-error" id="err-website" role="alert"></span></div>
<div class="field-service" style="display: flex; flex-direction: column; gap: 8px"><span id="service-label" style="font-size: 0.8rem; font-weight: 700; color: rgba(20,17,26,0.7)">What do you need?</span>
<div class="svc-group" role="group" aria-labelledby="service-label" style="display: flex; flex-wrap: wrap; gap: 8px">
{serviceOptions.map((opt) => <button type="button" class="svc" aria-pressed="false" data-value={opt.value}>{opt.label}</button>)}
</div>
<input type="hidden" id="service" name="service">
<span class="field-error" id="err-service" role="alert"></span>
</div>
<div class="field-consent">
<label for="consent" style="display: flex; gap: 10px; align-items: flex-start; font-size: 0.85rem; color: rgba(20,17,26,0.7)"><input id="consent" name="consent" type="checkbox" required style="margin-top: 3px; width: 18px; height: 18px; accent-color: #5b2a96"><span>I agree to my details being used to reply to this enquiry, as described in the <a href={`${base}/privacy-policy`} target="_blank" rel="noopener noreferrer">Privacy Policy</a>.</span></label>
<span class="field-error" id="err-consent" role="alert"></span>
</div>
<div class="field-captcha">
<div class="h-captcha" data-captcha="true"></div>
<span class="field-error" id="err-captcha" role="alert"></span>
</div>
<button type="submit" class="btn btn-primary send-btn" id="submit-btn" style="min-height: 56px; font-family: inherit; font-size: 1rem"><span class="spinner" aria-hidden="true"></span><span class="btn-label">Send it over</span> <svg class="send-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button>
<p class="submit-error" id="submit-error" role="alert" hidden>Something went wrong sending that. Please email us directly at <a href="mailto:info@cgdesignaus.com">info@cgdesignaus.com</a> instead.</p>
<input type="hidden" name="access_key" value="af8becda-b0eb-46ce-928f-29364cea38c2">
<input type="hidden" name="subject" value="New enquiry — CG Design & Co. website">
<input type="checkbox" name="botcheck" style="display: none;" tabindex="-1" autocomplete="off">
<input type="hidden" id="estimate_details" name="estimate_details">
</form>
<div class="form-success" id="form-success" hidden>
<svg class="success-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle class="success-icon-circle" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"></circle><path class="success-icon-check" d="m8 12.5 2.5 2.5L16 9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
<h3>Got it — thanks!</h3>
<p>We'll take a look and get back to you within one business day.</p>
<button type="button" class="btn btn-ghost" id="reset-form">Send another enquiry</button>
</div>
<script is:inline src="https://web3forms.com/client/script.js" async defer></script>
</div>
</div>
</section>

<style>
  .contact-form-wrap {
    position: relative;
    min-width: 0;
  }

  .contact-form.is-hidden {
    display: none !important;
  }

  .field-error {
    font-size: 0.8rem;
    color: var(--error);
  }

  .field-error:empty {
    display: none;
  }

  .field.has-error input {
    border-color: var(--error) !important;
  }

  .field.has-error input:focus {
    box-shadow: 0 0 0 4px var(--error-soft) !important;
  }

  .field-service.has-error .svc-group,
  .field-captcha.has-error .h-captcha {
    outline: 2px solid var(--error);
    outline-offset: 4px;
    border-radius: 12px;
  }

  .field-consent {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field-consent.has-error input {
    outline: 2px solid var(--error);
    outline-offset: 2px;
  }

  .field-consent a {
    color: #5b2695;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .field-captcha {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    overflow: hidden;
  }

  .field-captcha:has(.h-captcha:empty) {
    display: none;
  }

  .field-captcha.has-error {
    display: flex;
  }

  .send-btn[disabled] {
    opacity: 0.75;
    cursor: not-allowed;
    transform: none !important;
  }

  .spinner {
    display: none;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    border-top-color: transparent;
    animation: cg-spin-loader 0.7s linear infinite;
  }

  .send-btn.is-loading .spinner {
    display: inline-block;
  }

  .send-btn.is-loading .send-arrow {
    display: none;
  }

  @keyframes cg-spin-loader {
    to {
      transform: rotate(360deg);
    }
  }

  .submit-error {
    margin: 0;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--error-soft);
    color: var(--error);
    font-size: 0.85rem;
  }

  .submit-error a {
    color: var(--error);
    font-weight: 700;
  }

  .form-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
    background: #ffffff;
    border: 1px solid rgba(20, 17, 26, 0.08);
    border-radius: 28px;
    padding: 36px;
    box-shadow: 0 50px 100px -50px rgba(47, 17, 71, 0.45);
    animation: cg-success-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .form-success[hidden] {
    display: none;
  }

  @keyframes cg-success-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .success-icon {
    width: 52px;
    height: 52px;
    color: var(--success);
    margin-bottom: 10px;
  }

  .success-icon-circle {
    stroke-dasharray: 63;
    stroke-dashoffset: 63;
    animation: cg-success-draw 0.6s ease forwards 0.1s;
  }

  .success-icon-check {
    stroke-dasharray: 14;
    stroke-dashoffset: 14;
    animation: cg-success-draw 0.35s ease forwards 0.55s;
  }

  @keyframes cg-success-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .form-success h3 {
    font-size: 1.4rem;
  }

  .form-success p {
    color: rgba(20, 17, 26, 0.68);
    margin-bottom: 18px;
  }

  @media (prefers-reduced-motion: reduce) {
    .success-icon-circle,
    .success-icon-check {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  const form = document.getElementById("lead-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const submitError = document.getElementById("submit-error");
  const successPanel = document.getElementById("form-success");
  const resetBtn = document.getElementById("reset-form");

  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const urlPattern = /^(https?:\/\/)?[a-z0-9-]+(\.[a-z0-9-]+)+([/?#].*)?$/i;

  function setError(id: string, message: string) {
    const input = document.getElementById(id);
    const err = document.getElementById(`err-${id}`);
    if (!input || !err) return;
    err.textContent = message;
    input.closest(".field, .field-service, .field-consent")?.classList.toggle("has-error", Boolean(message));
    if (input.tagName === "INPUT" && (input as HTMLInputElement).type !== "hidden") {
      input.setAttribute("aria-invalid", message ? "true" : "false");
      if (message) input.setAttribute("aria-describedby", `err-${id}`);
    }
  }

  function clearErrors() {
    form?.querySelectorAll(".field-error").forEach((el) => (el.textContent = ""));
    form?.querySelectorAll(".has-error").forEach((el) => el.classList.remove("has-error"));
    form?.querySelectorAll("[aria-invalid]").forEach((el) => el.setAttribute("aria-invalid", "false"));
  }

  const value = (name: string) => ((form?.elements.namedItem(name) as HTMLInputElement | null)?.value ?? "").trim();

  function validate(): boolean {
    if (!form) return false;
    clearErrors();
    let firstInvalid: HTMLElement | null = null;
    const fail = (id: string, message: string, focusEl?: HTMLElement | null) => {
      setError(id, message);
      firstInvalid ||= focusEl ?? document.getElementById(id);
    };

    if (!value("client_name")) fail("client_name", "Let us know your name.");

    const email = value("email");
    if (!email) fail("email", "Add an email so we can reply.");
    else if (!emailPattern.test(email)) fail("email", "That doesn't look like a valid email.");

    if (!value("business_name")) fail("business_name", "What's the business called?");

    const website = value("website");
    if (website && !urlPattern.test(website)) fail("website", "That doesn't look like a valid website address.");

    if (!value("service")) fail("service", "Let us know what you're after.", document.querySelector<HTMLElement>(".svc"));

    if (!(form.elements.namedItem("consent") as HTMLInputElement).checked) {
      fail("consent", "Please agree to the Privacy Policy to continue.");
    }

    const captchaResponse = form.querySelector<HTMLTextAreaElement>("textarea[name='h-captcha-response']")?.value;
    if (!captchaResponse) {
      const err = document.getElementById("err-captcha");
      if (err) err.textContent = "Please complete the captcha.";
      document.querySelector(".field-captcha")?.classList.add("has-error");
      firstInvalid ||= document.querySelector<HTMLElement>(".h-captcha");
    }

    firstInvalid?.focus();
    return !firstInvalid;
  }

  function setLoading(loading: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = loading;
    submitBtn.classList.toggle("is-loading", loading);
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (submitError) submitError.hidden = true;
    if (!validate()) return;

    setLoading(true);
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (res.ok) {
        form.classList.add("is-hidden");
        if (successPanel) successPanel.hidden = false;
      } else if (submitError) {
        submitError.hidden = false;
      }
    } catch {
      if (submitError) submitError.hidden = false;
    } finally {
      setLoading(false);
    }
  });

  resetBtn?.addEventListener("click", () => {
    if (!form || !successPanel) return;
    form.reset();
    clearErrors();
    syncServiceChips();
    const notice = document.getElementById("prefill-notice");
    if (notice) notice.hidden = true;
    if (submitError) submitError.hidden = true;
    successPanel.hidden = true;
    form.classList.remove("is-hidden");
  });

  // Service chips write to the hidden #service input (Pricing's quote builder sets it too).
  const serviceInput = document.getElementById("service") as HTMLInputElement | null;
  const serviceChips = Array.from(document.querySelectorAll<HTMLButtonElement>(".svc"));

  function syncServiceChips() {
    serviceChips.forEach((chip) => {
      const on = chip.dataset.value === serviceInput?.value;
      chip.classList.toggle("on", on);
      chip.setAttribute("aria-pressed", String(on));
    });
  }

  serviceChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      if (!serviceInput) return;
      serviceInput.value = chip.dataset.value ?? "";
      syncServiceChips();
      setError("service", "");
    });
  });
  serviceInput?.addEventListener("change", syncServiceChips);

  // WhatsApp: draft a message from whatever the visitor has filled in so far.
  const whatsappLink = document.querySelector<HTMLAnchorElement>(".whatsapp-link");
  const WHATSAPP_NUMBER = "447306100251";

  function buildWhatsAppMessage(): string {
    const name = value("client_name");
    const email = value("email");
    const business = value("business_name");
    const website = value("website");
    const service = value("service");
    const estimate = value("estimate_details");
    if (!name && !email && !business && !service) return "Hi! I'd like to chat about getting a website.";

    const intro = `Hi, I'm${name ? ` ${name}` : ""}${business ? ` from ${business}` : ""}.`;
    const details: string[] = [];
    if (service) details.push(`I'm after: ${service}.`);
    if (website) details.push(`Existing site: ${website}.`);
    if (estimate) details.push(`Estimate: ${estimate}.`);
    if (email) details.push(`My email is ${email}.`);
    return [intro, ...details].join(" ");
  }

  whatsappLink?.addEventListener("click", (e) => {
    e.preventDefault();
    window.open(
      `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(buildWhatsAppMessage())}`,
      "_blank",
      "noopener,noreferrer"
    );
  });
</script>
