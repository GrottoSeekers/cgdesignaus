---
// Homepage layout: the redesign's own stylesheet (home.css) instead of the
// legal pages' global.css, and the page-wide motion script.
import "../styles/fonts.css";
import "../styles/home.css";
import SiteHead from "../components/SiteHead.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = "/og-image.jpg", noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <SiteHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="cg" style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: #14111a; background: #ffffff; line-height: 1.6; -webkit-font-smoothing: antialiased">
      <slot />
    </div>
    <script>
      import "../scripts/home.ts";
    </script>
  </body>
</html>
