---
import "../styles/global.css";
import SiteHead from "../components/SiteHead.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "CG Design & Co. — Websites for local businesses",
  description = "We design and build fast, modern websites for local businesses across Australia — whether you don't have one yet or your current site needs an upgrade.",
  image = "/og-image.jpg",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title={title}
      description={description}
      image={image}
      fontsHref="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=EB+Garamond:wght@400&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <div id="scroll-progress"></div>
    <slot />
    <script>
      // Hover/press feedback for .btn and .card now runs on CSS transitions
      // (see the shared rules in global.css) rather than motion's hover()/press(),
      // so it doesn't fight the CSS :active scale over the transform property.
      const bar = document.getElementById("scroll-progress");

      function updateProgress() {
        const scrollTop = window.scrollY;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const pct = height > 0 ? (scrollTop / height) * 100 : 0;
        if (bar) bar.style.width = `${pct}%`;
      }

      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();

      const revealTargets = document.querySelectorAll(".reveal, .reveal-stagger");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
      );
      revealTargets.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
