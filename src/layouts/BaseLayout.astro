---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "CG Design & Co. — Websites for local businesses",
  description = "We design and build fast, modern websites for local businesses across Australia — whether you don't have one yet or your current site needs an upgrade.",
  image = "/previews/nigels-desktop.webp",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.png`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="CG Design & Co." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=EB+Garamond:wght@400&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <div id="scroll-progress"></div>
    <slot />
    <script>
      // Hover/press feedback for .btn and .card now runs on CSS transitions
      // (see the shared rules in global.css) rather than motion's hover()/press(),
      // so it doesn't fight the CSS :active scale over the transform property.
      const bar = document.getElementById("scroll-progress");

      function updateProgress() {
        const scrollTop = window.scrollY;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const pct = height > 0 ? (scrollTop / height) * 100 : 0;
        if (bar) bar.style.width = `${pct}%`;
      }

      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();

      const revealTargets = document.querySelectorAll(".reveal, .reveal-stagger");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
      );
      revealTargets.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
